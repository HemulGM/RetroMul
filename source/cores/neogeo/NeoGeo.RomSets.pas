function NeoGeoSet(const Name: string): string;
begin
  Result := '';
  for var Item in Sets do
    if SameText(Item.Substring(0, Item.IndexOf('|')), Name) then
      Exit(Item);
end;

function SelectNeoGeoSet(const Name: string; const CRCs: TArray<string>): string;

  function ContainsCRC(const CRC: string): Boolean;
  begin
    Result := False;
    for var Value in CRCs do
      if SameText(Value, CRC) then
        Exit(True);
  end;

begin
  Result := NeoGeoSet(Name);
  if Result = '' then
    Exit;
  var Best := -1;
  for var Item in Sets do
  begin
    var Parts := Item.Split(['|']);
    if not SameText(Parts[0], Name) then
      Continue;
    var Score := 0;
    for var Row in Parts[9].Split([';']) do
    begin
      var Fields := Row.Split([',']);
      if (Length(Fields) = 7) and ContainsCRC(Fields[6]) then
        Inc(Score);
    end;
    if Score > Best then
    begin
      Best := Score;
      Result := Item;
    end;
  end;
  var Selected := Result.Split(['|']);
  if Selected[2] <> '1' then
    Exit;
  var Wiring := '';
  const Regions = 'PSMABC';
  for var R := 1 to Length(Regions) do
  begin
    var Region := string(Regions[R]);
    var RegionParts := Selected;
    for var Item in Sets do
    begin
      var Parts := Item.Split(['|']);
      if not SameText(Parts[0], Name) or (Parts[2] <> '1') then
        Continue;
      var Found := False;
      var Complete := True;
      for var Row in Parts[9].Split([';']) do
      begin
        var Fields := Row.Split([',']);
        if (Length(Fields) <> 7) or (Fields[0] <> Region) then
          Continue;
        Found := True;
        if not ContainsCRC(Fields[6]) then
          Complete := False;
      end;
      if Found and Complete then
      begin
        RegionParts := Parts;
        Break;
      end;
    end;
    Selected[R + 2] := RegionParts[R + 2];
    if Region = 'P' then
      Selected[10] := RegionParts[10];
    if Region = 'M' then
      Selected[11] := RegionParts[11];
    for var Row in RegionParts[9].Split([';']) do
    begin
      var Fields := Row.Split([',']);
      if (Length(Fields) <> 7) or (Fields[0] <> Region) then
        Continue;
      if Wiring <> '' then
        Wiring := Wiring + ';';
      Wiring := Wiring + Row;
    end;
  end;
  Selected[9] := Wiring;
  Result := string.Join('|', Selected);
end;

function IdentifyNeoGeoSet(const Files: TArray<string>): string;
begin
  Result := '';
  var Best := 0;
  for var Item in Sets do
  begin
    var Parts := Item.Split(['|']);
    if Parts[2] <> '1' then
      Continue;
    var Score := 0;
    var HasProgram := False;
    for var Row in Parts[9].Split([';']) do
    begin
      var Fields := Row.Split([',']);
      if Length(Fields) < 7 then
        Continue;
      for var FileName in Files do
        if SameText(ExtractFileName(FileName), Fields[1]) then
        begin
          Inc(Score);
          if Fields[0] = 'P' then
            HasProgram := True;
          Break;
        end;
    end;
    if HasProgram and (Score > Best) then
    begin
      Best := Score;
      Result := Parts[0];
    end;
  end;
end;

