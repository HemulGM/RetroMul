#version 450
#extension GL_GOOGLE_include_directive : require
#include "PS2.GS.Tables.glsl"
// GS sprites and prepared triangle fragments; one invocation per pixel.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,std430) buffer VRAM { uint ram[]; };
struct Draw { uint p[384]; };
layout(set=0,binding=1,std430) readonly buffer State { Draw draws[]; };
layout(set=0,binding=2,std430) readonly buffer Coordinates { int coords[]; };
layout(set=0,binding=3,std430) readonly buffer Fragments { uint fragments[]; };
layout(push_constant) uniform Bounds { ivec4 bounds; uint slot; uint mode; };
uint drawIndex;
#include "PS2.GS.Pixel.glsl"

void main() {
  drawIndex=slot;
  ivec2 xy;
  uint base=0;
  if(mode==0) {
    xy=bounds.xy+ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(xy,bounds.zw))) return;
  } else {
    uint index=gl_WorkGroupID.x*64+gl_LocalInvocationIndex;
    if(index>=uint(bounds.y)) return;
    base=(uint(bounds.x)+index)*11;
    xy=ivec2(fragments[base],fragments[base+1]);
  }
  ivec3 c=mode==0 ? ivec3(p[26],p[27],p[28]) :
    ivec3(fragments[base+3],fragments[base+4],fragments[base+5]);
  int a=int(mode==0 ? p[29] : fragments[base+6]);
  int f=int(mode==0 ? p[30] : fragments[base+7]);
  uint z=mode==0 ? p[31] : fragments[base+2];
  int u=0,v=0;
  uint mip=0;
  if(p[47]!=0) {
    u=mode==0 ? coords[slot*4096+uint(xy.x-bounds.x)] : int(fragments[base+8]);
    v=mode==0 ? coords[slot*4096+2048+uint(xy.y-bounds.y)] : int(fragments[base+9]);
    mip=mode==0 ? p[52] : fragments[base+10];
  }
  shadePixel(xy,z,c,a,f,u,v,mip);
}
