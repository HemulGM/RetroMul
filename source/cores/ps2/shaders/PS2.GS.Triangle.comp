#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_ARB_gpu_shader_int64 : require
#include "PS2.GS.Tables.glsl"
// Full coverage/interpolation on devices with exact FP64. build.ps1 adds
// explicit RTE, signed-zero and denormal execution modes to the SPIR-V.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,std430) buffer VRAM { uint ram[]; };
struct Draw { uint p[384]; };
layout(set=0,binding=1,std430) readonly buffer State { Draw draws[]; };
// Each cluster's tile table (first entry, count per tile) and entries.
layout(set=0,binding=2,std430) readonly buffer Tiles { uint tiles[]; };
// The LOD tables of draws with per-pixel LOD (each at its draw's p[79]).
layout(set=0,binding=3,std430) readonly buffer LodTables { uint lodTables[]; };
// Clustered sprites' texture coordinates, the host's per column and row.
layout(set=0,binding=4,std430) readonly buffer Coordinates { int coords[]; };
// Phase A's results: per entry 64 pixels' depth and colour, then (from
// maskBase) per entry the pixels covered.
layout(set=0,binding=5,std430) buffer Results { uint results[]; };
layout(push_constant) uniform Push { ivec4 bounds; uint slot; uint mode; uint tileBase; uint entryBase;
  uint resultBase; uint count; uint width; uint maskBase; };
uint drawIndex;
#include "PS2.GS.Pixel.glsl"

double towardZero(double v) {
  uvec2 b=unpackDouble2x32(v);
  if(b.x==0) b.y--;
  b.x--;
  return packDouble2x32(b);
}
double stepDouble(double v,bool up) {
  uvec2 b=unpackDouble2x32(v);
  if((v>0.0)==up) { b.x++; if(b.x==0) b.y++; }
  else { if(b.x==0) b.y--; b.x--; }
  return packDouble2x32(b);
}
double addD(double a,double b) {
  precise double r=a+b;
  if(p[55]!=3) return r;
  precise double z=r-a;
  precise double e=(a-(r-z))+(b-z);
  return ((r>0.0 && e<0.0)||(r<0.0 && e>0.0)) ? towardZero(r) : r;
}
double subD(double a,double b) { return addD(a,-b); }
double mulD(double a,double b) {
  precise double r=a*b;
  if(p[55]!=3) return r;
  precise double e=fma(a,b,-r);
  return ((r>0.0 && e<0.0)||(r<0.0 && e>0.0)) ? towardZero(r) : r;
}
// Exact residual as a double-double: the rounded quotient supplied by the
// device may be a few ulps away. Product error is captured by FMA; a-prod is
// exact by Sterbenz because the quotient is already close to the answer.
dvec2 residual(double a,double b,double q) {
  precise double prod=q*b;
  precise double pe=fma(q,b,-prod);
  precise double s=a-prod;
  precise double e=-pe;
  precise double hi=s+e;
  precise double z=hi-s;
  precise double lo=(s-(hi-z))+(e-z);
  return dvec2(hi,lo);
}
bool positiveDD(dvec2 r) { return r.x>0.0 || (r.x==0.0 && r.y>0.0); }
dvec2 absDD(dvec2 r) { return positiveDD(r) ? r : -r; }
double divD(double a,double b) {
  precise double q=a/b;
  if(a==0.0) return q;
  for(int i=0;i<8;i++) {
    dvec2 r=residual(a,b,q);
    if(all(equal(r,dvec2(0.0)))) return q;
    bool up=positiveDD(r)==(b>0.0);
    double n=stepDouble(q,up);
    dvec2 rn=residual(a,b,n);
    if(all(equal(rn,dvec2(0.0)))) return n;
    if((positiveDD(rn)==(b>0.0))!=up) {
      if(p[55]==3) return abs(q)<abs(n) ? q : n;
      dvec2 ar=absDD(r),an=absDD(rn);
      if(ar.x<an.x || (ar.x==an.x && ar.y<an.y)) return q;
      if(ar.x>an.x || (ar.x==an.x && ar.y>an.y)) return n;
      return (unpackDouble2x32(q).x&1)==0 ? q : n;
    }
    q=n;
  }
  return q; // Vulkan's FP64 division bound is much smaller than eight ulps.
}
double interp(double w0,double w1,double w2,double a,double b,double c) {
  return addD(addD(mulD(w0,a),mulD(w1,b)),mulD(w2,c));
}
int rounded(double v) { return int(unpackDouble2x32(addD(v,6755399441055744.0)).x); }
uint depthValue(double v) {
  v=clamp(v,0.0lf,4294967295.0lf);
  // The software inline depth accumulator is inferred as Delphi Currency
  // (four decimal places). Retain that quantization, including host mode,
  // rather than silently changing coplanar-depth results in a speed path.
  double scaled=mulD(v,10000.0lf);
  double integer=subD(addD(scaled,6755399441055744.0lf),6755399441055744.0lf);
  uint r=uint(integer/10000.0lf);
  // Correct a device division rounded just across an integer boundary.
  // These integer-valued FP64 products/subtractions are exact.
  precise double rem=integer-double(r)*10000.0lf;
  if(rem<0.0lf) r--;
  else if(rem>=10000.0lf) r++;
  return r;
}
int textureCoordinate(double v) {
  if(!(v>-16777216.0)) return -16777216;
  if(v>16777216.0) return 16777216;
  return int(v);
}
// Q to single precision as the host rounds (nearest even or toward zero),
// whatever the device's own conversion does: Q is positive here.
uint singleBits(double q) {
  if(!(q>0.0)) return 0u;
  uint b=floatBitsToUint(float(q));
  if(p[55]==3) {
    if(b>0u && double(uintBitsToFloat(b))>q) b--;
    else if(b<0x7f7fffffu && double(uintBitsToFloat(b+1u))<=q) b++;
    return b;
  }
  uint lo=b,hi=b;
  if(double(uintBitsToFloat(b))<=q) hi=b+1u; else lo=b-1u;
  precise double dl=q-double(uintBitsToFloat(lo));
  precise double dh=double(uintBitsToFloat(hi))-q;
  if(dl<dh) return lo;
  if(dh<dl) return hi;
  return (lo&1u)==0u ? lo : hi;
}
// The host's mip choice for a pixel's Q: its LOD only falls as Q rises, so
// the slot's table lists the first single-precision Q of each choice.
uint lodCode(double q) {
  uint bits=singleBits(q);
  uint base=p[79];
  int lo=0,hi=int(lodTables[base])-1;
  while(lo<hi) {
    int mid=(lo+hi+1)>>1;
    if(lodTables[base+1u+uint(mid)*2u]<=bits) lo=mid; else hi=mid-1;
  }
  return lodTables[base+2u+uint(lo)*2u];
}
double vf(uint vertex,uint field) {
  uint raw=p[80+vertex*16+field];
  if(field>=10) return double(uintBitsToFloat(raw));
  if(field==0 || field==1 || field==8 || field==9) return double(int(raw));
  return double(raw);
}
// Single-precision estimates: what the FP64 interpolation above gives (the
// host's arithmetic) lies within e of the returned value. The weights are
// within 2^-24 of theirs, the attributes exact; the float evaluation and
// the double one err by under 5*2^-24 of the terms' magnitudes, and e is
// 2^-20 of them (generous; overflow or NaN fail every test below).
float est(vec3 w,float a,float b,float c,out float e) {
  float t0=w.x*a,t1=w.y*b,t2=w.z*c;
  e=(abs(t0)+abs(t1)+abs(t2))*(1.0/1048576.0)+1e-37;
  return (t0+t1)+t2;
}
// rounded() of the value within e of v, when that decides it.
bool roundedEst(float v,float e,out int r) {
  r=0;
  if(!(abs(v)<1048576.0) || !(e<0.25)) return false;
  float f=floor(v);
  float fr=v-f;
  // (The magic-number addition truncates to floor, or rounds to nearest
  // even: a value near .5 or an integer is left to the exact path.)
  if(p[55]==3) {
    if(fr>e && 1.0-fr>e) { r=int(f); return true; }
    return false;
  }
  if(fr-0.5>e) { r=int(f)+1; return true; }
  if(0.5-fr>e) { r=int(f); return true; }
  return false;
}
// textureCoordinate() (truncation) of the value within e of v.
bool truncEst(float v,float e,out int r) {
  r=0;
  if(!(abs(v)<1048576.0) || !(e<0.25)) return false;
  float m=abs(v),f=floor(m);
  if(f==0.0) return m+e<1.0;
  if(m-f>e && f+1.0-m>e) { r=v<0.0 ? -int(f) : int(f); return true; }
  return false;
}
float vs(uint vertex,uint field) {
  uint raw=p[80+vertex*16+field];
  if(field>=10) return uintBitsToFloat(raw);
  if(field==8 || field==9) return float(int(raw));
  return float(raw);
}
int colour(vec3 w,double w0,double w1,double w2,uint i0,uint i1,uint field) {
  float e;
  int r;
  if(p[80+i0*16+field]<65536u && p[80+i1*16+field]<65536u && p[112+field]<65536u &&
    roundedEst(est(w,vs(i0,field),vs(i1,field),vs(2,field),e),e,r)) return r;
  return rounded(interp(w0,w1,w2,vf(i0,field),vf(i1,field),vf(2,field)));
}
// Perspective texture coordinate: textureCoordinate(mulD(divD(s,q),scale))
// for the interpolated S (field) over q, scale a power of two (exact). From
// estimates s and q within es and eq: s/q within (es+|t|eq)/(|q|-eq), the
// float division off by 2.5 ulp, the double one by half an ulp.
bool perspectiveEst(vec3 w,uint field,float q,float eq,float scale,out int r) {
  r=0;
  // (Within the range the float division's error bound holds for.)
  if(!(abs(q)>4.0*eq) || !(abs(q)>1e-30) || !(abs(q)<1e30)) return false;
  float es;
  float s=est(w,vs(0,field),vs(1,field),vs(2,field),es);
  float t=s/q;
  float et=((es+abs(t)*eq)/(abs(q)-eq)+abs(t)*(1.0/1048576.0))*1.001;
  return truncEst(t*scale,et*scale,r);
}
// Phase A of a cluster (mode 0): one workgroup per entry (a draw meeting a
// tile), each invocation a pixel. Whether the draw covers it, its depth and
// its source colour (texture, texture function, fog): nothing here reads the
// frame or depth buffer, and no draw of a cluster writes what another one's
// texture reads (the host ends clusters there). Phase B (mode 1) then takes
// each tile's entries in draw order per pixel: depth test, alpha tests,
// blending, writes, the pixel's colour and depth kept in registers.
// Whether the triangle covers the pixel: its depth and weights.
bool triangleCover(ivec2 xy,out uint z,out double w0,out double w1,out double w2) {
  z=0u; w0=0.0; w1=0.0; w2=0.0;
  if(xy.x<int(p[60]) || xy.y<int(p[61]) || xy.x>=int(p[62]) || xy.y>=int(p[63])) return false;
  // The edge functions of integer coordinates (1/16 pixel) are integers of
  // up to 36 bits: exact in 64-bit integers, as in FP64 (and cheaper).
  int64_t x=int64_t(xy.x*16),y=int64_t(xy.y*16);
  int64_t x0=int64_t(int(p[80])),y0=int64_t(int(p[81]));
  int64_t x1=int64_t(int(p[96])),y1=int64_t(int(p[97]));
  int64_t x2=int64_t(int(p[112])),y2=int64_t(int(p[113]));
  int64_t s=int64_t(int(p[58]));
  int64_t a0=(y1-y2)*s,b0=(x2-x1)*s;
  int64_t a1=(y2-y0)*s,b1=(x0-x2)*s;
  int64_t a2=(y0-y1)*s,b2=(x1-x0)*s;
  int64_t e0=a0*(x-x1)+b0*(y-y1);
  int64_t e1=a1*(x-x2)+b1*(y-y2);
  int64_t e2=a2*(x-x0)+b2*(y-y0);
  int64_t bias0=(a0>0 || (a0==0 && b0>0)) ? 0 : -1;
  int64_t bias1=(a1>0 || (a1==0 && b1>0)) ? 0 : -1;
  int64_t bias2=(a2>0 || (a2==0 && b2>0)) ? 0 : -1;
  if(e0+bias0<0 || e1+bias1<0 || e2+bias2<0) return false;
  double sign=double(s);
  double inv=packDouble2x32(uvec2(p[56],p[57]));
  w0=mulD(double(e0)*sign,inv); w1=mulD(double(e1)*sign,inv); w2=subD(subD(1.0,w0),w1);
  z=p[59]!=0 ? depthValue(interp(w0,w1,w2,vf(0,2),vf(1,2),vf(2,2))) : 0;
  return true;
}
// A covered pixel's source colour (see sourceColor), packed.
uint triangleColor(double w0,double w1,double w2) {
  // Colours, fog and texture coordinates from single-precision estimates
  // where those decide the integers; the exact FP64 arithmetic otherwise.
  vec3 w=vec3(float(w0),float(w1),float(w2));
  uint i0=p[54]!=0 ? 0 : 2,i1=p[54]!=0 ? 1 : 2;
  ivec3 c=ivec3(colour(w,w0,w1,w2,i0,i1,3),colour(w,w0,w1,w2,i0,i1,4),colour(w,w0,w1,w2,i0,i1,5));
  int a=colour(w,w0,w1,w2,i0,i1,6);
  int fog=p[22]!=0 ? colour(w,w0,w1,w2,0,1,7) : 0;
  int u=0,v=0;
  uint mip=p[52];
  if(p[47]!=0) {
    if(p[53]!=0) {
      float e;
      if(!truncEst(est(w,vs(0,8),vs(1,8),vs(2,8),e),e,u))
        u=textureCoordinate(interp(w0,w1,w2,vf(0,8),vf(1,8),vf(2,8)));
      if(!truncEst(est(w,vs(0,9),vs(1,9),vs(2,9),e),e,v))
        v=textureCoordinate(interp(w0,w1,w2,vf(0,9),vf(1,9),vf(2,9)));
    } else {
      // (Per-pixel LOD takes Q exactly.)
      double qx=0.0;
      float eq;
      float qe=est(w,vs(0,12),vs(1,12),vs(2,12),eq);
      if(p[78]!=0) {
        qx=interp(w0,w1,w2,vf(0,12),vf(1,12),vf(2,12));
        mip=lodCode(qx);
      }
      if(!perspectiveEst(w,10,qe,eq,float(p[35])*16.0,u) || !perspectiveEst(w,11,qe,eq,float(p[36])*16.0,v)) {
        double q=p[78]!=0 ? qx : interp(w0,w1,w2,vf(0,12),vf(1,12),vf(2,12));
        if(q==0.0) q=1.0;
        u=textureCoordinate(mulD(divD(interp(w0,w1,w2,vf(0,10),vf(1,10),vf(2,10)),q),double(p[35])*16.0));
        v=textureCoordinate(mulD(divD(interp(w0,w1,w2,vf(0,11),vf(1,11),vf(2,11)),q),double(p[36])*16.0));
      }
    }
  }
  c=clamp(c,ivec3(0),ivec3(255));
  a=clamp(a,0,255);
  sourceColor(c,a,clamp(fog,0,255),u,v,mip);
  return uint(c.r)|(uint(c.g)<<8)|(uint(c.b)<<16)|(uint(a)<<24);
}

// A sprite in a cluster (p[58] 0) as the sprite kernel draws it: colour,
// depth and fog flat, the texture coordinates of its column and row.
bool spriteCover(ivec2 xy) {
  return !(xy.x<int(p[60]) || xy.y<int(p[61]) || xy.x>=int(p[62]) || xy.y>=int(p[63]));
}
uint spriteColor(ivec2 xy) {
  int u=0,v=0;
  if(p[47]!=0) {
    u=coords[drawIndex*4096+uint(xy.x-int(p[60]))];
    v=coords[drawIndex*4096+2048+uint(xy.y-int(p[61]))];
  }
  ivec3 c=ivec3(p[26],p[27],p[28]);
  int a=int(p[29]);
  sourceColor(c,a,int(p[30]),u,v,p[52]);
  return uint(c.r)|(uint(c.g)<<8)|(uint(c.b)<<16)|(uint(a)<<24);
}

// Whether the draw at drawIndex covers the pixel, its depth and weights.
bool cover(ivec2 xy,out uint z,out double w0,out double w1,out double w2) {
  if(p[58]==0) {
    w0=0.0; w1=0.0; w2=0.0;
    z=p[31];
    return spriteCover(xy);
  }
  return triangleCover(xy,z,w0,w1,w2);
}
uint color(ivec2 xy,double w0,double w1,double w2) {
  return p[58]==0 ? spriteColor(xy) : triangleColor(w0,w1,w2);
}

shared uint coveredBits[2];

void main() {
  uint li=gl_LocalInvocationIndex;
  if(mode==0) {
    // Phase A: entry e (tile index | draw << 16), its 64 results (depth,
    // colour) and which of its pixels the draw covers.
    uint e=gl_WorkGroupID.y*32768u+gl_WorkGroupID.x;
    if(li<2u) coveredBits[li]=0u;
    barrier();
    bool valid=e<count;
    bool covered=false;
    uint z=0u,rgba=0u;
    if(valid) {
      uint entry=tiles[entryBase+e];
      uint tile=entry&0xffffu;
      drawIndex=slot+(entry>>16);
      ivec2 xy=bounds.xy+ivec2(int((tile%width)*8u),int((tile/width)*8u))+ivec2(gl_LocalInvocationID.xy);
      double w0,w1,w2;
      covered=cover(xy,z,w0,w1,w2);
      if(covered) rgba=color(xy,w0,w1,w2);
    }
    if(covered) atomicOr(coveredBits[li>>5],1u<<(li&31u));
    barrier();
    if(valid) {
      uint r=resultBase+e;
      if(covered) {
        results[r*128u+li*2u]=z;
        results[r*128u+li*2u+1u]=rgba;
      }
      if(li<2u) results[maskBase+r*2u+li]=coveredBits[li];
    }
    return;
  }
  // Phase B: one invocation owns this pixel through the whole ordered
  // cluster: the tile's entries (from the table) in draw order. (Mode 2:
  // both phases in one, for clusters whose tiles each meet few draws.)
  ivec2 xy=bounds.xy+ivec2(gl_GlobalInvocationID.xy);
  pixelCache=true;
  uint t=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
  uint first=tiles[tileBase+t*2u],n=tiles[tileBase+t*2u+1u];
  for(uint i=0u;i<n;i++) {
    uint e=first+i;
    uint r=resultBase+e;
    uint z,rgba;
    drawIndex=slot+(tiles[entryBase+e]>>16);
    if(mode==2) {
      // (The depth test before the colour, as the software path draws.)
      double w0,w1,w2;
      if(!cover(xy,z,w0,w1,w2) || !depthPass(xy,z)) continue;
      rgba=color(xy,w0,w1,w2);
    } else {
      if(((results[maskBase+r*2u+(li>>5)]>>(li&31u))&1u)==0u) continue;
      z=results[r*128u+li*2u];
      if(!depthPass(xy,z)) continue;
      rgba=results[r*128u+li*2u+1u];
    }
    writePixel(xy,z,ivec3(int(rgba&255u),int((rgba>>8)&255u),int((rgba>>16)&255u)),int(rgba>>24));
  }
  finishPixelCache();
}