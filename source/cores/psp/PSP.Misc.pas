    Result := 4;
end;

function TPSPMisc.EncodeTo(Kind: Integer; Dst: Cardinal; C: Cardinal; Room: Integer): Integer;
begin
  // Kind 0 UTF-8, 1 UTF-16, 2 Shift-JIS. Returns the bytes written, -1 if it
  // does not fit, -2 if it cannot be encoded.
  case Kind of
    0:
      begin
        var N := CccUtf8Length(C);
        if N > Room then
          Exit(-1);
        if Dst <> 0 then
          case N of
            1:
              FMemory.Write8(Dst, C);
            2:
              begin
                FMemory.Write8(Dst, $C0 or (C shr 6));
                FMemory.Write8(Dst + 1, $80 or (C and $3F));
              end;
            3:
              begin
                FMemory.Write8(Dst, $E0 or (C shr 12));
                FMemory.Write8(Dst + 1, $80 or ((C shr 6) and $3F));
                FMemory.Write8(Dst + 2, $80 or (C and $3F));
              end;
          else
            FMemory.Write8(Dst, $F0 or (C shr 18));
            FMemory.Write8(Dst + 1, $80 or ((C shr 12) and $3F));
            FMemory.Write8(Dst + 2, $80 or ((C shr 6) and $3F));
            FMemory.Write8(Dst + 3, $80 or (C and $3F));
          end;
        Result := N;
      end;
    1:
      begin
        var N := 2;
        if C >= $10000 then
          N := 4;
        if N > Room then
          Exit(-1);
        if Dst <> 0 then
          if N = 2 then
            FMemory.Write16(Dst, C)
          else
          begin
            FMemory.Write16(Dst, $D800 + ((C - $10000) shr 10));
            FMemory.Write16(Dst + 2, $DC00 + ((C - $10000) and $3FF));
          end;
        Result := N;
      end;
  else
    begin
      var J := UcsToJis(C);
      if (J = 0) and (C <> 0) then
        Exit(-2);
      var S := CccJisToSjis(J);
      var N := 1;
      if S >= $100 then
        N := 2;
      if N > Room then
        Exit(-1);
      if Dst <> 0 then
        if N = 1 then
          FMemory.Write8(Dst, S)
        else
        begin
          FMemory.Write8(Dst, S shr 8);
          FMemory.Write8(Dst + 1, S and $FF);
        end;
      Result := N;
    end;
  end;
end;

function TPSPMisc.Decode(Kind: Integer; var P: Cardinal): Cardinal;
begin
  case Kind of
    0:
      Result := DecodeUtf8(P);
    1:
      Result := DecodeUtf16(P);
  else
    Result := DecodeSjis(P);
  end;
end;

procedure TPSPMisc.Convert(FromKind, ToKind: Integer);
begin
  var Dst := FHLE.Arg(0);
  var Size := FHLE.Arg(1);
  var Src := FHLE.Arg(2);
  if Dst = 0 then
  begin
    FHLE.Result(0);
    Exit;
  end;
  var Unit_ := 1;
  if ToKind = 1 then
    Unit_ := 2;
  // Room in bytes, whole units only, one unit kept for the terminator.
  var Room := Integer(Size div Cardinal(Unit_)) * Unit_ - Unit_;
  if Room < 0 then
  begin
    FHLE.Result(0);
    Exit;
  end;
  var Count := 0;
  var Pos: Cardinal := 0;
  while True do
  begin
    var C := Decode(FromKind, Src);
    if (C = 0) or (C = $FFFFFFFF) then
      Break;
    var N := EncodeTo(ToKind, Dst + Pos, C, Room - Integer(Pos));
    if N < 0 then
      Break;
    Inc(Pos, N);
    Inc(Count);
  end;
  if Unit_ = 2 then
    FMemory.Write16(Dst + Pos, 0)
  else
    FMemory.Write8(Dst + Pos, 0);
  FHLE.Result(Cardinal(Count));
end;

procedure TPSPMisc.hCccSetTable;
begin
  FJis2Ucs := FHLE.Arg(0);
  FUcs2Jis := FHLE.Arg(1);
  FHLE.Result(0);
end;

procedure TPSPMisc.hCccUtf8ToUtf16;
begin
  Convert(0, 1);
end;
procedure TPSPMisc.hCccUtf8ToSjis;
begin
  Convert(0, 2);
end;
procedure TPSPMisc.hCccUtf16ToUtf8;
begin
  Convert(1, 0);
end;
procedure TPSPMisc.hCccUtf16ToSjis;
begin
  Convert(1, 2);
end;
procedure TPSPMisc.hCccSjisToUtf8;
begin
  Convert(2, 0);
end;
procedure TPSPMisc.hCccSjisToUtf16;
begin
  Convert(2, 1);
end;

procedure TPSPMisc.Strlen(Kind: Integer);
begin
  var P := FHLE.Arg(0);
  var N := 0;
  while True do
  begin
    var C := Decode(Kind, P);
    if (C = 0) or (C = $FFFFFFFF) then
      Break;
    Inc(N);
  end;
  FHLE.Result(Cardinal(N));
end;

procedure TPSPMisc.hCccStrlenUtf8;
begin
  Strlen(0);
end;
procedure TPSPMisc.hCccStrlenUtf16;
begin
  Strlen(1);
end;
procedure TPSPMisc.hCccStrlenSjis;
begin
  Strlen(2);
end;

procedure TPSPMisc.Encode(Kind: Integer);
begin
  var PP := FHLE.Arg(0);
  var C := FHLE.Arg(1);
  var Dst := FMemory.Read32(PP);
  var N := EncodeTo(Kind, Dst, C, 4);
  if N = -2 then
    N := EncodeTo(Kind, Dst, FErrorChar[Kind], 4);
  if N > 0 then
    FMemory.Write32(PP, Dst + Cardinal(N));
  FHLE.Result(Dst + Cardinal(Max(N, 0)));
end;

procedure TPSPMisc.hCccEncodeUtf8;
begin
  Encode(0);
end;
procedure TPSPMisc.hCccEncodeUtf16;
begin
  Encode(1);
end;
procedure TPSPMisc.hCccEncodeSjis;
begin
  Encode(2);
end;

procedure TPSPMisc.DecodeCall(Kind: Integer);
begin
  var PP := FHLE.Arg(0);
  var P := FMemory.Read32(PP);
  var Start := P;
  var C := Decode(Kind, P);
  if C = $FFFFFFFF then
  begin
    // An undecodable unit is skipped and reads as the error character.
    if Kind = 1 then
      P := Start + 2
    else
      P := Start + 1;
    C := FErrorChar[Kind];
  end;
  FMemory.Write32(PP, P);
  FHLE.Result(C);
end;

procedure TPSPMisc.hCccDecodeUtf8;
begin
  DecodeCall(0);
end;
procedure TPSPMisc.hCccDecodeUtf16;
begin
  DecodeCall(1);
end;
procedure TPSPMisc.hCccDecodeSjis;
begin
  DecodeCall(2);
end;

procedure TPSPMisc.SetErrorChar(Kind: Integer);
begin
  var Old := FErrorChar[Kind];
  FErrorChar[Kind] := FHLE.Arg(0) and $FFFF;
  FHLE.Result(Old);
end;

procedure TPSPMisc.hCccSetErrorCharUtf8;
begin
  SetErrorChar(0);
end;
procedure TPSPMisc.hCccSetErrorCharUtf16;
begin
  SetErrorChar(1);
end;
procedure TPSPMisc.hCccSetErrorCharSjis;
begin
  SetErrorChar(2);
end;

procedure TPSPMisc.hCccIsValidUcs4;
begin
  var C := FHLE.Arg(0);
  FHLE.Result(Ord((C <= $10FFFF) and ((C < $D800) or (C > $DFFF))));
end;

procedure TPSPMisc.hCccIsValidUcs2;
begin
  var C := FHLE.Arg(0);
  FHLE.Result(Ord((C <= $FFFF) and ((C < $D800) or (C > $DFFF))));
end;

procedure TPSPMisc.hCccIsValidUtf16;
begin
  FHLE.Result(Ord(FHLE.Arg(0) <= $FFFF));
end;

procedure TPSPMisc.hCccIsValidUtf8;
begin
  hCccIsValidUcs4;
end;

procedure TPSPMisc.hCccIsValidSjis;
begin
  var C := FHLE.Arg(0);
  var Ok: Boolean;
  if C < $100 then
    Ok := (C < $80) or ((C >= $A1) and (C <= $DF))
  else
  begin
    var B := C shr 8;
    var T := C and $FF;
    Ok := (C <= $FFFF) and (((B >= $81) and (B <= $9F)) or ((B >= $E0) and (B <= $FC))) and (T >= $40) and
      (T <> $7F) and (T <= $FC) and (JisToUcs(CccSjisToJis(C)) <> 0);
  end;
  FHLE.Result(Ord(Ok));
end;

procedure TPSPMisc.hCccIsValidJis;
begin
  var C := FHLE.Arg(0);
  FHLE.Result(Ord((C = 0) or (JisToUcs(C) <> 0)));
end;

procedure TPSPMisc.hCccUcsToJis;
begin
  var J := UcsToJis(FHLE.Arg(0));
  if (J = 0) and (FHLE.Arg(0) <> 0) then
    J := FHLE.Arg(1);
  FHLE.Result(J);
end;

procedure TPSPMisc.hCccJisToUcs;
begin
  var U := JisToUcs(FHLE.Arg(0));
  if (U = 0) and (FHLE.Arg(0) <> 0) then
    U := FHLE.Arg(1);
  FHLE.Result(U);
end;

{ PSP.Misc: sceReg, the system registry. The tree holds what games read:
  language, button assignment, nickname, date and time settings, network
  defaults and the font list. Registry handles are 0; categories get small
  handles; keys are addressed by name or by their handle within a category. }

const
  REG_TYPE_DIR = 1;
  REG_TYPE_INT = 2;
  REG_TYPE_STR = 3;
  REG_TYPE_BIN = 4;
  REG_ERROR_NOT_FOUND = Cardinal($80082710);
  REG_ERROR_BAD_HANDLE = Cardinal($80082715);
  REG_ERROR_BAD_PATH = Cardinal($80082716);
  REG_ERROR_NO_CATEGORY = Cardinal($80082718);
  REG_ERROR_SIZE = Cardinal($80082719);
  RegKeyNameSize = 27;

constructor TRegKey.Create(const AName: string; AKind: Integer);
begin
  inherited Create;
  Name := AName;
  Kind := AKind;
  Children := TObjectList<TRegKey>.Create(True);
end;

destructor TRegKey.Destroy;
begin
  Children.Free;
  inherited;
end;

function TRegKey.Find(const AName: string): TRegKey;
begin
  for var K in Children do
    if K.Name = AName then
      Exit(K);
  Result := nil;
end;

function TRegKey.Dir(const AName: string): TRegKey;
begin
  Result := Find(AName);
  if Result = nil then
  begin
    Result := TRegKey.Create(AName, REG_TYPE_DIR);
    Children.Add(Result);
  end;
end;

function TRegKey.AddInt(const AName: string; V: Integer): TRegKey;
begin
  Result := TRegKey.Create(AName, REG_TYPE_INT);
  Result.IntValue := V;
  Children.Add(Result);
end;

function TRegKey.AddStr(const AName, V: string; Size: Integer): TRegKey;
begin
  Result := TRegKey.Create(AName, REG_TYPE_STR);
  var B := TEncoding.UTF8.GetBytes(V);
  if Size < Length(B) + 1 then
    Size := Length(B) + 1;
  SetLength(Result.Data, Size);
  FillChar(Result.Data[0], Size, 0);
  if Length(B) > 0 then
    Move(B[0], Result.Data[0], Length(B));
  Children.Add(Result);
end;

function TRegKey.AddBin(const AName: string; const V: TBytes): TRegKey;
begin
  Result := TRegKey.Create(AName, REG_TYPE_BIN);
  Result.Data := Copy(V);
  Children.Add(Result);
end;

function TRegKey.Size: Cardinal;
begin
  case Kind of
    REG_TYPE_DIR:
      Result := 0;
    REG_TYPE_INT:
      Result := 4;
  else
    Result := Length(Data);
  end;
end;

function TRegKey.Value: TBytes;
begin
  if Kind = REG_TYPE_INT then
  begin
    SetLength(Result, 4);
    Move(IntValue, Result[0], 4);
  end
  else
    Result := Data;
end;

function RegBytes(const Values: array of Byte): TBytes;
begin
  SetLength(Result, Length(Values));
  for var I := 0 to High(Values) do
    Result[I] := Values[I];
end;

procedure TPSPMisc.BuildRegistry;
begin
  FRegRoot.Free;
  FRegRoot := TRegKey.Create('', REG_TYPE_DIR);
  var Registry := FRegRoot.Dir('REGISTRY');
  Registry.AddInt('category_version', $66);
  var Config := FRegRoot.Dir('CONFIG');
  var Data := FRegRoot.Dir('DATA');
  var Profile := FRegRoot.Dir('SYSPROFILE');

  var System := Config.Dir('SYSTEM');
  System.AddStr('owner_name', PSPSettings.Nickname, $80);
  var Xmb := System.Dir('XMB');
  Xmb.AddInt('language', PSPSettings.Language);
  Xmb.AddInt('button_assign', PSPSettings.ButtonSwap);
  Xmb.AddInt('theme_type', 0);
  var Lock := System.Dir('LOCK');
  Lock.AddInt('parental_level', PSPSettings.ParentalLevel);
  Lock.AddStr('password', '0000', 5);
  var Power := System.Dir('POWER_SAVING');
  Power.AddInt('suspend_interval', 600);
  Power.AddInt('backlight_off_interval', 300);
  Power.AddInt('wlan_mode', PSPSettings.WlanPowerSave);
  var Charset := System.Dir('CHARACTER_SET');
  Charset.AddInt('oem', 5);
  Charset.AddInt('ansi', $13);
  System.Dir('SOUND').AddInt('main_volume', 20);
  System.Dir('SOUND').AddInt('equalizer_mode', 0);
  System.Dir('SOUND').AddInt('avls', 0);

  var Date := Config.Dir('DATE');
  Date.AddInt('date_format', PSPSettings.DateFormat);
  Date.AddInt('time_format', PSPSettings.TimeFormat);
  Date.AddInt('time_zone_offset', PSPSettings.Timezone);
  Date.AddStr('time_zone_area', 'europe_london', $40);
  Date.AddInt('summer_time', PSPSettings.DaylightSaving);

  var Network := Config.Dir('NETWORK');
  var Adhoc := Network.Dir('ADHOC');
  Adhoc.AddStr('ssid_prefix', 'PSP', 4);
  Adhoc.AddInt('channel', PSPSettings.AdhocChannel);
  Network.Dir('INFRASTRUCTURE').AddInt('latest_id', 0);
  var Premo := Config.Dir('PREMO');
  Premo.AddInt('guide_page', 1);
  Premo.AddBin('ps3_mac', RegBytes([0, 0, 0, 0, 0, 0]));
  Premo.AddStr('ps3_name', '', $80);
  Premo.AddInt('flags', 0);
  Config.Dir('BROWSER').AddInt('flash_activated', 1);
  Config.Dir('ALARM');
  Config.Dir('CAMERA');
  Config.Dir('DISPLAY').AddInt('color_space_mode', 0);
  Config.Dir('GAME').AddInt('ap_title_name', 0);
  Config.Dir('MUSIC').AddInt('wma_play', 0);
  Config.Dir('PHOTO').AddInt('slideshow_speed', 0);
  Config.Dir('VIDEO').AddInt('menu_language', PSPSettings.Language);

  var Font := Data.Dir('FONT');
  Font.AddStr('path_name', 'flash0:/font', 13);
  Font.AddInt('num_fonts', 18);
  var Prop := Font.Dir('PROPERTY');
  for var I := 0 to 17 do
  begin
    var Info := Prop.Dir(Format('INFO%d', [I]));
    Info.AddStr('file_name', PSPFontFileName(I), $40);
  end;
  Data.Dir('COUNT').AddInt('boot_count', 1);

  Profile.Dir('RESOLUTION').AddInt('horizontal', 480);
  Profile.Dir('RESOLUTION').AddInt('vertical', 272);
  Profile.Dir('SOUND').AddInt('sound_volume', 20);
end;

function TPSPMisc.RegCategory(Handle: Cardinal): TRegKey;
begin
  if not FRegHandles.TryGetValue(Handle, Result) then
    Result := nil;
end;

function TPSPMisc.RegPath(const Path: string): TRegKey;
begin
  Result := nil;
  var Parts := Path.Split(['/'], TStringSplitOptions.ExcludeEmpty);
  if Length(Parts) = 0 then
    Exit;
  var K := FRegRoot;
  for var P in Parts do
  begin
    K := K.Find(P);
    if (K = nil) or (K.Kind <> REG_TYPE_DIR) then
      Exit(nil);
  end;
  Result := K;
end;

procedure TPSPMisc.hRegOpenRegistry;
begin
  if FHLE.Arg(2) <> 0 then
    FMemory.Write32(FHLE.Arg(2), 0);
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegCloseRegistry;
begin
  if FHLE.Arg(0) <> 0 then
    FHLE.Result(REG_ERROR_BAD_HANDLE)
  else
    FHLE.Result(0);
end;

procedure TPSPMisc.hRegOpenCategory;
begin
  var Out_ := FHLE.Arg(3);
  var Fail :=
    procedure(Code: Cardinal)
    begin
      if Out_ <> 0 then
        FMemory.Write32(Out_, $FFFFFFFF);
      FHLE.Result(Code);
    end;
  if FHLE.Arg(0) <> 0 then
  begin
    Fail(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var Path := FMemory.ReadString(FHLE.Arg(1), 256);
  if (Path = '') or (Path = '/') then
  begin
    Fail(REG_ERROR_BAD_PATH);
    Exit;
  end;
  var K := RegPath(Path);
  if K = nil then
  begin
    Fail(REG_ERROR_NO_CATEGORY);
    Exit;
  end;
  Inc(FRegNextHandle);
  FRegHandles.AddOrSetValue(FRegNextHandle, K);
  if Out_ <> 0 then
    FMemory.Write32(Out_, FRegNextHandle);
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegCloseCategory;
begin
  if not FRegHandles.ContainsKey(FHLE.Arg(0)) then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  FRegHandles.Remove(FHLE.Arg(0));
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegZero;
begin
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetKeysNum;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  FMemory.Write32(FHLE.Arg(1), Cardinal(C.Children.Count));
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetKeys;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var Buf := FHLE.Arg(1);
  var N := Min(FHLE.ArgInt(2), C.Children.Count);
  for var I := 0 to N - 1 do
    FMemory.WriteString(Buf + Cardinal(I) * RegKeyNameSize, RawByteString(C.Children[I].Name), RegKeyNameSize);
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetKeyInfo;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var Name := FMemory.ReadString(FHLE.Arg(1), RegKeyNameSize);
  var K := C.Find(Name);
  if K = nil then
  begin
    FHLE.Result(REG_ERROR_NOT_FOUND);
    Exit;
  end;
  if FHLE.Arg(2) <> 0 then
    FMemory.Write32(FHLE.Arg(2), Cardinal(C.Children.IndexOf(K)) + 1);
  if FHLE.Arg(3) <> 0 then
    FMemory.Write32(FHLE.Arg(3), Cardinal(K.Kind));
  if FHLE.Arg(4) <> 0 then
    FMemory.Write32(FHLE.Arg(4), K.Size);
  FHLE.Result(0);
end;

procedure TPSPMisc.RegWriteValue(K: TRegKey; Buf, Size: Cardinal);
begin
  if K.Kind = REG_TYPE_DIR then
  begin
    FHLE.Result(REG_ERROR_NOT_FOUND);
    Exit;
  end;
  var V := K.Value;
  if Size < Cardinal(Length(V)) then
  begin
    FHLE.Result(REG_ERROR_SIZE);
    Exit;
  end;
  if Length(V) > 0 then
    FMemory.WriteBytes(Buf, V[0], Length(V));
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetKeyValue;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var Index := Integer(FHLE.Arg(1)) - 1;
  if (Index < 0) or (Index >= C.Children.Count) then
  begin
    FHLE.Result(REG_ERROR_NOT_FOUND);
    Exit;
  end;
  RegWriteValue(C.Children[Index], FHLE.Arg(2), FHLE.Arg(3));
end;

procedure TPSPMisc.hRegGetKeyInfoByName;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var K := C.Find(FMemory.ReadString(FHLE.Arg(1), RegKeyNameSize));
  if K = nil then
  begin
    FHLE.Result(REG_ERROR_NOT_FOUND);
    Exit;
  end;
  if FHLE.Arg(2) <> 0 then
    FMemory.Write32(FHLE.Arg(2), Cardinal(K.Kind));
  if FHLE.Arg(3) <> 0 then
    FMemory.Write32(FHLE.Arg(3), K.Size);
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetKeyValueByName;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var K := C.Find(FMemory.ReadString(FHLE.Arg(1), RegKeyNameSize));
  if K = nil then
  begin
    FHLE.Result(REG_ERROR_NOT_FOUND);
    Exit;
  end;
  RegWriteValue(K, FHLE.Arg(2), FHLE.Arg(3));
end;

procedure TPSPMisc.hRegSetKeyValue;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var K := C.Find(FMemory.ReadString(FHLE.Arg(1), RegKeyNameSize));
  if (K = nil) or (K.Kind = REG_TYPE_DIR) then
  begin
    FHLE.Result(REG_ERROR_NOT_FOUND);
    Exit;
  end;
  var Size := FHLE.Arg(3);
  var V: TBytes;
  SetLength(V, Size);
  if Size > 0 then
    FMemory.ReadBytes(FHLE.Arg(2), V[0], Size);
  if K.Kind = REG_TYPE_INT then
  begin
    if Size >= 4 then
      Move(V[0], K.IntValue, 4);
  end
  else
    K.Data := V;
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegCreateKey;
begin
  var C := RegCategory(FHLE.Arg(0));
  if C = nil then
  begin
    FHLE.Result(REG_ERROR_BAD_HANDLE);
    Exit;
  end;
  var Name := FMemory.ReadString(FHLE.Arg(1), RegKeyNameSize);
  if C.Find(Name) = nil then
  begin
    var K := TRegKey.Create(Name, FHLE.ArgInt(2));
    SetLength(K.Data, FHLE.Arg(3));
    if Length(K.Data) > 0 then
      FillChar(K.Data[0], Length(K.Data), 0);
    C.Children.Add(K);
  end;
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetCategoryNumAtRoot;
begin
  if FHLE.Arg(1) <> 0 then
    FMemory.Write32(FHLE.Arg(1), Cardinal(FRegRoot.Children.Count));
  FHLE.Result(0);
end;

procedure TPSPMisc.hRegGetCategoryListAtRoot;
begin
  var Buf := FHLE.Arg(1);
  var N := Min(FHLE.ArgInt(2), FRegRoot.Children.Count);
  for var I := 0 to N - 1 do
    FMemory.WriteString(Buf + Cardinal(I) * RegKeyNameSize, RawByteString(FRegRoot.Children[I].Name), RegKeyNameSize);
  FHLE.Result(0);
end;

constructor TPSPMisc.Create(System: TPSPSystem);
begin
  inherited Create(System);
  FRegHandles := TDictionary<Cardinal, TRegKey>.Create;
end;

destructor TPSPMisc.Destroy;
begin
  FRegHandles.Free;
  FRegRoot.Free;
  inherited;
end;

procedure TPSPMisc.Reset;
begin
  FJis2Ucs := 0;
  FUcs2Jis := 0;
  FErrorChar[0] := Ord('?');
  FErrorChar[1] := Ord('?');
  FErrorChar[2] := Ord('?');
  FRegHandles.Clear;
  FRegNextHandle := 0;
  BuildRegistry;
end;

procedure TPSPMisc.Register;
const
  C = 'sceCcc';
  R = 'sceReg';
begin
