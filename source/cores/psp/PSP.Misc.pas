// The 18 fonts of flash0:/font in the registry's order.
function PSPFontFileName(Index: Integer): string;

implementation

uses
  System.Math, PSP.Settings;

function PSPFontFileName(Index: Integer): string;
begin
  case Index of
    0..15:
      Result := Format('ltn%d.pgf', [Index]);
    16:
      Result := 'jpn0.pgf';
  else
    Result := 'kr0.pgf';
  end;
end;

