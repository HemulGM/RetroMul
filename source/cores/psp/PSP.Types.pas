type
  EPSPError = class(Exception);

  // Raised when the guest does something the core cannot continue from (a CPU
  // exception the PSP would also stop on, or an internal invariant).
  EPSPGuestFault = class(EPSPError);

function PSPHex(Value: Cardinal): string; inline;
function AlignUp(Value, Alignment: Cardinal): Cardinal; inline;
function SignExtend16(Value: Cardinal): Cardinal; inline;
function SignExtend8(Value: Cardinal): Cardinal; inline;

implementation

function PSPHex(Value: Cardinal): string;
begin
  Result := IntToHex(Value, 8);
end;

function AlignUp(Value, Alignment: Cardinal): Cardinal;
begin
  Result := (Value + Alignment - 1) and not (Alignment - 1);
end;

function SignExtend16(Value: Cardinal): Cardinal;
begin
  Result := Cardinal(Integer(SmallInt(Word(Value))));
end;

function SignExtend8(Value: Cardinal): Cardinal;
begin
  Result := Cardinal(Integer(ShortInt(Byte(Value))));
end;

end.
