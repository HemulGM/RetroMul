function Sar(V: Int64; S: Integer): Int64; inline;
begin
  if V >= 0 then
    Result := V shr S
  else
    Result := not ((not V) shr S);
end;

// V of the comment above for a 23-bit argument, in quarters of a result bit.
function Interpolate(const Base, Slope: array of Integer; const Curve: array of SmallInt; Arg: Cardinal): Int64;
begin
  var K := Arg shr 16;
  var U := Integer(Arg and $FFFF) - 32768;
  var W := Integer(Sar(U, 6));
  var Sq := (W * W + 255) shr 8;
  Result := Base[K] + Sar(Curve[K] * Sq, 9) + Sar(Int64(Slope[K]) * U, 16);
end;

// Sign or Fixed * 2^(Scale - Frac) as a single (Fixed below 2^25); denormal
// results flush to signed zero.
function MakeFixed(Sign: Cardinal; Fixed: Int64; Frac, Scale: Integer): Cardinal;
begin
  if Fixed <= 0 then
    Exit(Sign);
  var E := 0;
  while (Fixed shr (E + 1)) <> 0 do
    Inc(E);
  var BE := E - Frac + Scale + 127;
  if BE >= 255 then
    Exit(Sign or $7F800000);
  if BE <= 0 then
    Exit(Sign);
  var M: Int64;
  if E > 23 then
    M := Fixed shr (E - 23)
  else
    M := Fixed shl (23 - E);
  Result := Sign or (Cardinal(BE) shl 23) or (Cardinal(M) and $7FFFFF);
end;

function NaNOf(X: Cardinal): Cardinal; inline;
begin
  Result := (X and $80000000) or VF_NAN;
end;

function VRcp(X: Cardinal): Cardinal;
begin
  X := VFlush(X);
  if VIsNaN(X) then
    Exit(NaNOf(X));
  if (X and $7FFFFFFF) = 0 then
    Exit((X and $80000000) or $7F800000);
  if (X and $7FFFFFFF) = $7F800000 then
    Exit(X and $80000000);
  var E := Integer((X shr 23) and $FF) - 127;
  var V := Interpolate(RcpBase, RcpSlope, RcpCurve, X and $7FFFFF);
  Result := MakeFixed(X and $80000000, V shr 2, 22, -E);
end;

function VNRcp(X: Cardinal): Cardinal;
begin
  Result := VRcp(X) xor $80000000;
end;

// The argument of vrsq's and vsqrt's tables: the exponent's last bit, then
// the mantissa's top 22 bits.
function RootArg(X: Cardinal; out Half: Integer): Cardinal;
begin
  var E := Integer((X shr 23) and $FF) - 127;
  var Odd := E and 1;
  Half := (E - Odd) div 2;
  Result := (Cardinal(Odd) shl 22) or ((X and $7FFFFF) shr 1);
end;

function VRsq(X: Cardinal): Cardinal;
begin
  X := VFlush(X);
  if VIsNaN(X) then
    Exit(NaNOf(X));
  if (X and $7FFFFFFF) = 0 then
    Exit((X and $80000000) or $7F800000);
  if (X and $80000000) <> 0 then
    Exit($FF800001);
  if X = $7F800000 then
    Exit(0);
  var Half: Integer;
  var V := Interpolate(RsqBase, RsqSlope, RsqCurve, RootArg(X, Half));
  Result := MakeFixed(0, V shr 2, 22, -Half);
end;

function VSqrt(X: Cardinal): Cardinal;
begin
  X := VFlush(X);
  if VIsNaN(X) then
    Exit(VF_NAN);
  if (X and $7FFFFFFF) = 0 then
    Exit(0);
  if (X and $80000000) <> 0 then
    Exit(VF_NAN);
  if X = $7F800000 then
    Exit($7F800000);
  var Half: Integer;
  var V := Interpolate(SqrtBase, SqrtSlope, SqrtCurve, RootArg(X, Half));
  Result := MakeFixed(0, V shr 2, 21, Half);
end;

// Angles are in quarter turns, taken as a magnitude in fixed point with 23
// fraction bits (truncated) modulo four turns. From 2^32 on the shifter takes
// the exponent modulo 32 as 1 to 32 (2^32, 2^64 and 2^96 shift everything
// out); recorded on a PSP-E1000 over a million random inputs.
function FixedAngle(X: Cardinal): Cardinal;
begin
  var E := Integer((X shr 23) and $FF) - 127;
  if E = -127 then
    Exit(0);
  if E >= 32 then
    E := ((E - 1) and 31) + 1;
  var M := (X and $7FFFFF) or $800000;
  if E >= 0 then
    Result := Cardinal(UInt64(M) shl E) and $1FFFFFF
  else if E > -24 then
    Result := M shr (-E)
  else
    Result := 0;
end;

function SinQuarter(X: Cardinal; Cosine: Boolean): Cardinal;
begin
  X := VFlush(X);
  if (X and $7F800000) = $7F800000 then
  begin
    if Cosine then
      Exit(VF_NAN);
    Exit(NaNOf(X));
  end;
  var A := FixedAngle(X);
  if Cosine then
    A := (A + $800000) and $1FFFFFF;
  var Q := A shr 23;
  var Fr := A and $7FFFFF;
  if Fr = 0 then
  begin
    case Q of
      0:
        Result := 0;
      1:
        Result := VF_ONE;
      2:
        Result := $80000000;
    else
      Result := $BF800000;
    end;
  end
  else
  begin
    if (Q and 1) <> 0 then
      Fr := $800000 - Fr;
    // The sine of Fr is the cosine of the rest of the quarter turn.
    var Arg := $800000 - Fr;
    var V := Interpolate(CosBase, CosSlope, CosCurve, Arg);
    Result := MakeFixed(0, V shr 2, CosFrac[Arg shr 16], 0);
    if Q >= 2 then
      Result := Result or $80000000;
  end;
  if not Cosine and ((X and $80000000) <> 0) then
    Result := Result xor $80000000;
end;

function VSin(X: Cardinal): Cardinal;
begin
  Result := SinQuarter(X, False);
end;

function VCos(X: Cardinal): Cardinal;
begin
  Result := SinQuarter(X, True);
end;

function VNSin(X: Cardinal): Cardinal;
begin
  Result := VSin(X) xor $80000000;
end;

function VAsin(X: Cardinal): Cardinal;
begin
  X := VFlush(X);
  if VIsNaN(X) then
    Exit(NaNOf(X));
  if (X and $7FFFFFFF) > VF_ONE then
    Exit(NaNOf(X));
  if (X and $7FFFFFFF) = 0 then
    Exit(X);
  if (X and $7FFFFFFF) = VF_ONE then
    Exit(X);
  // The input is taken in fixed point with 23 fraction bits.
  var A := Cardinal(Trunc(Abs(Double(BitsToSingle(X))) * 8388608.0));
  var V := Interpolate(AsinBase, AsinSlope, AsinCurve, A);
  Result := MakeFixed(X and $80000000, V shr 2, AsinFrac[A shr 16], 0);
end;

function VExp2(X: Cardinal): Cardinal;
begin
  X := VFlush(X);
  if VIsNaN(X) then
    Exit(VF_NAN);
  if X = $7F800000 then
    Exit($7F800000);
  if X = $FF800000 then
    Exit(0);
  var D: Double := BitsToSingle(X);
  if D >= 128 then
    Exit($7F800000);
  if D < -126 then
    Exit(0);
  // The exponent is taken in fixed point with 23 fraction bits, a negative
  // one as the ones' complement of its magnitude.
  var M: Int64 := Trunc(Abs(D) * 8388608.0);
  if D < 0 then
    M := not M;
  var V := Interpolate(Exp2Base, Exp2Slope, Exp2Curve, Cardinal(M and $7FFFFF));
  Result := MakeFixed(0, V shr 2, 21, Integer(Sar(M, 23)));
end;

function VRExp2(X: Cardinal): Cardinal;
begin
  Result := VExp2(X xor $80000000);
end;

function VLog2(X: Cardinal): Cardinal;
begin
  X := VFlush(X);
  if VIsNaN(X) then
    Exit(VF_NAN);
  if (X and $7FFFFFFF) = 0 then
    Exit($FF800000);
  if (X and $80000000) <> 0 then
    Exit(VF_NAN);
  if X = $7F800000 then
    Exit($7F800000);
  var E := Integer((X shr 23) and $FF) - 127;
  // Below 1 the result's magnitude is fixed point with 15 fraction bits.
  if E < 0 then
  begin
    var Low := Interpolate(Log2LowBase, Log2LowSlope, Log2LowCurve, X and $7FFFFF) shr 2;
    Exit(MakeFixed($80000000, (Int64(-E - 1) shl 15) + Low, 15, 0));
  end;
  if E = 0 then
    Exit(MakeFixed(0, Interpolate(Log2Base, Log2Slope, Log2Curve, X and $7FFFFF) shr 2, 22, 0));
  // From 2 on the result keeps 23 bits, E's integer bits taking Sh of the
  // fraction's: the slope's 16-bit field and the curvature (toward zero) lose
  // Sh bits, the base takes what they lose at the segment's start (U = -32768,
  // W = -512) and the sum is in units Sh bits coarser (recorded on a
  // PSP-E1000 for E = 2, 3, 4, 8, 16, 32 and 100: every mantissa bit-exact).
  var Sh := 0;
  while (E shr (Sh + 1)) <> 0 do
    Inc(Sh);
  var V: Int64;
  if Sh = 0 then
    V := Interpolate(Log2Base, Log2Slope, Log2Curve, X and $7FFFFF)
  else
  begin
    var K := (X and $7FFFFF) shr 16;
    var U := Integer(X and $FFFF) - 32768;
    var W := Integer(Sar(U, 6));
    var Sq := (W * W + 255) shr 8;
    var Slope := ((Log2Slope[K] shr 1) shr Sh) shl 1;
    var Curve := Log2Curve[K] div (1 shl Sh);
    var Base := Log2Base[K] + 2 * (Log2Curve[K] - Curve * (1 shl Sh)) - (Log2Slope[K] - Slope * (1 shl Sh)) div 2;
    V := (Base shr Sh) + Sar(Curve * Sq, 9) + Sar(Int64(Slope) * U, 16);
  end;
  Result := MakeFixed(0, (Int64(E) shl (22 - Sh)) + Sar(V, 2), 22 - Sh, 0);
end;

end.
