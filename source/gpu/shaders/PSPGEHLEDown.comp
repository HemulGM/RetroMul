#version 450
// The HLE renderer's targets drawn at a scale, brought back to the PSP's
// resolution: every PSP pixel takes the sample at the centre of its block.
// The colour goes out as RGBA8 words with the stencil in the alpha byte, the
// depth as float words. The third mode copies the colour as it is shown:
// opaque ARGB words, at the scale (step 1), in the target format's precision.
// The fourth writes the stencil into the colour's alpha (its mirror) in place.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uColor;
layout(set = 0, binding = 1) uniform sampler2D uDepth;
layout(set = 0, binding = 2) uniform usampler2D uStencil;
layout(set = 0, binding = 3) buffer Out {
  uint words[];
};
layout(set = 0, binding = 4, rgba8) uniform image2D uTarget;

layout(push_constant) uniform Push {
  // The box, in output pixels.
  ivec2 origin;
  ivec2 size;
  // Image pixels per output pixel.
  int step;
  // In words.
  uint offset;
  // 1: colour and stencil, 2: depth, 3: shown colour, 4: stencil into alpha.
  uint what;
  // The target format (mode 3).
  uint format;
} pc;

uvec3 shown(uvec3 c) {
  if (pc.format == 0u) {
    uvec3 q = c >> uvec3(3u, 2u, 3u);
    return uvec3((q.r << 3) | (q.r >> 2), (q.g << 2) | (q.g >> 4), (q.b << 3) | (q.b >> 2));
  }
  if (pc.format == 1u) {
    uvec3 q = c >> 3u;
    return (q << 3) | (q >> 2);
  }
  if (pc.format == 2u)
    return (c >> 4u) * 17u;
  return c;
}

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= pc.size.x || p.y >= pc.size.y)
    return;
  if (pc.what == 4u) {
    ivec2 q = pc.origin + p;
    vec4 c = imageLoad(uTarget, q);
    c.a = float(texelFetch(uStencil, q, 0).r & 255u) / 255.0;
    imageStore(uTarget, q, c);
    return;
  }
  ivec2 src = (pc.origin + p) * pc.step + pc.step / 2;
  uint i = pc.offset + uint(p.y * pc.size.x + p.x);
  if (pc.what == 1u) {
    uvec4 c = uvec4(round(texelFetch(uColor, src, 0) * 255.0));
    uint s = texelFetch(uStencil, src, 0).r & 255u;
    words[i] = c.r | (c.g << 8) | (c.b << 16) | (s << 24);
  } else if (pc.what == 2u) {
    words[i] = floatBitsToUint(texelFetch(uDepth, src, 0).r);
  } else {
    uvec3 c = shown(uvec3(round(texelFetch(uColor, src, 0).rgb * 255.0)));
    words[i] = 0xFF000000u | (c.r << 16) | (c.g << 8) | c.b;
  }
}
