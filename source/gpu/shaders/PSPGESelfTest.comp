#version 450
// The float arithmetic PSPGERaster.comp relies on, for a comparison with the
// CPU before the device is used: double add and multiply, conversions,
// roundEven, single multiply, and the long division of SoftDouble.glsl.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#include "FloatControls.glsl"
#include "SoftDouble.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Inputs { uvec4 inputs[]; };
layout(std430, binding = 1) writeonly buffer Outputs { uint outputs[]; };

layout(push_constant) uniform Push { uint count; } pc;

const uint Stride = 16;

void put64(uint o, double v)
{
  uvec2 w = unpackDouble2x32(v);
  outputs[o] = w.x;
  outputs[o + 1] = w.y;
}

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count)
    return;
  uvec4 v = inputs[i];
  precise float fa = uintBitsToFloat(v.x);
  precise float fb = uintBitsToFloat(v.y);
  precise double da = packDouble2x32(v.xy);
  precise double db = packDouble2x32(v.zw);
  uint o = i * Stride;
  precise float prod = fa * fb;
  outputs[o + 0] = floatBitsToUint(prod);
  precise double dsum = da + db;
  precise double dprod = da * db;
  precise double dwide = double(fa) * double(db);
  put64(o + 1, dsum);
  put64(o + 3, dprod);
  put64(o + 5, dwide);
  outputs[o + 7] = floatBitsToUint(float(da));
  put64(o + 8, double(int64_t(packUint2x32(v.zw))));
  put64(o + 10, roundEven(da));
  put64(o + 12, divD(da, db));
  outputs[o + 14] = abs(da) < 2147483648.0lf ? uint(int(da)) : 0u;
  outputs[o + 15] = 0u;
}
