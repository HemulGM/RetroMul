procedure USACReadStereoPrediction(var Bits: TBitReader; var State: TUSACStereoState; Groups, MaxSFB, Sequence: Integer; Independent: Boolean; const ScaleTable: TVLCTable);
var
  DeltaTime, AllBands: Boolean;
  LastReal, LastImag: Double;
begin
  if Groups * MaxSFB > Length(State.Used) then
    raise EPlayerFormat.Create('USAC prediction band overflow');
  if Independent then
  begin
    FillChar(State.PreviousReal, SizeOf(State.PreviousReal), 0);
    FillChar(State.PreviousImag, SizeOf(State.PreviousImag), 0);
  end;
  FillChar(State.AlphaReal, SizeOf(State.AlphaReal), 0);
  FillChar(State.AlphaImag, SizeOf(State.AlphaImag), 0);
  AllBands := Bits.ReadBit;
  for var g := 0 to Groups - 1 do
  begin
    var b := 0;
    while b < MaxSFB do
    begin
      var Used := AllBands or Bits.ReadBit;
      State.Used[g * MaxSFB + b] := Used;
      if b + 1 < MaxSFB then
        State.Used[g * MaxSFB + b + 1] := Used;
      Inc(b, 2);
    end;
  end;
  State.Direction := Bits.ReadBit;
  State.ComplexCoefficients := Bits.ReadBit;
  State.UsePrevious := State.ComplexCoefficients and not Independent and Bits.ReadBit;
  DeltaTime := not Independent and Bits.ReadBit;
  for var g := 0 to Groups - 1 do
  begin
    var b := 0;
    while b < MaxSFB do
    begin
      LastReal := 0;
      LastImag := 0;
      if DeltaTime then
      begin
        if g > 0 then
        begin
          LastReal := State.AlphaReal[(g - 1) * MaxSFB + b];
          LastImag := State.AlphaImag[(g - 1) * MaxSFB + b];
        end
        else
        begin
          var PreviousGroup := 0;
          if (Sequence = 2) and (State.Sequence = 2) then
            PreviousGroup := Max(0, State.Groups - 1);
          LastReal := State.PreviousReal[PreviousGroup * State.Bands + b];
          LastImag := State.PreviousImag[PreviousGroup * State.Bands + b];
        end;
      end
      else if b > 0 then
      begin
        LastReal := State.AlphaReal[g * MaxSFB + b - 1];
        LastImag := State.AlphaImag[g * MaxSFB + b - 1];
      end;
      if State.Used[g * MaxSFB + b] then
      begin
        LastReal := LastReal + (60 - Bits.ReadVLC(ScaleTable)) * 0.1;
        if State.ComplexCoefficients then
          LastImag := LastImag + (60 - Bits.ReadVLC(ScaleTable)) * 0.1;
      end
      else
      begin
        LastReal := 0;
        LastImag := 0;
      end;
      if not State.ComplexCoefficients then
        LastImag := 0;
      State.AlphaReal[g * MaxSFB + b] := LastReal;
      State.AlphaImag[g * MaxSFB + b] := LastImag;
      if b + 1 < MaxSFB then
      begin
        State.AlphaReal[g * MaxSFB + b + 1] := LastReal;
        State.AlphaImag[g * MaxSFB + b + 1] := LastImag;
      end;
      Inc(b, 2);
    end;
  end;
end;

procedure USACApplyStereoPrediction(var State: TUSACStereoState; var Left, Right: array of Double; FrameLength, Groups, MaxSFB, Sequence, Shape, PreviousShape: Integer; const GroupLength: array of Integer; const Offsets: array of Word);
var
  RealPart, Previous, Imaginary: TFloatSamples;
  Base, WindowLength, Sign, FilterIndex, ShapeIndex: Integer;

  procedure Interpolate(const Data: TFloatSamples; DataStart, OutputStart: Integer; const Filter: array of Double; PreviousFrame: Boolean);
  var
    Sum: Double;
    Position: Integer;
  begin
    for var i := 0 to WindowLength - 1 do
    begin
      Sum := 0;
      for var j := -3 to 3 do
      begin
        Position := i + j;
        if Position < 0 then
          Position := -Position - 1;
        if Position >= WindowLength then
          Position := 2 * WindowLength - 1 - Position;
        Sum := Sum + Filter[3 + j] * Data[DataStart + Position];
      end;
      if PreviousFrame and not Odd(i) then
        Sum := -Sum;
      Imaginary[OutputStart + i] := Imaginary[OutputStart + i] + Sum;
    end;
  end;

begin
  SetLength(RealPart, FrameLength);
  SetLength(Previous, FrameLength);
  SetLength(Imaginary, FrameLength);
  WindowLength := FrameLength;
  if Sequence = 2 then
    WindowLength := FrameLength div 8;
  Sign := 1;
  if State.Direction then
    Sign := -1;
  Base := 0;
  for var g := 0 to Groups - 1 do
  begin
    for var b := 0 to MaxSFB - 1 do
      for var w := 0 to GroupLength[g] - 1 do
        for var k := Offsets[b] to Offsets[b + 1] - 1 do
        begin
          var Position := (Base + w) * WindowLength + k;
          if State.Used[g * MaxSFB + b] then
            RealPart[Position] := Left[Position]
          else
            RealPart[Position] := (Left[Position] + Sign * Right[Position]) * 0.5;
          Previous[Position] :=
            (State.PreviousSpectrum[0, Position] + Sign * State.PreviousSpectrum[1, Position]) * 0.5;
        end;
    Inc(Base, GroupLength[g]);
  end;
  FilterIndex := 0;
  if Sequence = 1 then
    FilterIndex := 1
  else if Sequence = 3 then
    FilterIndex := 2
  else if Sequence = 4 then
    FilterIndex := 3;
  if Shape = PreviousShape then
    ShapeIndex := Shape
  else if Shape = 0 then
    ShapeIndex := 2
  else
    ShapeIndex := 3;
  for var w := 0 to FrameLength div WindowLength - 1 do
  begin
    Interpolate(RealPart, w * WindowLength, w * WindowLength, USAC_MDST_FILTER[FilterIndex, ShapeIndex], False);
    if w > 0 then
      Interpolate(
        RealPart,
        (w - 1) * WindowLength,
        w * WindowLength,
        USAC_MDST_PREVIOUS[2 * Ord(Sequence in [3, 4]) + PreviousShape],
        True
      )
    else if State.UsePrevious then
      Interpolate(
        Previous,
        FrameLength - WindowLength,
        0,
        USAC_MDST_PREVIOUS[2 * Ord(Sequence in [3, 4]) + PreviousShape],
        True
      );
  end;
  Base := 0;
  for var g := 0 to Groups - 1 do
  begin
    for var b := 0 to MaxSFB - 1 do
      if State.Used[g * MaxSFB + b] then
        for var w := 0 to GroupLength[g] - 1 do
          for var k := Offsets[b] to Offsets[b + 1] - 1 do
          begin
            var Position := (Base + w) * WindowLength + k;
            var Mid := Left[Position];
            var Side :=
              Right[Position]
              - State.AlphaReal[g * MaxSFB + b] * Mid
              - State.AlphaImag[g * MaxSFB + b] * Imaginary[Position];
            Left[Position] := Mid + Side;
            if State.Direction then
              Right[Position] := Side - Mid
            else
              Right[Position] := Mid - Side;
          end;
    Inc(Base, GroupLength[g]);
  end;
end;

function USACEscapedValue(var Bits: TBitReader; N1, N2, N3: Integer): Cardinal;
begin
  Result := Bits.ReadBits(N1);
  if (Result = Cardinal((1 shl N1) - 1)) and (N2 <> 0) then
  begin
    var Extra := Bits.ReadBits(N2);
    Inc(Result, Extra);
    if (Extra = Cardinal((1 shl N2) - 1)) and (N3 <> 0) then
      Inc(Result, Bits.ReadBits(N3));
  end;
end;

function USACBandOffsets(FrameLength, RateIndex: Integer; ShortWindows: Boolean): TArray<Word>;

  procedure Assign(const Values: array of Word);
  begin
    SetLength(Result, Length(Values));
    Move(Values[0], Result[0], Length(Values) * SizeOf(Word));
  end;

begin
  if FrameLength <> 768 then
    raise EPlayerFormat.Create('Invalid USAC 768 band family');
  if ShortWindows then
    case RateIndex of
      0..1:
        Assign(SWB_OFFSET_96_96);
      2:
        Assign(SWB_OFFSET_96_64);
      3..5:
        Assign(SWB_OFFSET_96_48);
      6..7:
        Assign(SWB_OFFSET_96_24);
      8..10:
        Assign(SWB_OFFSET_96_16);
    else
      Assign(SWB_OFFSET_96_8);
    end
  else
    case RateIndex of
      0..1:
        Assign(SWB_OFFSET_768_96);
      2:
        Assign(SWB_OFFSET_768_64);
      3..4:
        Assign(SWB_OFFSET_768_48);
      5:
        Assign(SWB_OFFSET_768_32);
      6..7:
        Assign(SWB_OFFSET_768_24);
      8..10:
        Assign(SWB_OFFSET_768_16);
    else
      Assign(SWB_OFFSET_768_8);
    end;
end;

procedure USACDecodeSpectrum(var Bits: TBitReader; var State: TAACArithState; Reset: Boolean; Count, WindowLength: Integer; out Spectrum: TFloatSamples; Linear: Boolean);
var
  Reader: TBitReader;
  Low, High, Value, Initial, Index, Level, Escape, Symbol, A, B: Integer;
  Context: Cardinal;

  function Decode(const CDF: array of Word): Integer;
  var
    Range, C: Int64;
  begin
    Range := High - Low + 1;
    if (Value < Low) or (Value > High) then
      raise EPlayerFormat.Create('Invalid USAC arithmetic interval');
    C := (Int64(Value - Low + 1) shl 14) - 1;
    Result := 0;
    while (Result < Length(CDF)) and (Int64(CDF[Result]) * Range > C) do
      Inc(Result);
    if Result = Length(CDF) then
      raise EPlayerFormat.Create('Invalid USAC arithmetic symbol');
    if Result <> 0 then
      High := Low + ((Range * CDF[Result - 1]) shr 14) - 1;
    Inc(Low, (Range * CDF[Result]) shr 14);
    repeat
      if High < 32768 then
      begin
      end
      else if Low >= 32768 then
      begin
        Dec(Value, 32768);
        Dec(Low, 32768);
        Dec(High, 32768);
      end
      else if (Low >= 16384) and (High < 49152) then
      begin
        Dec(Value, 16384);
        Dec(Low, 16384);
        Dec(High, 16384);
      end
      else
        Break;
      Low := Low * 2;
      High := High * 2 + 1;
      Value := Value * 2 + Integer(Reader.ReadBits(1));
    until False;
  end;

  function ProbabilityIndex(C: Cardinal): Integer;
  var
    First, Last, Middle: Integer;
    Entry: Cardinal;
  begin
    First := -1;
    Last := Length(AC_LOOKUP) - 1;
    while Last - First > 1 do
    begin
      Middle := First + (Last - First) div 2;
      Entry := AC_HASH[Middle];
      if C < Entry shr 8 then
        Last := Middle
      else if C > Entry shr 8 then
        First := Middle
      else
        Exit(Entry and 255);
    end;
    Result := AC_LOOKUP[Last];
  end;

begin
  if (WindowLength < 1)
    or (WindowLength > 1024)
    or Odd(WindowLength)
    or (Count < 0)
    or (Count > WindowLength)
    or Odd(Count) then
    raise EPlayerFormat.Create('Invalid USAC arithmetic spectrum size');
  if Reset or (State.LastLength = 0) then
  begin
    FillChar(State.Last, SizeOf(State.Last), 0);
    State.LastLength := WindowLength;
  end
  else if State.LastLength <> WindowLength then
  begin
    var Previous := State.Last;
    for var i := 0 to WindowLength div 2 - 1 do
      State.Last[i] := Previous[i * State.LastLength div WindowLength];
    for var i := WindowLength div 2 to 512 do
      State.Last[i] := 0;
    State.LastLength := WindowLength;
  end;
  FillChar(State.Current, SizeOf(State.Current), 0);
  State.Current[0] := 1;
  State.Previous := State.Last[0] shl 12;
  SetLength(Spectrum, WindowLength);
  Index := 0;
  if Count <> 0 then
  begin
    Reader := Bits;
    Reader.AppendZeroPadding(2);
    Initial := Reader.Position;
    Low := 0;
    High := 65535;
    Value := Reader.ReadBits(16);
    while Index < Count div 2 do
    begin
      Context := ((State.Previous shr 8) + (Cardinal(State.Last[Index + 1]) shl 8)) shl 4;
      Inc(Context, State.Current[1]);
      State.Previous := Context and $FFFF;
      if (Index > 3) and (State.Current[3] + State.Current[2] + State.Current[1] < 5) then
        Inc(Context, $10000);
      Level := 0;
      Escape := 0;
      repeat
        Symbol := Decode(AC_MSB[ProbabilityIndex(Context + (Cardinal(Escape) shl 17))]);
        if Symbol < 16 then
          Break;
        Inc(Level);
        if Level > 23 then
          raise EPlayerFormat.Create('USAC arithmetic escape overflow');
        Escape := Min(Level, 7);
      until False;
      if (Symbol = 0) and (Escape <> 0) then
        Break;
      A := Symbol and 3;
      B := Symbol shr 2;
      for var j := Level downto 1 do
      begin
        var LSBIndex := 2;
        if A = 0 then
          LSBIndex := 1
        else if B = 0 then
          LSBIndex := 0;
        var R := Decode(AC_LSB[LSBIndex]);
        A := A * 2 + (R and 1);
        B := B * 2 + (R shr 1);
      end;
      if Linear then
      begin
        Spectrum[Index * 2] := A;
        Spectrum[Index * 2 + 1] := B;
      end
      else
      begin
        Spectrum[Index * 2] := Power(A, 4 / 3);
        Spectrum[Index * 2 + 1] := Power(B, 4 / 3);
      end;
      State.Current[0] := Min(A + B + 1, 15);
      State.Current[3] := State.Current[2];
      State.Current[2] := State.Current[1];
      State.Current[1] := State.Current[0];
      State.Last[Index] := State.Current[0];
      Inc(Index);
    end;
    var Consumed := Reader.Position - Initial - 14;
    if Consumed < 0 then
      raise EPlayerFormat.Create('Invalid USAC arithmetic termination');
    Bits.Skip(Consumed);
  end;
  for var i := Index to WindowLength div 2 - 1 do
    State.Last[i] := 1;
  for var i := WindowLength div 2 to 512 do
    State.Last[i] := 0;
  for var i := 0 to Count - 1 do
    if Spectrum[i] <> 0 then
      if not Bits.ReadBit then
        Spectrum[i] := -Spectrum[i];
end;

end.

