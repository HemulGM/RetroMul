  S^.PredState := nil;
  S^.PhDispSt := nil;
  S^.DtxDecoderState := nil;
  if (AmrDPlsfInit(PPAMRDPlsfState(@S^.LsfState)) <> 0) or
    (AmrEcGainPitchInit(PPAMRecGainPitchState(@S^.EcGainPSt)) <> 0) or
    (AmrEcGainCodeInit(PPAMRecGainCodeState(@S^.EcGainCSt)) <> 0) or
    (AmrGcPredInit(PPAMRgcPredState(@S^.PredState)) <> 0) or
    (AmrCbGainAverageInit(PPAMRCbGainAverageState(@S^.CbGainAverState)) <> 0) or
    (AmrLspAvgInit(PPAMRlspAvgState(@S^.LspAvgSt)) <> 0) or
    (AmrBgnScdInit(PPAMRBgnScdState(@S^.BackgroundState)) <> 0) or
    (AmrPhDispInit(PPAMRphDispState(@S^.PhDispSt)) <> 0) or
    (AmrDtxDecInit(PPAMRdtxDecState(@S^.DtxDecoderState)) <> 0) then
  begin
    AmrDecoderAmrExit(PPAMRDecoderAmrState(@S));
    Exit(-1);
  end;
  AmrDecoderAmrReset(S, Integer(0));
  State^ := S;
  Result := 0;
end;

