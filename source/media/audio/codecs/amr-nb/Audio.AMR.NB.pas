  CopySamples(PAMRSmallInt(@DPlsf3PastRqInit[ArgIndex * 10]), PAMRSmallInt(@State^.PastRQ[0]), 10);
end;

procedure AmrDPlsf3(State: PAMRDPlsfState; Mode: Integer; Bfi: SmallInt; Indice, Lsp1Q: PAMRSmallInt);
var
  I: SmallInt;
  IndexValue: SmallInt;
  PCb1: PAMRSmallInt;
  PCb2: PAMRSmallInt;
  PCb3: PAMRSmallInt;
  Codebook: PAMRSmallInt;
  Temp: SmallInt;
  Lsf1R: array[0..9] of SmallInt;
  Lsf1Q: array[0..9] of SmallInt;
begin
  if Bfi <> 0 then
  begin
    I := 0;
    while I < 10 do
    begin
      Lsf1Q[I] := FixedPoint.Add(FixedPoint.Mult(State^.PastLsfQ[I], 29491), FixedPoint.Mult(DPlsf3MeanLsf[I], 3277));
      Inc(I);
    end;
    if FixedPoint.Sub(Mode, MRDTX) <> 0 then
    begin
      I := 0;
      while I < 10 do
      begin
        Temp := FixedPoint.Add(DPlsf3MeanLsf[I], FixedPoint.Mult(State^.PastRQ[I], DPlsf3PredFac[I]));
        State^.PastRQ[I] := FixedPoint.Sub(Lsf1Q[I], Temp);
        Inc(I);
      end;
    end
    else
    begin
      I := 0;
      while I < 10 do
      begin
        Temp := FixedPoint.Add(DPlsf3MeanLsf[I], State^.PastRQ[I]);
        State^.PastRQ[I] := FixedPoint.Sub(Lsf1Q[I], Temp);
        Inc(I);
      end;
    end;
  end
  else
  begin
    if (FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) then
    begin
      PCb1 := PAMRSmallInt(@DPlsf3Dico1Lsf[0]);
      PCb2 := PAMRSmallInt(@DPlsf3Dico2Lsf[0]);
      PCb3 := PAMRSmallInt(@DPlsf3Mr5153Lsf[0]);
    end
    else
    begin
      if FixedPoint.Sub(Mode, MR795) = 0 then
      begin
        PCb1 := PAMRSmallInt(@DPlsf3Mr7951Lsf[0]);
        PCb2 := PAMRSmallInt(@DPlsf3Dico2Lsf[0]);
        PCb3 := PAMRSmallInt(@DPlsf3Dico3Lsf[0]);
      end
      else
      begin
        PCb1 := PAMRSmallInt(@DPlsf3Dico1Lsf[0]);
        PCb2 := PAMRSmallInt(@DPlsf3Dico2Lsf[0]);
        PCb3 := PAMRSmallInt(@DPlsf3Dico3Lsf[0]);
      end;
    end;
    IndexValue := Indice^;
    Inc(Indice);
    Codebook := PAMRSmallInt(@PCb1[FixedPoint.Add(IndexValue, FixedPoint.Add(IndexValue, IndexValue))]);
    Lsf1R[0] := Codebook^;
    Inc(Codebook);
    Lsf1R[1] := Codebook^;
    Inc(Codebook);
    Lsf1R[2] := Codebook^;
    IndexValue := Indice^;
    Inc(Indice);
    if (FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) then
      IndexValue := FixedPoint.ShiftLeft(IndexValue, 1);
    Codebook := PAMRSmallInt(@PCb2[FixedPoint.Add(IndexValue, FixedPoint.Add(IndexValue, IndexValue))]);
    Lsf1R[3] := Codebook^;
    Inc(Codebook);
    Lsf1R[4] := Codebook^;
    Inc(Codebook);
    Lsf1R[5] := Codebook^;
    IndexValue := Indice^;
    Codebook := PAMRSmallInt(@PCb3[FixedPoint.ShiftLeft(IndexValue, 2)]);
    Lsf1R[6] := Codebook^;
    Inc(Codebook);
    Lsf1R[7] := Codebook^;
    Inc(Codebook);
    Lsf1R[8] := Codebook^;
    Inc(Codebook);
    Lsf1R[9] := Codebook^;
    if FixedPoint.Sub(Mode, MRDTX) <> 0 then
    begin
      I := 0;
      while I < 10 do
      begin
        Temp := FixedPoint.Add(DPlsf3MeanLsf[I], FixedPoint.Mult(State^.PastRQ[I], DPlsf3PredFac[I]));
        Lsf1Q[I] := FixedPoint.Add(Lsf1R[I], Temp);
        State^.PastRQ[I] := Lsf1R[I];
        Inc(I);
      end;
    end
    else
    begin
      I := 0;
      while I < 10 do
      begin
        Temp := FixedPoint.Add(DPlsf3MeanLsf[I], State^.PastRQ[I]);
        Lsf1Q[I] := FixedPoint.Add(Lsf1R[I], Temp);
        State^.PastRQ[I] := Lsf1R[I];
        Inc(I);
      end;
    end;
  end;
  AmrReorderLsf(PAMRSmallInt(@Lsf1Q[0]), 205, 10);
  CopySamples(PAMRSmallInt(@Lsf1Q[0]), PAMRSmallInt(@State^.PastLsfQ[0]), 10);
  AmrLsfLsp(PAMRSmallInt(@Lsf1Q[0]), Lsp1Q, 10);
end;

function AmrPseudonoise(ShiftReg: PAMRInteger; NoBits: SmallInt): SmallInt;
var
  NoiseBits: SmallInt;
  Sn: SmallInt;
  I: SmallInt;
begin
  NoiseBits := 0;
  I := 0;
  while I < NoBits do
  begin
    if (ShiftReg^ and $1) <> 0 then
      Sn := 1
    else
      Sn := 0;
    if (ShiftReg^ and $10000000) <> 0 then
      Sn := Sn xor 1
    else
      Sn := Sn xor 0;
    NoiseBits := FixedPoint.ShiftLeft(NoiseBits, 1);
    NoiseBits := NoiseBits or (AmrExtractL(ShiftReg^) and 1);
    ShiftReg^ := FixedPoint.LShr(ShiftReg^, 1);
    if (Sn and 1) <> 0 then
      ShiftReg^ := ShiftReg^ or $40000000;
    Inc(I);
  end;
  Result := NoiseBits;
end;

procedure AmrARefl(A, Refl: PAMRSmallInt);
label
  Label_ExitRefl;
var
  I: SmallInt;
  J: SmallInt;
  AState: array[0..9] of SmallInt;
  BState: array[0..9] of SmallInt;
  NormShift: SmallInt;
  NormProd: SmallInt;
  LAcc: Integer;
  Scale: SmallInt;
  LTemp: Integer;
  Temp: SmallInt;
  Mult: SmallInt;
begin
  I := 0;
  while I < 10 do
  begin
    AState[I] := A[I];
    Inc(I);
  end;
  I := 10 - 1;
  while I >= 0 do
  begin
    if FixedPoint.Sub(AmrAbsS(AState[I]), 4096) >= 0 then
    begin
      goto Label_ExitRefl;
    end;
    Refl[I] := FixedPoint.ShiftLeft(AState[I], 3);
    LTemp := FixedPoint.LMult(Refl[I], Refl[I]);
    LAcc := FixedPoint.LSub(Integer($7FFFFFFF), LTemp);
    NormShift := AmrNormL(LAcc);
    Scale := FixedPoint.Sub(15, NormShift);
    LAcc := FixedPoint.LShl(LAcc, NormShift);
    NormProd := FixedPoint.Round(LAcc);
    Mult := FixedPoint.DivS(16384, NormProd);
    J := 0;
    while J < I do
    begin
      LAcc := AmrLDepositH(AState[J]);
      LAcc := FixedPoint.LMsu(LAcc, Refl[I], AState[(I - J) - 1]);
      Temp := FixedPoint.Round(LAcc);
      LTemp := FixedPoint.LMult(Mult, Temp);
      LTemp := FixedPoint.LShrR(LTemp, Scale);
      if FixedPoint.LSub(AmrLAbs(LTemp), 32767) > 0 then
      begin
        goto Label_ExitRefl;
      end;
      BState[J] := AmrExtractL(LTemp);
      Inc(J);
    end;
    J := 0;
    while J < I do
    begin
      AState[J] := BState[J];
      Inc(J);
    end;
    Dec(I);
  end;
  Exit;
Label_ExitRefl:
  I := 0;
  while I < 10 do
  begin
    Refl[I] := 0;
    Inc(I);
  end;
end;

procedure AmrBuildCNCode(Seed: PAMRInteger; Cod: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  K: SmallInt;
begin
  I := 0;
  while I < 40 do
  begin
    Cod[I] := 0;
    Inc(I);
  end;
  for K := 0 to 9 do
  begin
    I := AmrPseudonoise(Seed, 2);
    I := FixedPoint.ShiftRight(AmrExtractL(FixedPoint.LMult(I, 10)), 1);
    I := FixedPoint.Add(I, K);
    J := AmrPseudonoise(Seed, 1);
    if J > 0 then
      Cod[I] := 4096
    else
      Cod[I] := -4096;
  end;
end;

procedure AmrSynFilt(A, X, Y: PAMRSmallInt; Lg: SmallInt; Mem: PAMRSmallInt; Update: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  S: Integer;
  Tmp: array[0..79] of SmallInt;
  Yy: PAMRSmallInt;
begin
  Yy := PAMRSmallInt(@Tmp[0]);
  I := 0;
  while I < 10 do
  begin
    Yy^ := Mem[I];
    Inc(Yy);
    Inc(I);
  end;
  I := 0;
  while I < Lg do
  begin
    S := FixedPoint.LMult(X[I], A[0]);
    J := 1;
    while J <= 10 do
    begin
      S := FixedPoint.LMsu(S, A[J], Yy[-J]);
      Inc(J);
    end;
    S := FixedPoint.LShl(S, 3);
    Yy^ := FixedPoint.Round(S);
    Inc(Yy);
    Inc(I);
  end;
  I := 0;
  while I < Lg do
  begin
    Y[I] := Tmp[I + 10];
    Inc(I);
  end;
  if Update <> 0 then
  begin
    I := 0;
    while I < 10 do
    begin
      Mem[I] := Y[(Lg - 10) + I];
      Inc(I);
    end;
  end;
end;

function AmrDtxDec(State: PAMRdtxDecState; MemSyn: PAMRSmallInt; LsfState: PAMRDPlsfState; PredState: PAMRgcPredState; AverState: PAMRCbGainAverageState; NewState, Mode: Integer; Parm, Synth, AT: PAMRSmallInt): Integer;
var
  LogEnIndex: SmallInt;
  I: SmallInt;
  J: SmallInt;
  IntFac: SmallInt;
  LLogEnInt: Integer;
  LspInt: array[0..9] of SmallInt;
  LogEnIntE: SmallInt;
  LogEnIntM: SmallInt;
  Level: SmallInt;
  Acoeff: array[0..10] of SmallInt;
  Refl: array[0..9] of SmallInt;
  PredErr: SmallInt;
  Ex: array[0..39] of SmallInt;
  MaPredInit: SmallInt;
  LogPgE: SmallInt;
  LogPgM: SmallInt;
  LogPg: SmallInt;
  Negative: Integer;
  LsfMean: SmallInt;
  LLsfMean: Integer;
  LsfVariabIndex: SmallInt;
  LsfVariabFactor: SmallInt;
  LsfInt: array[0..9] of SmallInt;
  LsfIntVariab: array[0..9] of SmallInt;
  LspIntVariab: array[0..9] of SmallInt;
  AcoeffVariab: array[0..10] of SmallInt;
  Lsf: array[0..9] of SmallInt;
  LLsf: array[0..9] of Integer;
  Ptr: SmallInt;
  TmpIntLength: SmallInt;
begin
  if (State^.DtxHangoverAdded <> 0) and (State^.SidFrame <> 0) then
  begin
    State^.LogEnAdjust := DtxDecDtxLogEnAdjust[Mode];
    Ptr := FixedPoint.Add(State^.LsfHistPtr, 10);
    if FixedPoint.Sub(Ptr, 80) = 0 then
      Ptr := 0;
    CopySamples(PAMRSmallInt(@State^.LsfHist[State^.LsfHistPtr]), PAMRSmallInt(@State^.LsfHist[Ptr]), 10);
    Ptr := FixedPoint.Add(State^.LogEnHistPtr, 1);
    if FixedPoint.Sub(Ptr, 8) = 0 then
      Ptr := 0;
    State^.LogEnHist[Ptr] := State^.LogEnHist[State^.LogEnHistPtr];
    State^.LogEn := 0;
    I := 0;
    while I < 10 do
    begin
      LLsf[I] := 0;
      Inc(I);
    end;
    I := 0;
    while I < 8 do
    begin
      State^.LogEn := FixedPoint.Add(State^.LogEn, FixedPoint.ShiftRight(State^.LogEnHist[I], 3));
      J := 0;
      while J < 10 do
      begin
        LLsf[J] := FixedPoint.LAdd(LLsf[J], AmrLDepositL(State^.LsfHist[(I * 10) + J]));
        Inc(J);
      end;
      Inc(I);
    end;
    J := 0;
    while J < 10 do
    begin
      Lsf[J] := AmrExtractL(FixedPoint.LShr(LLsf[J], 3));
      Inc(J);
    end;
    AmrLsfLsp(PAMRSmallInt(@Lsf[0]), PAMRSmallInt(@State^.Lsp[0]), 10);
    State^.LogEn := FixedPoint.Sub(State^.LogEn, State^.LogEnAdjust);
    CopySamples(PAMRSmallInt(@State^.LsfHist[0]), PAMRSmallInt(@State^.LsfHistMean[0]), 80);
    I := 0;
    while I < 10 do
    begin
      LLsfMean := 0;
      J := 0;
      while J < 8 do
      begin
        LLsfMean := FixedPoint.LAdd(LLsfMean, AmrLDepositL(State^.LsfHistMean[I + (J * 10)]));
        Inc(J);
      end;
      LsfMean := AmrExtractL(FixedPoint.LShr(LLsfMean, 3));
      J := 0;
      while J < 8 do
      begin
        State^.LsfHistMean[I + (J * 10)] := FixedPoint.Sub(State^.LsfHistMean[I + (J * 10)], LsfMean);
        State^.LsfHistMean[I + (J * 10)] := FixedPoint.Mult(State^.LsfHistMean[I + (J * 10)], DtxDecLsfHistMeanScale[I]);
        if State^.LsfHistMean[I + (J * 10)] < 0 then
          Negative := 1
        else
          Negative := 0;
        State^.LsfHistMean[I + (J * 10)] := AmrAbsS(State^.LsfHistMean[I + (J * 10)]);
        if FixedPoint.Sub(State^.LsfHistMean[I + (J * 10)], 655) > 0 then
          State^.LsfHistMean[I + (J * 10)] := FixedPoint.Add(655,
              FixedPoint.ShiftRight(FixedPoint.Sub(State^.LsfHistMean[I + (J * 10)], 655), 2));
        if FixedPoint.Sub(State^.LsfHistMean[I + (J * 10)], 1310) > 0 then
          State^.LsfHistMean[I + (J * 10)] := 1310;
        if Negative <> 0 then
          State^.LsfHistMean[I + (J * 10)] := -State^.LsfHistMean[I + (J * 10)];
        Inc(J);
      end;
      Inc(I);
    end;
  end;
  if State^.SidFrame <> 0 then
  begin
    CopySamples(PAMRSmallInt(@State^.Lsp[0]), PAMRSmallInt(@State^.LspOld[0]), 10);
    State^.OldLogEn := State^.LogEn;
    if State^.ValidData <> 0 then
    begin
      TmpIntLength := State^.SinceLastSid;
      State^.SinceLastSid := 0;
      if FixedPoint.Sub(TmpIntLength, 32) > 0 then
        TmpIntLength := 32;
      if FixedPoint.Sub(TmpIntLength, 2) >= 0 then
        State^.TrueSidPeriodInv := FixedPoint.DivS((1 shl 10), FixedPoint.ShiftLeft(TmpIntLength, 10))
      else
        State^.TrueSidPeriodInv := 1 shl 14;
      AmrInitDPlsf3(LsfState, Parm[0]);
      AmrDPlsf3(LsfState, MRDTX, 0, PAMRSmallInt(@Parm[1]), PAMRSmallInt(@State^.Lsp[0]));
      ZeroSamples(PAMRSmallInt(@LsfState^.PastRQ[0]), 10);
      LogEnIndex := Parm[4];
      State^.LogEn := FixedPoint.ShiftLeft(LogEnIndex, (11 - 2));
      State^.LogEn := FixedPoint.Sub(State^.LogEn, (2560 * 2));
      if LogEnIndex = 0 then
        State^.LogEn := SmallInt($8000);
      if (State^.DataUpdated = 0) or (FixedPoint.Sub(State^.DtxGlobalState, SPEECH) = 0) then
      begin
        CopySamples(PAMRSmallInt(@State^.Lsp[0]), PAMRSmallInt(@State^.LspOld[0]), 10);
        State^.OldLogEn := State^.LogEn;
      end;
    end;
    MaPredInit := FixedPoint.Sub(FixedPoint.ShiftRight(State^.LogEn, 1), 9000);
    if MaPredInit > 0 then
      MaPredInit := 0;
    if FixedPoint.Sub(MaPredInit, (-14436)) < 0 then
      MaPredInit := -14436;
    PredState^.PastQuaEn[0] := MaPredInit;
    PredState^.PastQuaEn[1] := MaPredInit;
    PredState^.PastQuaEn[2] := MaPredInit;
    PredState^.PastQuaEn[3] := MaPredInit;
    MaPredInit := FixedPoint.Mult(5443, MaPredInit);
    PredState^.PastQuaEnMR122[0] := MaPredInit;
    PredState^.PastQuaEnMR122[1] := MaPredInit;
    PredState^.PastQuaEnMR122[2] := MaPredInit;
    PredState^.PastQuaEnMR122[3] := MaPredInit;
  end;
  State^.LogEnAdjust := FixedPoint.Add(FixedPoint.Mult(State^.LogEnAdjust, 29491),
    FixedPoint.ShiftRight(FixedPoint.Mult(FixedPoint.ShiftLeft(DtxDecDtxLogEnAdjust[Mode], 5), 3277), 5));
  IntFac := FixedPoint.ShiftLeft(FixedPoint.Add(1, State^.SinceLastSid), 10);
  IntFac := FixedPoint.Mult(IntFac, State^.TrueSidPeriodInv);
  if FixedPoint.Sub(IntFac, 1024) > 0 then
    IntFac := 1024;
  IntFac := FixedPoint.ShiftLeft(IntFac, 4);
  LLogEnInt := FixedPoint.LMult(IntFac, State^.LogEn);
  I := 0;
  while I < 10 do
  begin
    LspInt[I] := FixedPoint.Mult(IntFac, State^.Lsp[I]);
    Inc(I);
  end;
  IntFac := FixedPoint.Sub(16384, IntFac);
  LLogEnInt := FixedPoint.LMac(LLogEnInt, IntFac, State^.OldLogEn);
  I := 0;
  while I < 10 do
  begin
    LspInt[I] := FixedPoint.Add(LspInt[I], FixedPoint.Mult(IntFac, State^.LspOld[I]));
    LspInt[I] := FixedPoint.ShiftLeft(LspInt[I], 1);
    Inc(I);
  end;
  LsfVariabFactor := FixedPoint.Sub(State^.LogPgMean, 2457);
  LsfVariabFactor := FixedPoint.Sub(4096, FixedPoint.Mult(LsfVariabFactor, 9830));
  if FixedPoint.Sub(LsfVariabFactor, 4096) > 0 then
    LsfVariabFactor := 4096;
  if LsfVariabFactor < 0 then
    LsfVariabFactor := 0;
  LsfVariabFactor := FixedPoint.ShiftLeft(LsfVariabFactor, 3);
  LsfVariabIndex := AmrPseudonoise(PAMRInteger(@State^.LPnSeedRx), 3);
  AmrLspLsf(PAMRSmallInt(@LspInt[0]), PAMRSmallInt(@LsfInt[0]), 10);
  CopySamples(PAMRSmallInt(@LsfInt[0]), PAMRSmallInt(@LsfIntVariab[0]), 10);
  I := 0;
  while I < 10 do
  begin
    LsfIntVariab[I] := FixedPoint.Add(LsfIntVariab[I],
        FixedPoint.Mult(LsfVariabFactor, State^.LsfHistMean[I + (LsfVariabIndex * 10)]));
    Inc(I);
  end;
  AmrReorderLsf(PAMRSmallInt(@LsfInt[0]), 205, 10);
  AmrReorderLsf(PAMRSmallInt(@LsfIntVariab[0]), 205, 10);
  CopySamples(PAMRSmallInt(@LsfInt[0]), PAMRSmallInt(@LsfState^.PastLsfQ[0]), 10);
  AmrLsfLsp(PAMRSmallInt(@LsfInt[0]), PAMRSmallInt(@LspInt[0]), 10);
  AmrLsfLsp(PAMRSmallInt(@LsfIntVariab[0]), PAMRSmallInt(@LspIntVariab[0]), 10);
  AmrLspAz(PAMRSmallInt(@LspInt[0]), PAMRSmallInt(@Acoeff[0]));
  AmrLspAz(PAMRSmallInt(@LspIntVariab[0]), PAMRSmallInt(@AcoeffVariab[0]));
  CopySamples(PAMRSmallInt(@Acoeff[0]), PAMRSmallInt(@AT[0]), (10 + 1));
  CopySamples(PAMRSmallInt(@Acoeff[0]), PAMRSmallInt(@AT[10 + 1]), (10 + 1));
  CopySamples(PAMRSmallInt(@Acoeff[0]), PAMRSmallInt(@AT[2 * (10 + 1)]), (10 + 1));
  CopySamples(PAMRSmallInt(@Acoeff[0]), PAMRSmallInt(@AT[3 * (10 + 1)]), (10 + 1));
  AmrARefl(PAMRSmallInt(@Acoeff[1]), PAMRSmallInt(@Refl[0]));
  PredErr := SmallInt($7FFF);
  I := 0;
  while I < 10 do
  begin
    PredErr := FixedPoint.Mult(PredErr, FixedPoint.Sub(SmallInt($7FFF), FixedPoint.Mult(Refl[I], Refl[I])));
    Inc(I);
  end;
  FixedPoint.Log2(AmrLDepositL(PredErr), PAMRSmallInt(@LogPgE), PAMRSmallInt(@LogPgM));
  LogPg := FixedPoint.ShiftLeft(FixedPoint.Sub(LogPgE, 15), 12);
  LogPg := FixedPoint.ShiftRight(FixedPoint.Sub(0, FixedPoint.Add(LogPg, FixedPoint.ShiftRight(LogPgM, (15 - 12)))), 1);
  State^.LogPgMean := FixedPoint.Add(FixedPoint.Mult(29491, State^.LogPgMean), FixedPoint.Mult(3277, LogPg));
  LLogEnInt := FixedPoint.LShr(LLogEnInt, 10);
  LLogEnInt := FixedPoint.LAdd(LLogEnInt, (4 * 65536));
  LLogEnInt := FixedPoint.LSub(LLogEnInt, FixedPoint.LShl(AmrLDepositL(LogPg), 4));
  LLogEnInt := FixedPoint.LAdd(LLogEnInt, FixedPoint.LShl(AmrLDepositL(State^.LogEnAdjust), 5));
  LogEnIntE := AmrExtractH(LLogEnInt);
  LogEnIntM := AmrExtractL(FixedPoint.LShr(FixedPoint.LSub(LLogEnInt, AmrLDepositH(LogEnIntE)), 1));
  Level := AmrExtractL(FixedPoint.Pow2(LogEnIntE, LogEnIntM));
  I := 0;
  while I < 4 do
  begin
    AmrBuildCNCode(PAMRInteger(@State^.LPnSeedRx), PAMRSmallInt(@Ex[0]));
    J := 0;
    while J < 40 do
    begin
      Ex[J] := FixedPoint.Mult(Level, Ex[J]);
      Inc(J);
    end;
    AmrSynFilt(PAMRSmallInt(@AcoeffVariab[0]), PAMRSmallInt(@Ex[0]), PAMRSmallInt(@Synth[I * 40]), 40, MemSyn, 1);
    Inc(I);
  end;
  AverState^.HangVar := 20;
  AverState^.HangCount := 0;
  if FixedPoint.Sub(NewState, DtxMute) = 0 then
  begin
    TmpIntLength := State^.SinceLastSid;
    if FixedPoint.Sub(TmpIntLength, 32) > 0 then
      TmpIntLength := 32;
    if TmpIntLength <= 0 then
      TmpIntLength := 8;
    State^.TrueSidPeriodInv := FixedPoint.DivS((1 shl 10), FixedPoint.ShiftLeft(TmpIntLength, 10));
    State^.SinceLastSid := 0;
    CopySamples(PAMRSmallInt(@State^.Lsp[0]), PAMRSmallInt(@State^.LspOld[0]), 10);
    State^.OldLogEn := State^.LogEn;
    State^.LogEn := FixedPoint.Sub(State^.LogEn, 256);
  end;
  if (State^.SidFrame <> 0) and
    ((State^.ValidData <> 0) or ((State^.ValidData = 0) and (State^.DtxHangoverAdded <> 0))) then
  begin
    State^.SinceLastSid := 0;
    State^.DataUpdated := 1;
  end;
  Result := 0;
end;

procedure AmrLspAvg(State: PAMRlspAvgState; Lsp: PAMRSmallInt);
var
  I: SmallInt;
  LTmp: Integer;
begin
  for I := 0 to 9 do
  begin
    LTmp := AmrLDepositH(State^.LspMeanSave[I]);
    LTmp := FixedPoint.LMsu(LTmp, 5243, State^.LspMeanSave[I]);
    LTmp := FixedPoint.LMac(LTmp, 5243, Lsp[I]);
    State^.LspMeanSave[I] := FixedPoint.Round(LTmp);
  end;
end;

procedure AmrBuildCNParam(Seed: PAMRSmallInt; NParam: SmallInt; ParamSizeTable, Parm: PAMRSmallInt);
var
  I: SmallInt;
  P: PAMRSmallInt;
begin
  Seed^ := AmrExtractL(FixedPoint.LAdd(FixedPoint.LShr(FixedPoint.LMult(Seed^, 31821), 1), 13849));
  P := PAMRSmallInt(@BCnCodWindow20040[Seed^ and $7F]);
  I := 0;
  while I < NParam do
  begin
    Parm[I] := P^ and (not ($FFFF shl ParamSizeTable[I]));
    Inc(P);
    Inc(I);
  end;
end;

