procedure DecompressPulsePositions(MSBs, LSBs, Index1, Index2, Index3: SmallInt; PosIndx: PAMRSmallInt);
var
  Ia: SmallInt;
  Ib: SmallInt;
  Ic: SmallInt;
begin
  if FixedPoint.Sub(MSBs, 124) > 0 then
    MSBs := 124;
  Ia := FixedPoint.Mult(MSBs, 1311);
  Ia := FixedPoint.Sub(MSBs, AmrExtractL(FixedPoint.LShr(FixedPoint.LMult(Ia, 25), 1)));
  Ib := FixedPoint.ShiftLeft(FixedPoint.Sub(Ia, AmrExtractL(FixedPoint.LShr(FixedPoint.LMult(FixedPoint.Mult(Ia, 6554), 5), 1))), 1);
  Ic := FixedPoint.ShiftLeft(FixedPoint.ShiftRight(LSBs, 2), 2);
  Ic := FixedPoint.Sub(LSBs, Ic);
  PosIndx[Index1] := FixedPoint.Add(Ib, (Ic and 1));
  Ib := FixedPoint.ShiftLeft(FixedPoint.Mult(Ia, 6554), 1);
  PosIndx[Index2] := FixedPoint.Add(Ib, FixedPoint.ShiftRight(Ic, 1));
  PosIndx[Index3] := FixedPoint.Add(FixedPoint.ShiftLeft(FixedPoint.Mult(MSBs, 1311), 1), FixedPoint.ShiftRight(LSBs, 2));
end;

procedure DecompressPulseCode(Indx, SignIndx, PosIndx: PAMRSmallInt);
var
  I: SmallInt;
  Ia: SmallInt;
  Ib: SmallInt;
  MSBs: SmallInt;
  LSBs: SmallInt;
  MSBs024: SmallInt;
begin
  for I := 0 to 3 do
    SignIndx[I] := Indx[I];
  MSBs := FixedPoint.ShiftRight(Indx[4], 3);
  LSBs := Indx[4] and 7;
  DecompressPulsePositions(MSBs, LSBs, 0, 4, 1, PosIndx);
  MSBs := FixedPoint.ShiftRight(Indx[4 + 1], 3);
  LSBs := Indx[4 + 1] and 7;
  DecompressPulsePositions(MSBs, LSBs, 2, 6, 5, PosIndx);
  MSBs := FixedPoint.ShiftRight(Indx[4 + 2], 2);
  LSBs := Indx[4 + 2] and 3;
  MSBs024 := FixedPoint.ShiftRight(FixedPoint.Add(AmrExtractL(FixedPoint.LShr(FixedPoint.LMult(MSBs, 25), 1)), 12), 5);
  Ia := FixedPoint.Mult(MSBs024, 6554) and 1;
  Ib := FixedPoint.Sub(MSBs024, AmrExtractL(FixedPoint.LShr(FixedPoint.LMult(FixedPoint.Mult(MSBs024, 6554), 5), 1)));
  if FixedPoint.Sub(Ia, 1) = 0 then
    Ib := FixedPoint.Sub(4, Ib);
  PosIndx[3] := FixedPoint.Add(FixedPoint.ShiftLeft(Ib, 1), (LSBs and 1));
  Ia := FixedPoint.ShiftLeft(FixedPoint.Mult(MSBs024, 6554), 1);
  PosIndx[7] := FixedPoint.Add(Ia, FixedPoint.ShiftRight(LSBs, 1));
end;

