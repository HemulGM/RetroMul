  LTmp := FixedPoint.LShr(LTmp, FixedPoint.Sub(10, Exp));
  GainCod^ := AmrExtractH(LTmp);
  AmrGcPredUpdate(PredState, QuaEnerMR122, QuaEner);
end;

procedure AmrGcPredAverageLimited(State: PAMRgcPredState; EnerAvgMR122, EnerAvg: PAMRSmallInt);
var
  AvPredEn: SmallInt;
  I: SmallInt;
begin
  AvPredEn := 0;
  I := 0;
  while I < 4 do
  begin
    AvPredEn := FixedPoint.Add(AvPredEn, State^.PastQuaEnMR122[I]);
    Inc(I);
  end;
  AvPredEn := FixedPoint.Mult(AvPredEn, 8192);
  if FixedPoint.Sub(AvPredEn, (-2381)) < 0 then
    AvPredEn := -2381;
  EnerAvgMR122^ := AvPredEn;
  AvPredEn := 0;
  I := 0;
  while I < 4 do
  begin
    AvPredEn := FixedPoint.Add(AvPredEn, State^.PastQuaEn[I]);
    Inc(I);
  end;
  AvPredEn := FixedPoint.Mult(AvPredEn, 8192);
  if FixedPoint.Sub(AvPredEn, (-14336)) < 0 then
    AvPredEn := -14336;
  EnerAvg^ := AvPredEn;
end;

procedure AmrEcGainCode(State: PAMRecGainCodeState; PredState: PAMRgcPredState; ArgState: SmallInt; GainCode: PAMRSmallInt);
const
  Cdown: array[0..6] of SmallInt = (
    32767, 32112, 32112, 32112, 32112, 32112, 22937
  );
var
  Tmp: SmallInt;
  QuaEnerMR122: SmallInt;
  QuaEner: SmallInt;
begin
  Tmp := AmrGmedN(PAMRSmallInt(@State^.Gbuf[0]), 5);
  if FixedPoint.Sub(Tmp, State^.PastGainCode) > 0 then
    Tmp := State^.PastGainCode;
  Tmp := FixedPoint.Mult(Tmp, Cdown[ArgState]);
  GainCode^ := Tmp;
  AmrGcPredAverageLimited(PredState, PAMRSmallInt(@QuaEnerMR122), PAMRSmallInt(@QuaEner));
  AmrGcPredUpdate(PredState, QuaEnerMR122, QuaEner);
end;

procedure AmrEcGainCodeUpdate(State: PAMRecGainCodeState; Bfi, PrevBf: SmallInt; GainCode: PAMRSmallInt);
var
  I: SmallInt;
begin
  if Bfi = 0 then
  begin
    if PrevBf <> 0 then
    begin
      if FixedPoint.Sub(GainCode^, State^.PrevGc) > 0 then
        GainCode^ := State^.PrevGc;
    end;
    State^.PrevGc := GainCode^;
  end;
  State^.PastGainCode := GainCode^;
  for I := 1 to 4 do
    State^.Gbuf[I - 1] := State^.Gbuf[I];
  State^.Gbuf[4] := GainCode^;
end;

procedure AmrDGainCode(PredState: PAMRgcPredState; Mode: Integer; ArgIndex: SmallInt; Code, GainCode: PAMRSmallInt);
var
  Gcode0: SmallInt;
  Exp: SmallInt;
  Frac: SmallInt;
  P: PAMRSmallInt;
  QuaEnerMR122: SmallInt;
  QuaEner: SmallInt;
  ExpInnEn: SmallInt;
  FracInnEn: SmallInt;
  LTmp: Integer;
begin
  AmrGcPred(PredState, Mode, Code, PAMRSmallInt(@Exp), PAMRSmallInt(@Frac), PAMRSmallInt(@ExpInnEn),
    PAMRSmallInt(@FracInnEn));
  P := PAMRSmallInt(@DGainCQuaGainCode[FixedPoint.Add(FixedPoint.Add(ArgIndex, ArgIndex), ArgIndex)]);
  if FixedPoint.Sub(Mode, MR122) = 0 then
  begin
    Gcode0 := AmrExtractL(FixedPoint.Pow2(Exp, Frac));
    Gcode0 := FixedPoint.ShiftLeft(Gcode0, 4);
    GainCode^ := FixedPoint.ShiftLeft(FixedPoint.Mult(Gcode0, P^), 1);
    Inc(P);
  end
  else
  begin
    Gcode0 := AmrExtractL(FixedPoint.Pow2(14, Frac));
    LTmp := FixedPoint.LMult(P^, Gcode0);
    Inc(P);
    LTmp := FixedPoint.LShr(LTmp, FixedPoint.Sub(9, Exp));
    GainCode^ := AmrExtractH(LTmp);
  end;
  QuaEnerMR122 := P^;
  Inc(P);
  QuaEner := P^;
  AmrGcPredUpdate(PredState, QuaEnerMR122, QuaEner);
end;

procedure AmrIntLsf(LsfOld, LsfNew: PAMRSmallInt; ISubfr: SmallInt; LsfOut: PAMRSmallInt);
var
  I: SmallInt;
begin
  if ISubfr = 0 then
  begin
    I := 0;
    while I < 10 do
    begin
      LsfOut[I] := FixedPoint.Add(FixedPoint.Sub(LsfOld[I], FixedPoint.ShiftRight(LsfOld[I], 2)), FixedPoint.ShiftRight(LsfNew[I], 2));
      Inc(I);
    end;
  end
  else
  begin
    if FixedPoint.Sub(ISubfr, 40) = 0 then
    begin
      I := 0;
      while I < 10 do
      begin
        LsfOut[I] := FixedPoint.Add(FixedPoint.ShiftRight(LsfOld[I], 1), FixedPoint.ShiftRight(LsfNew[I], 1));
        Inc(I);
      end;
    end
    else
    begin
      if FixedPoint.Sub(ISubfr, 80) = 0 then
      begin
        I := 0;
        while I < 10 do
        begin
          LsfOut[I] := FixedPoint.Add(FixedPoint.ShiftRight(LsfOld[I], 2), FixedPoint.Sub(LsfNew[I], FixedPoint.ShiftRight(LsfNew[I], 2)));
          Inc(I);
        end;
      end
      else
      begin
        if FixedPoint.Sub(ISubfr, 120) = 0 then
        begin
          I := 0;
          while I < 10 do
          begin
            LsfOut[I] := LsfNew[I];
            Inc(I);
          end;
        end;
      end;
    end;
  end;
end;

function AmrCbGainAverage(State: PAMRCbGainAverageState; Mode: Integer; GainCode: SmallInt; Lsp, LspAver: PAMRSmallInt; Bfi, PrevBf, Pdfi, PrevPdf, InBackgroundNoise, VoicedHangover: SmallInt): SmallInt;
var
  I: SmallInt;
  CbGainMix: SmallInt;
  Diff: SmallInt;
  TmpDiff: SmallInt;
  BgMix: SmallInt;
  CbGainMean: SmallInt;
  LSum: Integer;
  Tmp: array[0..9] of SmallInt;
  Tmp1: SmallInt;
  Tmp2: SmallInt;
  Shift1: SmallInt;
  Shift2: SmallInt;
  Shift: SmallInt;
begin
  CbGainMix := GainCode;
  I := 0;
  while I < (7 - 1) do
  begin
    State^.CbGainHistory[I] := State^.CbGainHistory[I + 1];
    Inc(I);
  end;
  State^.CbGainHistory[7 - 1] := GainCode;
  I := 0;
  while I < 10 do
  begin
    Tmp1 := AmrAbsS(FixedPoint.Sub(LspAver[I], Lsp[I]));
    Shift1 := FixedPoint.Sub(AmrNormS(Tmp1), 1);
    Tmp1 := FixedPoint.ShiftLeft(Tmp1, Shift1);
    Shift2 := AmrNormS(LspAver[I]);
    Tmp2 := FixedPoint.ShiftLeft(LspAver[I], Shift2);
    Tmp[I] := FixedPoint.DivS(Tmp1, Tmp2);
    Shift := FixedPoint.Sub(FixedPoint.Add(2, Shift1), Shift2);
    if Shift >= 0 then
      Tmp[I] := FixedPoint.ShiftRight(Tmp[I], Shift)
    else
      Tmp[I] := FixedPoint.ShiftLeft(Tmp[I], AmrNegate(Shift));
    Inc(I);
  end;
  Diff := Tmp[0];
  I := 1;
  while I < 10 do
  begin
    Diff := FixedPoint.Add(Diff, Tmp[I]);
    Inc(I);
  end;
  if FixedPoint.Sub(Diff, 5325) > 0 then
    State^.HangVar := FixedPoint.Add(State^.HangVar, 1)
  else
    State^.HangVar := 0;
  if FixedPoint.Sub(State^.HangVar, 10) > 0 then
    State^.HangCount := 0;
  if (FixedPoint.Sub(Mode, MR67) <= 0) or (FixedPoint.Sub(Mode, MR102) = 0) then
  begin
    if (((Pdfi <> 0) and (PrevPdf <> 0)) or (Bfi <> 0) or (PrevBf <> 0)) and (FixedPoint.Sub(VoicedHangover, 1) > 0) and
      (InBackgroundNoise <> 0) and
      ((FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0)) then
    begin
      TmpDiff := FixedPoint.Sub(Diff, 4506);
      if TmpDiff > 0 then
        Tmp1 := TmpDiff
      else
        Tmp1 := 0;
      if FixedPoint.Sub(2048, Tmp1) < 0 then
        BgMix := 8192
      else
        BgMix := FixedPoint.ShiftLeft(Tmp1, 2);
    end
    else
    begin
      TmpDiff := FixedPoint.Sub(Diff, 3277);
      if TmpDiff > 0 then
        Tmp1 := TmpDiff
      else
        Tmp1 := 0;
      if FixedPoint.Sub(2048, Tmp1) < 0 then
        BgMix := 8192
      else
        BgMix := FixedPoint.ShiftLeft(Tmp1, 2);
    end;
    if (FixedPoint.Sub(State^.HangCount, 40) < 0) or (FixedPoint.Sub(Diff, 5325) > 0) then
      BgMix := 8192;
    LSum := FixedPoint.LMult(6554, State^.CbGainHistory[2]);
    I := 3;
    while I < 7 do
    begin
      LSum := FixedPoint.LMac(LSum, 6554, State^.CbGainHistory[I]);
      Inc(I);
    end;
    CbGainMean := FixedPoint.Round(LSum);
    if ((Bfi <> 0) or (PrevBf <> 0)) and (InBackgroundNoise <> 0) and
      ((FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0)) then
    begin
      LSum := FixedPoint.LMult(4681, State^.CbGainHistory[0]);
      I := 1;
      while I < 7 do
      begin
        LSum := FixedPoint.LMac(LSum, 4681, State^.CbGainHistory[I]);
        Inc(I);
      end;
      CbGainMean := FixedPoint.Round(LSum);
    end;
    LSum := FixedPoint.LMult(BgMix, CbGainMix);
    LSum := FixedPoint.LMac(LSum, 8192, CbGainMean);
    LSum := FixedPoint.LMsu(LSum, BgMix, CbGainMean);
    CbGainMix := FixedPoint.Round(FixedPoint.LShl(LSum, 2));
  end;
  State^.HangCount := FixedPoint.Add(State^.HangCount, 1);
  Result := CbGainMix;
end;

procedure AmrPhDispRelease(State: PAMRphDispState);
begin
  State^.LockFull := 0;
end;

procedure AmrPhDispLock(State: PAMRphDispState);
begin
  State^.LockFull := 1;
end;

procedure AmrPhDisp(State: PAMRphDispState; Mode: Integer; X: PAMRSmallInt; CbGain, LtpGain: SmallInt; Inno: PAMRSmallInt; PitchFac, TmpShift: SmallInt);
var
  I: SmallInt;
  I1: SmallInt;
  Tmp1: SmallInt;
  LTemp: Integer;
  ImpNr: SmallInt;
  InnoSav: array[0..39] of SmallInt;
  PsPoss: array[0..39] of SmallInt;
  J: SmallInt;
  Nze: SmallInt;
  NPulse: SmallInt;
  Ppos: SmallInt;
  PhImp: PAMRSmallInt;
begin
  I := 5 - 1;
  while I > 0 do
  begin
    State^.GainMem[I] := State^.GainMem[I - 1];
    Dec(I);
  end;
  State^.GainMem[0] := LtpGain;
  if FixedPoint.Sub(LtpGain, 14746) < 0 then
  begin
    if FixedPoint.Sub(LtpGain, 9830) > 0 then
      ImpNr := 1
    else
      ImpNr := 0;
  end
  else
    ImpNr := 2;
  Tmp1 := FixedPoint.Round(FixedPoint.LShl(FixedPoint.LMult(State^.PrevCbGain, 16384), 2));
  if FixedPoint.Sub(CbGain, Tmp1) > 0 then
    State^.Onset := 2
  else
  begin
    if State^.Onset > 0 then
      State^.Onset := FixedPoint.Sub(State^.Onset, 1);
  end;
  if State^.Onset = 0 then
  begin
    I1 := 0;
    I := 0;
    while I < 5 do
    begin
      if FixedPoint.Sub(State^.GainMem[I], 9830) < 0 then
        I1 := FixedPoint.Add(I1, 1);
      Inc(I);
    end;
    if FixedPoint.Sub(I1, 2) > 0 then
      ImpNr := 0;
  end;
  if (FixedPoint.Sub(ImpNr, FixedPoint.Add(State^.PrevState, 1)) > 0) and (State^.Onset = 0) then
    ImpNr := FixedPoint.Sub(ImpNr, 1);
  if (FixedPoint.Sub(ImpNr, 2) < 0) and (State^.Onset > 0) then
    ImpNr := FixedPoint.Add(ImpNr, 1);
  if FixedPoint.Sub(CbGain, 10) < 0 then
    ImpNr := 2;
  if FixedPoint.Sub(State^.LockFull, 1) = 0 then
    ImpNr := 0;
  State^.PrevState := ImpNr;
  State^.PrevCbGain := CbGain;
  if (FixedPoint.Sub(Mode, MR122) <> 0) and (FixedPoint.Sub(Mode, MR102) <> 0) and (FixedPoint.Sub(Mode, MR74) <> 0) and
    (FixedPoint.Sub(ImpNr, 2) < 0) then
  begin
    Nze := 0;
    I := 0;
    while I < 40 do
    begin
      if Inno[I] <> 0 then
      begin
        PsPoss[Nze] := I;
        Nze := FixedPoint.Add(Nze, 1);
      end;
      InnoSav[I] := Inno[I];
      Inno[I] := 0;
      Inc(I);
    end;
    if FixedPoint.Sub(Mode, MR795) = 0 then
    begin
      if ImpNr = 0 then
        PhImp := PAMRSmallInt(@PhDispPhImpLowMR795[0])
      else
        PhImp := PAMRSmallInt(@PhDispPhImpMidMR795[0]);
    end
    else
    begin
      if ImpNr = 0 then
        PhImp := PAMRSmallInt(@PhDispPhImpLow[0])
      else
        PhImp := PAMRSmallInt(@PhDispPhImpMid[0]);
    end;
    NPulse := 0;
    while NPulse < Nze do
    begin
      Ppos := PsPoss[NPulse];
      J := 0;
      I := Ppos;
      while I < 40 do
      begin
        Tmp1 := FixedPoint.Mult(InnoSav[Ppos], PhImp[J]);
        Inc(J);
        Inno[I] := FixedPoint.Add(Inno[I], Tmp1);
        Inc(I);
      end;
      I := 0;
      while I < Ppos do
      begin
        Tmp1 := FixedPoint.Mult(InnoSav[Ppos], PhImp[J]);
        Inc(J);
        Inno[I] := FixedPoint.Add(Inno[I], Tmp1);
        Inc(I);
      end;
      Inc(NPulse);
    end;
  end;
  I := 0;
  while I < 40 do
  begin
    LTemp := FixedPoint.LMult(X[I], PitchFac);
    LTemp := FixedPoint.LMac(LTemp, Inno[I], CbGain);
    LTemp := FixedPoint.LShl(LTemp, TmpShift);
    X[I] := FixedPoint.Round(LTemp);
    Inc(I);
  end;
end;

function AmrSqrtLExp(LX: Integer; Exp: PAMRSmallInt): Integer;
var
  E: SmallInt;
  I: SmallInt;
  A: SmallInt;
  Tmp: SmallInt;
  LY: Integer;
begin
  if LX <= Integer(0) then
  begin
    Exp^ := 0;
    Exit(Integer(0));
  end;
  E := AmrNormL(LX) and $FFFE;
  LX := FixedPoint.LShl(LX, E);
  Exp^ := E;
  LX := FixedPoint.LShr(LX, 9);
  I := AmrExtractH(LX);
  LX := FixedPoint.LShr(LX, 1);
  A := AmrExtractL(LX);
  A := A and SmallInt($7FFF);
  I := FixedPoint.Sub(I, 16);
  LY := AmrLDepositH(SqrtLTable[I]);
  Tmp := FixedPoint.Sub(SqrtLTable[I], SqrtLTable[I + 1]);
  LY := FixedPoint.LMsu(LY, Tmp, A);
  Result := LY;
end;

function AmrExCtrl(Excitation: PAMRSmallInt; ExcEnergy: SmallInt; ExEnergyHist: PAMRSmallInt; VoicedHangover, PrevBFI, CarefulFlag: SmallInt): SmallInt;
var
  I: SmallInt;
  Exp: SmallInt;
  TestEnergy: SmallInt;
  ScaleFactor: SmallInt;
  AvgEnergy: SmallInt;
  PrevEnergy: SmallInt;
  T0: Integer;
begin
  AvgEnergy := AmrGmedN(ExEnergyHist, 9);
  PrevEnergy := FixedPoint.ShiftRight(FixedPoint.Add(ExEnergyHist[7], ExEnergyHist[8]), 1);
  if FixedPoint.Sub(ExEnergyHist[8], PrevEnergy) < 0 then
    PrevEnergy := ExEnergyHist[8];
  if (FixedPoint.Sub(ExcEnergy, AvgEnergy) < 0) and (FixedPoint.Sub(ExcEnergy, 5) > 0) then
  begin
    TestEnergy := FixedPoint.ShiftLeft(PrevEnergy, 2);
    if (FixedPoint.Sub(VoicedHangover, 7) < 0) or (PrevBFI <> 0) then
      TestEnergy := FixedPoint.Sub(TestEnergy, PrevEnergy);
    if FixedPoint.Sub(AvgEnergy, TestEnergy) > 0 then
      AvgEnergy := TestEnergy;
    Exp := AmrNormS(ExcEnergy);
    ExcEnergy := FixedPoint.ShiftLeft(ExcEnergy, Exp);
    ExcEnergy := FixedPoint.DivS(SmallInt(16383), ExcEnergy);
    T0 := FixedPoint.LMult(AvgEnergy, ExcEnergy);
    T0 := FixedPoint.LShr(T0, FixedPoint.Sub(20, Exp));
    if FixedPoint.LSub(T0, 32767) > 0 then
      T0 := 32767;
    ScaleFactor := AmrExtractL(T0);
    if (CarefulFlag <> 0) and (FixedPoint.Sub(ScaleFactor, 3072) > 0) then
      ScaleFactor := 3072;
    for I := 0 to 39 do
    begin
      T0 := FixedPoint.LMult(ScaleFactor, Excitation[I]);
      T0 := FixedPoint.LShr(T0, 11);
      Excitation[I] := AmrExtractL(T0);
    end;
  end;
  Result := 0;
end;

function MeasureEnergyLegacy(Input: PAMRSmallInt; LTrm: SmallInt): Integer;
var
  S: Integer;
  I: SmallInt;
  Temp: SmallInt;
begin
  Temp := FixedPoint.ShiftRight(Input[0], 2);
  S := FixedPoint.LMult(Temp, Temp);
  I := 1;
  while I < LTrm do
  begin
    Temp := FixedPoint.ShiftRight(Input[I], 2);
    S := FixedPoint.LMac(S, Temp, Temp);
    Inc(I);
  end;
  Result := S;
end;

function MeasureEnergy(Input: PAMRSmallInt; LTrm: SmallInt): Integer;
var
  S: Integer;
  I: SmallInt;
  OvSave: Integer;
begin
  OvSave := FixedPoint.Overflow;
  S := FixedPoint.LMult(Input[0], Input[0]);
  I := 1;
  while I < LTrm do
  begin
    S := FixedPoint.LMac(S, Input[I], Input[I]);
    Inc(I);
  end;
  if FixedPoint.LSub(S, Integer($7FFFFFFF)) = 0 then
  begin
    FixedPoint.Overflow := OvSave;
    S := MeasureEnergyLegacy(Input, LTrm);
  end
  else
    S := FixedPoint.LShr(S, 4);
  Result := S;
end;

function AmrInvSqrt(LX: Integer): Integer;
var
  Exp: SmallInt;
  I: SmallInt;
  A: SmallInt;
  Tmp: SmallInt;
  LY: Integer;
begin
  if LX <= Integer(0) then
    Exit(Integer($3FFFFFFF));
  Exp := AmrNormL(LX);
  LX := FixedPoint.LShl(LX, Exp);
  Exp := FixedPoint.Sub(30, Exp);
  if (Exp and 1) = 0 then
    LX := FixedPoint.LShr(LX, 1);
  Exp := FixedPoint.ShiftRight(Exp, 1);
  Exp := FixedPoint.Add(Exp, 1);
  LX := FixedPoint.LShr(LX, 9);
  I := AmrExtractH(LX);
  LX := FixedPoint.LShr(LX, 1);
  A := AmrExtractL(LX);
  A := A and SmallInt($7FFF);
  I := FixedPoint.Sub(I, 16);
  LY := AmrLDepositH(InvSqrtTable[I]);
  Tmp := FixedPoint.Sub(InvSqrtTable[I], InvSqrtTable[I + 1]);
  LY := FixedPoint.LMsu(LY, Tmp, A);
  LY := FixedPoint.LShr(LY, Exp);
  Result := LY;
end;

procedure AmrAgc2(SigIn, SigOut: PAMRSmallInt; LTrm: SmallInt);
var
  I: SmallInt;
  Exp: SmallInt;
  GainIn: SmallInt;
  GainOut: SmallInt;
  G0: SmallInt;
  S: Integer;
begin
  S := MeasureEnergy(SigOut, LTrm);
  if S = 0 then
    Exit;
  Exp := FixedPoint.Sub(AmrNormL(S), 1);
  GainOut := FixedPoint.Round(FixedPoint.LShl(S, Exp));
  S := MeasureEnergy(SigIn, LTrm);
  if S = 0 then
    G0 := 0
  else
  begin
    I := AmrNormL(S);
    GainIn := FixedPoint.Round(FixedPoint.LShl(S, I));
    Exp := FixedPoint.Sub(Exp, I);
    S := AmrLDepositL(FixedPoint.DivS(GainOut, GainIn));
    S := FixedPoint.LShl(S, 7);
    S := FixedPoint.LShr(S, Exp);
    S := AmrInvSqrt(S);
    G0 := FixedPoint.Round(FixedPoint.LShl(S, 9));
  end;
  I := 0;
  while I < LTrm do
  begin
    SigOut[I] := AmrExtractH(FixedPoint.LShl(FixedPoint.LMult(SigOut[I], G0), 3));
    Inc(I);
  end;
end;

function AmrBgnScd(State: PAMRBgnScdState; LtpGainHist, Speech, VoicedHangover: PAMRSmallInt): SmallInt;
var
  I: SmallInt;
  PrevVoiced: SmallInt;
  InbgNoise: SmallInt;
  Temp: SmallInt;
  LtpLimit: SmallInt;
  FrameEnergyMin: SmallInt;
  CurrEnergy: SmallInt;
  NoiseFloor: SmallInt;
  MaxEnergy: SmallInt;
  MaxEnergyLastPart: SmallInt;
  S: Integer;
begin
  S := Integer(0);
  I := 0;
  while I < 160 do
  begin
    S := FixedPoint.LMac(S, Speech[I], Speech[I]);
    Inc(I);
  end;
  S := FixedPoint.LShl(S, 2);
  CurrEnergy := AmrExtractH(S);
  FrameEnergyMin := 32767;
  I := 0;
  while I < 60 do
  begin
    if FixedPoint.Sub(State^.FrameEnergyHist[I], FrameEnergyMin) < 0 then
      FrameEnergyMin := State^.FrameEnergyHist[I];
    Inc(I);
  end;
  NoiseFloor := FixedPoint.ShiftLeft(FrameEnergyMin, 4);
  MaxEnergy := State^.FrameEnergyHist[0];
  I := 1;
  while I < (60 - 4) do
  begin
    if FixedPoint.Sub(MaxEnergy, State^.FrameEnergyHist[I]) < 0 then
      MaxEnergy := State^.FrameEnergyHist[I];
    Inc(I);
  end;
  MaxEnergyLastPart := State^.FrameEnergyHist[(2 * 60) div 3];
  I := ((2 * 60) div 3) + 1;
  while I < 60 do
  begin
    if FixedPoint.Sub(MaxEnergyLastPart, State^.FrameEnergyHist[I]) < 0 then
      MaxEnergyLastPart := State^.FrameEnergyHist[I];
    Inc(I);
  end;
  InbgNoise := 0;
  if (FixedPoint.Sub(MaxEnergy, 20) > 0) and (FixedPoint.Sub(CurrEnergy, 17578) < 0) and (FixedPoint.Sub(CurrEnergy, 20) > 0) and
    ((FixedPoint.Sub(CurrEnergy, NoiseFloor) < 0) or (FixedPoint.Sub(MaxEnergyLastPart, 1953) < 0)) then
  begin
    if FixedPoint.Sub(FixedPoint.Add(State^.BgHangover, 1), 30) > 0 then
      State^.BgHangover := 30
    else
      State^.BgHangover := FixedPoint.Add(State^.BgHangover, 1);
  end
  else
    State^.BgHangover := 0;
  if FixedPoint.Sub(State^.BgHangover, 1) > 0 then
    InbgNoise := 1;
  I := 0;
  while I < (60 - 1) do
  begin
    State^.FrameEnergyHist[I] := State^.FrameEnergyHist[I + 1];
    Inc(I);
  end;
  State^.FrameEnergyHist[60 - 1] := CurrEnergy;
  LtpLimit := 13926;
  if FixedPoint.Sub(State^.BgHangover, 8) > 0 then
    LtpLimit := 15565;
  if FixedPoint.Sub(State^.BgHangover, 15) > 0 then
    LtpLimit := 16383;
  PrevVoiced := 0;
  if FixedPoint.Sub(AmrGmedN(PAMRSmallInt(@LtpGainHist[4]), 5), LtpLimit) > 0 then
    PrevVoiced := 1;
  if FixedPoint.Sub(State^.BgHangover, 20) > 0 then
  begin
    if FixedPoint.Sub(AmrGmedN(LtpGainHist, 9), LtpLimit) > 0 then
      PrevVoiced := 1
    else
      PrevVoiced := 0;
  end;
  if PrevVoiced <> 0 then
    VoicedHangover^ := 0
  else
  begin
    Temp := FixedPoint.Add(VoicedHangover^, 1);
    if FixedPoint.Sub(Temp, 10) > 0 then
      VoicedHangover^ := 10
    else
      VoicedHangover^ := Temp;
  end;
  Result := InbgNoise;
end;

procedure AmrDtxDecActivityUpdate(State: PAMRdtxDecState; Lsf, Frame: PAMRSmallInt);
var
  I: SmallInt;
  LFrameEn: Integer;
  LogEnE: SmallInt;
  LogEnM: SmallInt;
  LogEn: SmallInt;
begin
  State^.LsfHistPtr := FixedPoint.Add(State^.LsfHistPtr, 10);
  if FixedPoint.Sub(State^.LsfHistPtr, 80) = 0 then
    State^.LsfHistPtr := 0;
  CopySamples(Lsf, PAMRSmallInt(@State^.LsfHist[State^.LsfHistPtr]), 10);
  LFrameEn := 0;
  for I := 0 to 159 do
    LFrameEn := FixedPoint.LMac(LFrameEn, Frame[I], Frame[I]);
  FixedPoint.Log2(LFrameEn, PAMRSmallInt(@LogEnE), PAMRSmallInt(@LogEnM));
  LogEn := FixedPoint.ShiftLeft(LogEnE, 10);
  LogEn := FixedPoint.Add(LogEn, FixedPoint.ShiftRight(LogEnM, (15 - 10)));
  LogEn := FixedPoint.Sub(LogEn, (7497 + 1024));
  State^.LogEnHistPtr := FixedPoint.Add(State^.LogEnHistPtr, 1);
  if FixedPoint.Sub(State^.LogEnHistPtr, 8) = 0 then
    State^.LogEnHistPtr := 0;
  State^.LogEnHist[State^.LogEnHistPtr] := LogEn;
end;

function AmrDecoderAmr(ArgState: PAMRDecoderAmrState; Mode: Integer; Parm: PAMRSmallInt; FrameType: Integer; Synth, AT: PAMRSmallInt): Integer;
label
  Label_the_end;
var
  Az: PAMRSmallInt;
  LspNew: array[0..9] of SmallInt;
  LspMid: array[0..9] of SmallInt;
  PrevLsf: array[0..9] of SmallInt;
  LsfI: array[0..9] of SmallInt;
  Code: array[0..39] of SmallInt;
  Excp: array[0..39] of SmallInt;
  ExcEnhanced: array[0..39] of SmallInt;
  I: SmallInt;
  ISubfr: SmallInt;
  T0: SmallInt;
  T0Frac: SmallInt;
  IndexValue: SmallInt;
  IndexMr475: SmallInt;
  GainPit: SmallInt;
  GainCode: SmallInt;
  GainCodeMix: SmallInt;
  PitSharp: SmallInt;
  PitFlag: SmallInt;
  PitchFac: SmallInt;
  T0Min: SmallInt;
  T0Max: SmallInt;
  DeltaFrcLow: SmallInt;
  DeltaFrcRange: SmallInt;
  TmpShift: SmallInt;
  Temp: SmallInt;
  LTemp: Integer;
  Flag4: SmallInt;
  CarefulFlag: SmallInt;
  ExcEnergy: SmallInt;
  SubfrNr: SmallInt;
  EvenSubfr: SmallInt;
  Bfi: SmallInt;
  Pdfi: SmallInt;
  NewDTXState: Integer;
begin
  IndexMr475 := 0;
  Bfi := 0;
  Pdfi := 0;
  NewDTXState := AmrRxDtxHandler(ArgState^.DtxDecoderState, FrameType);
  if FixedPoint.Sub(NewDTXState, Speech) <> 0 then
  begin
    AmrDecoderAmrReset(ArgState, MRDTX);
    AmrDtxDec(ArgState^.DtxDecoderState, PAMRSmallInt(@ArgState^.MemSyn[0]), ArgState^.LsfState,
      ArgState^.PredState, ArgState^.CbGainAverState, NewDTXState, Mode, Parm, Synth, AT);
    AmrLsfLsp(PAMRSmallInt(@ArgState^.LsfState^.PastLsfQ[0]), PAMRSmallInt(@ArgState^.LspOld[0]), 10);
    AmrLspAvg(ArgState^.LspAvgSt, PAMRSmallInt(@ArgState^.LsfState^.PastLsfQ[0]));
    goto Label_the_end;
  end;
  if (FixedPoint.Sub(FrameType, RxSpeechBad) = 0) or (FixedPoint.Sub(FrameType, RxNoData) = 0) or
    (FixedPoint.Sub(FrameType, RxOnset) = 0) then
  begin
    Bfi := 1;
    if (FixedPoint.Sub(FrameType, RxNoData) = 0) or (FixedPoint.Sub(FrameType, RxOnset) = 0) then
    begin
      AmrBuildCNParam(PAMRSmallInt(@ArgState^.NodataSeed), DecAmrPrmno[Mode], DecAmrBitno[Mode], Parm);
    end;
  end
  else
  begin
    if FixedPoint.Sub(FrameType, RxSpeechDegraded) = 0 then
      Pdfi := 1;
  end;
  if Bfi <> 0 then
    ArgState^.State := FixedPoint.Add(ArgState^.State, 1)
  else
  begin
    if FixedPoint.Sub(ArgState^.State, 6) = 0 then
      ArgState^.State := 5
    else
      ArgState^.State := 0;
  end;
  if FixedPoint.Sub(ArgState^.State, 6) > 0 then
    ArgState^.State := 6;
  if FixedPoint.Sub(ArgState^.DtxDecoderState^.DtxGlobalState, DTX) = 0 then
  begin
    ArgState^.State := 5;
    ArgState^.PrevBf := 0;
  end
  else
  begin
    if Ord((FixedPoint.Sub(ArgState^.DtxDecoderState^.DtxGlobalState, DtxMute) = 0)) <> 0 then
    begin
      ArgState^.State := 5;
      ArgState^.PrevBf := 1;
    end;
  end;
  CopySamples(PAMRSmallInt(@ArgState^.LsfState^.PastLsfQ[0]), PAMRSmallInt(@PrevLsf[0]), 10);
  if FixedPoint.Sub(Mode, MR122) <> 0 then
  begin
    AmrDPlsf3(ArgState^.LsfState, Mode, Bfi, Parm, PAMRSmallInt(@LspNew[0]));
    AmrFwc;
    Parm := Parm + 3;
    AmrIntLpc1to3(PAMRSmallInt(@ArgState^.LspOld[0]), PAMRSmallInt(@LspNew[0]), AT);
  end
  else
  begin
    AmrDPlsf5(ArgState^.LsfState, Bfi, Parm, PAMRSmallInt(@LspMid[0]), PAMRSmallInt(@LspNew[0]));
    AmrFwc;
    Parm := Parm + 5;
    AmrIntLpc1and3(PAMRSmallInt(@ArgState^.LspOld[0]), PAMRSmallInt(@LspMid[0]), PAMRSmallInt(@LspNew[0]), AT);
  end;
  I := 0;
  while I < 10 do
  begin
    ArgState^.LspOld[I] := LspNew[I];
    Inc(I);
  end;
  AmrFwc;
  Az := AT;
  EvenSubfr := 0;
  SubfrNr := -1;
  ISubfr := 0;
  while ISubfr < 160 do
  begin
    SubfrNr := FixedPoint.Add(SubfrNr, 1);
    EvenSubfr := FixedPoint.Sub(1, EvenSubfr);
    PitFlag := ISubfr;
    if FixedPoint.Sub(ISubfr, 80) = 0 then
    begin
      if (FixedPoint.Sub(Mode, MR475) <> 0) and (FixedPoint.Sub(Mode, MR515) <> 0) then
        PitFlag := 0;
    end;
    IndexValue := Parm^;
    Inc(Parm);
    if FixedPoint.Sub(Mode, MR122) <> 0 then
    begin
      Flag4 := 0;
      if (FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0) or
        (FixedPoint.Sub(Mode, MR67) = 0) then
        Flag4 := 1;
      DeltaFrcLow := 5;
      DeltaFrcRange := 9;
      if FixedPoint.Sub(Mode, MR795) = 0 then
      begin
        DeltaFrcLow := 10;
        DeltaFrcRange := 19;
      end;
      T0Min := FixedPoint.Sub(ArgState^.OldT0, DeltaFrcLow);
      if FixedPoint.Sub(T0Min, 20) < 0 then
        T0Min := 20;
      T0Max := FixedPoint.Add(T0Min, DeltaFrcRange);
      if FixedPoint.Sub(T0Max, 143) > 0 then
      begin
        T0Max := 143;
        T0Min := FixedPoint.Sub(T0Max, DeltaFrcRange);
      end;
      AmrDecLag3(IndexValue, T0Min, T0Max, PitFlag, ArgState^.OldT0, PAMRSmallInt(@T0), PAMRSmallInt(@T0Frac),
        Flag4);
      ArgState^.T0LagBuff := T0;
      if Bfi <> 0 then
      begin
        if FixedPoint.Sub(ArgState^.OldT0, 143) < 0 then
          ArgState^.OldT0 := FixedPoint.Add(ArgState^.OldT0, 1);
        T0 := ArgState^.OldT0;
        T0Frac := 0;
        if (ArgState^.InBackgroundNoise <> 0) and (FixedPoint.Sub(ArgState^.VoicedHangover, 4) > 0) and
          ((FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0)) then
          T0 := ArgState^.T0LagBuff;
      end;
      AmrFwc;
      AmrPredLt3or6(ArgState^.Exc, T0, T0Frac, 40, 1);
    end
    else
    begin
      AmrDecLag6(IndexValue, 18, 143, PitFlag, PAMRSmallInt(@T0), PAMRSmallInt(@T0Frac));
      if not ((Bfi = 0) and ((PitFlag = 0) or (FixedPoint.Sub(IndexValue, 61) < 0))) then
      begin
        ArgState^.T0LagBuff := T0;
        T0 := ArgState^.OldT0;
        T0Frac := 0;
      end;
      AmrFwc;
      AmrPredLt3or6(ArgState^.Exc, T0, T0Frac, 40, 0);
    end;
    AmrFwc;
    if (FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) then
    begin
      IndexValue := Parm^;
      Inc(Parm);
      I := Parm^;
      Inc(Parm);
      AmrFwc;
      AmrDecode2i409bits(SubfrNr, I, IndexValue, PAMRSmallInt(@Code[0]));
      AmrFwc;
      PitSharp := FixedPoint.ShiftLeft(ArgState^.Sharp, 1);
    end
    else
    begin
      if FixedPoint.Sub(Mode, MR59) = 0 then
      begin
        IndexValue := Parm^;
        Inc(Parm);
        I := Parm^;
        Inc(Parm);
        AmrFwc;
        AmrDecode2i4011bits(I, IndexValue, PAMRSmallInt(@Code[0]));
        AmrFwc;
        PitSharp := FixedPoint.ShiftLeft(ArgState^.Sharp, 1);
      end
      else
      begin
        if FixedPoint.Sub(Mode, MR67) = 0 then
        begin
          IndexValue := Parm^;
          Inc(Parm);
          I := Parm^;
          Inc(Parm);
          AmrFwc;
          AmrDecode3i4014bits(I, IndexValue, PAMRSmallInt(@Code[0]));
          AmrFwc;
          PitSharp := FixedPoint.ShiftLeft(ArgState^.Sharp, 1);
        end
        else
        begin
          if FixedPoint.Sub(Mode, MR795) <= 0 then
          begin
            IndexValue := Parm^;
            Inc(Parm);
            I := Parm^;
            Inc(Parm);
            AmrFwc;
            AmrDecode4i4017bits(I, IndexValue, PAMRSmallInt(@Code[0]));
            AmrFwc;
            PitSharp := FixedPoint.ShiftLeft(ArgState^.Sharp, 1);
          end
          else
          begin
            if FixedPoint.Sub(Mode, MR102) = 0 then
            begin
              AmrFwc;
              AmrDec8i4031bits(Parm, PAMRSmallInt(@Code[0]));
              Parm := Parm + 7;
              AmrFwc;
              PitSharp := FixedPoint.ShiftLeft(ArgState^.Sharp, 1);
            end
            else
            begin
              IndexValue := Parm^;
              Inc(Parm);
              if Bfi <> 0 then
              begin
                AmrEcGainPitch(ArgState^.EcGainPSt, ArgState^.State, PAMRSmallInt(@GainPit));
              end
              else
                GainPit := AmrDGainPitch(Mode, IndexValue);
              AmrEcGainPitchUpdate(ArgState^.EcGainPSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainPit));
              AmrFwc;
              AmrDec10i4035bits(Parm, PAMRSmallInt(@Code[0]));
              Parm := Parm + 10;
              AmrFwc;
              PitSharp := FixedPoint.ShiftLeft(GainPit, 1);
            end;
          end;
        end;
      end;
    end;
    I := T0;
    while I < 40 do
    begin
      Temp := FixedPoint.Mult(Code[I - T0], PitSharp);
      Code[I] := FixedPoint.Add(Code[I], Temp);
      Inc(I);
    end;
    AmrFwc;
    if Ord((FixedPoint.Sub(Mode, MR475) = 0)) <> 0 then
    begin
      if EvenSubfr <> 0 then
      begin
        IndexMr475 := Parm^;
        Inc(Parm);
      end;
      if Bfi = 0 then
      begin
        AmrDecGain(ArgState^.PredState, Mode, IndexMr475, PAMRSmallInt(@Code[0]), EvenSubfr,
          PAMRSmallInt(@GainPit), PAMRSmallInt(@GainCode));
      end
      else
      begin
        AmrEcGainPitch(ArgState^.EcGainPSt, ArgState^.State, PAMRSmallInt(@GainPit));
        AmrEcGainCode(ArgState^.EcGainCSt, ArgState^.PredState, ArgState^.State, PAMRSmallInt(@GainCode));
      end;
      AmrEcGainPitchUpdate(ArgState^.EcGainPSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainPit));
      AmrEcGainCodeUpdate(ArgState^.EcGainCSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainCode));
      AmrFwc;
      PitSharp := GainPit;
      if FixedPoint.Sub(PitSharp, 13017) > 0 then
        PitSharp := 13017;
    end
    else
    begin
      if Ord(((FixedPoint.Sub(Mode, MR74) <= 0) or (FixedPoint.Sub(Mode, MR102) = 0))) <> 0 then
      begin
        IndexValue := Parm^;
        Inc(Parm);
        if Bfi = 0 then
        begin
          AmrDecGain(ArgState^.PredState, Mode, IndexValue, PAMRSmallInt(@Code[0]), EvenSubfr,
            PAMRSmallInt(@GainPit), PAMRSmallInt(@GainCode));
        end
        else
        begin
          AmrEcGainPitch(ArgState^.EcGainPSt, ArgState^.State, PAMRSmallInt(@GainPit));
          AmrEcGainCode(ArgState^.EcGainCSt, ArgState^.PredState, ArgState^.State, PAMRSmallInt(@GainCode));
        end;
        AmrEcGainPitchUpdate(ArgState^.EcGainPSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainPit));
        AmrEcGainCodeUpdate(ArgState^.EcGainCSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainCode));
        AmrFwc;
        PitSharp := GainPit;
        if FixedPoint.Sub(PitSharp, 13017) > 0 then
          PitSharp := 13017;
        if FixedPoint.Sub(Mode, MR102) = 0 then
        begin
          if FixedPoint.Sub(ArgState^.OldT0, FixedPoint.Add(40, 5)) > 0 then
            PitSharp := FixedPoint.ShiftRight(PitSharp, 2);
        end;
      end
      else
      begin
        IndexValue := Parm^;
        Inc(Parm);
        if FixedPoint.Sub(Mode, MR795) = 0 then
        begin
          if Bfi <> 0 then
          begin
            AmrEcGainPitch(ArgState^.EcGainPSt, ArgState^.State, PAMRSmallInt(@GainPit));
          end
          else
            GainPit := AmrDGainPitch(Mode, IndexValue);
          AmrEcGainPitchUpdate(ArgState^.EcGainPSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainPit));
          IndexValue := Parm^;
          Inc(Parm);
          if Bfi = 0 then
          begin
            AmrDGainCode(ArgState^.PredState, Mode, IndexValue, PAMRSmallInt(@Code[0]), PAMRSmallInt(@GainCode));
          end
          else
          begin
            AmrEcGainCode(ArgState^.EcGainCSt, ArgState^.PredState, ArgState^.State, PAMRSmallInt(@GainCode));
          end;
          AmrEcGainCodeUpdate(ArgState^.EcGainCSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainCode));
          AmrFwc;
          PitSharp := GainPit;
          if FixedPoint.Sub(PitSharp, 13017) > 0 then
            PitSharp := 13017;
        end
        else
        begin
          if Bfi = 0 then
          begin
            AmrDGainCode(ArgState^.PredState, Mode, IndexValue, PAMRSmallInt(@Code[0]), PAMRSmallInt(@GainCode));
          end
          else
          begin
            AmrEcGainCode(ArgState^.EcGainCSt, ArgState^.PredState, ArgState^.State, PAMRSmallInt(@GainCode));
          end;
          AmrEcGainCodeUpdate(ArgState^.EcGainCSt, Bfi, ArgState^.PrevBf, PAMRSmallInt(@GainCode));
          AmrFwc;
          PitSharp := GainPit;
        end;
      end;
    end;
    if (FixedPoint.Sub(Mode, MR475) <> 0) or (EvenSubfr = 0) then
    begin
      ArgState^.Sharp := GainPit;
      if FixedPoint.Sub(ArgState^.Sharp, 13017) > 0 then
        ArgState^.Sharp := 13017;
    end;
    PitSharp := FixedPoint.ShiftLeft(PitSharp, 1);
    if FixedPoint.Sub(PitSharp, 16384) > 0 then
    begin
      I := 0;
      while I < 40 do
      begin
        Temp := FixedPoint.Mult(ArgState^.Exc[I], PitSharp);
        LTemp := FixedPoint.LMult(Temp, GainPit);
        if FixedPoint.Sub(Mode, MR122) = 0 then
          LTemp := FixedPoint.LShr(LTemp, 1);
        Excp[I] := FixedPoint.Round(LTemp);
        Inc(I);
      end;
    end;
    if Bfi = 0 then
    begin
      I := 0;
      while I < 8 do
      begin
        ArgState^.LtpGainHistory[I] := ArgState^.LtpGainHistory[I + 1];
        Inc(I);
      end;
      ArgState^.LtpGainHistory[8] := GainPit;
    end;
    if ((ArgState^.PrevBf <> 0) or (Bfi <> 0)) and (ArgState^.InBackgroundNoise <> 0) and
      ((FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0)) then
    begin
      if FixedPoint.Sub(GainPit, 12288) > 0 then
        GainPit := FixedPoint.Add(FixedPoint.ShiftRight(FixedPoint.Sub(GainPit, 12288), 1), 12288);
      if FixedPoint.Sub(GainPit, 14745) > 0 then
        GainPit := 14745;
    end;
    AmrIntLsf(PAMRSmallInt(@PrevLsf[0]), PAMRSmallInt(@ArgState^.LsfState^.PastLsfQ[0]), ISubfr,
      PAMRSmallInt(@LsfI[0]));
    GainCodeMix := AmrCbGainAverage(ArgState^.CbGainAverState, Mode, GainCode, PAMRSmallInt(@LsfI[0]),
      PAMRSmallInt(@ArgState^.LspAvgSt^.LspMeanSave[0]), Bfi, ArgState^.PrevBf, Pdfi, ArgState^.PrevPdf,
      ArgState^.InBackgroundNoise, ArgState^.VoicedHangover);
    if (FixedPoint.Sub(Mode, MR67) > 0) and (FixedPoint.Sub(Mode, MR102) <> 0) then
      GainCodeMix := GainCode;
    if FixedPoint.Sub(Mode, MR102) <= 0 then
    begin
      PitchFac := GainPit;
      TmpShift := 1;
    end
    else
    begin
      PitchFac := FixedPoint.ShiftRight(GainPit, 1);
      TmpShift := 2;
    end;
    I := 0;
    while I < 40 do
    begin
      ExcEnhanced[I] := ArgState^.Exc[I];
      LTemp := FixedPoint.LMult(ArgState^.Exc[I], PitchFac);
      LTemp := FixedPoint.LMac(LTemp, Code[I], GainCode);
      LTemp := FixedPoint.LShl(LTemp, TmpShift);
      ArgState^.Exc[I] := FixedPoint.Round(LTemp);
      Inc(I);
    end;
    AmrPhDispRelease(ArgState^.PhDispSt);
    if ((FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0)) and
      (FixedPoint.Sub(ArgState^.VoicedHangover, 3) > 0) and (ArgState^.InBackgroundNoise <> 0) and (Bfi <> 0) then
    begin
      AmrPhDispLock(ArgState^.PhDispSt);
    end;
    AmrPhDisp(ArgState^.PhDispSt, Mode, PAMRSmallInt(@ExcEnhanced[0]), GainCodeMix, GainPit,
      PAMRSmallInt(@Code[0]), PitchFac, TmpShift);
    LTemp := 0;
    I := 0;
    while I < 40 do
    begin
      LTemp := FixedPoint.LMac(LTemp, ExcEnhanced[I], ExcEnhanced[I]);
      Inc(I);
    end;
    LTemp := FixedPoint.LShr(LTemp, 1);
    LTemp := AmrSqrtLExp(LTemp, PAMRSmallInt(@Temp));
    LTemp := FixedPoint.LShr(LTemp, FixedPoint.Add(FixedPoint.ShiftRight(Temp, 1), 15));
    LTemp := FixedPoint.LShr(LTemp, 2);
    ExcEnergy := AmrExtractL(LTemp);
    if ((FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) or (FixedPoint.Sub(Mode, MR59) = 0)) and
      (FixedPoint.Sub(ArgState^.VoicedHangover, 5) > 0) and (ArgState^.InBackgroundNoise <> 0) and
      (FixedPoint.Sub(ArgState^.State, 4) < 0) and
      (((Pdfi <> 0) and (ArgState^.PrevPdf <> 0)) or (Bfi <> 0) or (ArgState^.PrevBf <> 0)) then
    begin
      CarefulFlag := 0;
      if (Pdfi <> 0) and (Bfi = 0) then
        CarefulFlag := 1;
      AmrExCtrl(PAMRSmallInt(@ExcEnhanced[0]), ExcEnergy, PAMRSmallInt(@ArgState^.ExcEnergyHist[0]),
        ArgState^.VoicedHangover, ArgState^.PrevBf, CarefulFlag);
    end;
    if not (((ArgState^.InBackgroundNoise <> 0) and ((Bfi <> 0) or (ArgState^.PrevBf <> 0))) and
      (FixedPoint.Sub(ArgState^.State, 4) < 0)) then
    begin
      I := 0;
      while I < 8 do
      begin
        ArgState^.ExcEnergyHist[I] := ArgState^.ExcEnergyHist[I + 1];
        Inc(I);
      end;
      ArgState^.ExcEnergyHist[8] := ExcEnergy;
    end;
    AmrFwc;
    if FixedPoint.Sub(PitSharp, 16384) > 0 then
    begin
      I := 0;
      while I < 40 do
      begin
        Excp[I] := FixedPoint.Add(Excp[I], ExcEnhanced[I]);
        Inc(I);
      end;
      AmrAgc2(PAMRSmallInt(@ExcEnhanced[0]), PAMRSmallInt(@Excp[0]), 40);
      FixedPoint.Overflow := 0;
      AmrSynFilt(Az, PAMRSmallInt(@Excp[0]), PAMRSmallInt(@Synth[ISubfr]), 40,
        PAMRSmallInt(@ArgState^.MemSyn[0]), 0);
    end
    else
    begin
      FixedPoint.Overflow := 0;
      AmrSynFilt(Az, PAMRSmallInt(@ExcEnhanced[0]), PAMRSmallInt(@Synth[ISubfr]), 40,
        PAMRSmallInt(@ArgState^.MemSyn[0]), 0);
    end;
    if FixedPoint.Overflow <> 0 then
    begin
      I := 0;
      while I < ((143 + (10 + 1)) + 40) do
      begin
        ArgState^.OldExc[I] := FixedPoint.ShiftRight(ArgState^.OldExc[I], 2);
        Inc(I);
      end;
      I := 0;
      while I < 40 do
      begin
        ExcEnhanced[I] := FixedPoint.ShiftRight(ExcEnhanced[I], 2);
        Inc(I);
      end;
      AmrSynFilt(Az, PAMRSmallInt(@ExcEnhanced[0]), PAMRSmallInt(@Synth[ISubfr]), 40,
        PAMRSmallInt(@ArgState^.MemSyn[0]), 1);
    end
    else
    begin
      CopySamples(PAMRSmallInt(@Synth[(ISubfr + 40) - 10]), PAMRSmallInt(@ArgState^.MemSyn[0]), 10);
    end;
    CopySamples(PAMRSmallInt(@ArgState^.OldExc[40]), PAMRSmallInt(@ArgState^.OldExc[0]), (143 + (10 + 1)));
    AmrFwc;
    Az := Az + (10 + 1);
    ArgState^.OldT0 := T0;
    ISubfr := ISubfr + 40;
  end;
  ArgState^.InBackgroundNoise := AmrBgnScd(ArgState^.BackgroundState, PAMRSmallInt(@ArgState^.LtpGainHistory[0]),
    PAMRSmallInt(@Synth[0]), PAMRSmallInt(@ArgState^.VoicedHangover));
  AmrDtxDecActivityUpdate(ArgState^.DtxDecoderState, PAMRSmallInt(@ArgState^.LsfState^.PastLsfQ[0]), Synth);
  AmrFwc;
  ArgState^.PrevBf := Bfi;
  ArgState^.PrevPdf := Pdfi;
  AmrLspAvg(ArgState^.LspAvgSt, PAMRSmallInt(@ArgState^.LsfState^.PastLsfQ[0]));
  AmrFwc;
Label_the_end:
  ArgState^.DtxDecoderState^.DtxGlobalState := NewDTXState;
  Result := 0;
end;

procedure AmrWeightAi(A, Fac, AExp: PAMRSmallInt);
var
  I: SmallInt;
begin
  AExp[0] := A[0];
  I := 1;
  while I <= 10 do
  begin
    AExp[I] := FixedPoint.Round(FixedPoint.LMult(A[I], Fac[I - 1]));
    Inc(I);
  end;
end;

procedure AmrResidu(A, X, Y: PAMRSmallInt; Lg: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  S: Integer;
begin
  I := 0;
  while I < Lg do
  begin
    S := FixedPoint.LMult(X[I], A[0]);
    J := 1;
    while J <= 10 do
    begin
      S := FixedPoint.LMac(S, A[J], X[I - J]);
      Inc(J);
    end;
    S := FixedPoint.LShl(S, 3);
    Y[I] := FixedPoint.Round(S);
    Inc(I);
  end;
end;

function AmrPreemphasis(State: PAMRpreemphasisState; Signal: PAMRSmallInt; G, L: SmallInt): Integer;
var
  P1: PAMRSmallInt;
  P2: PAMRSmallInt;
  Temp: SmallInt;
  I: SmallInt;
begin
  P1 := (Signal + L) - 1;
  P2 := P1 - 1;
  Temp := P1^;
  I := 0;
  while I <= (L - 2) do
  begin
    P1^ := FixedPoint.Sub(P1^, FixedPoint.Mult(G, P2^));
    Dec(P2);
    Dec(P1);
    Inc(I);
  end;
  P1^ := FixedPoint.Sub(P1^, FixedPoint.Mult(G, State^.MemPre));
  State^.MemPre := Temp;
  Result := 0;
end;

function AmrAgc(State: PAMRagcState; SigIn, SigOut: PAMRSmallInt; AgcFac, LTrm: SmallInt): Integer;
var
  I: SmallInt;
  Exp: SmallInt;
  GainIn: SmallInt;
  GainOut: SmallInt;
  G0: SmallInt;
  Gain: SmallInt;
  S: Integer;
begin
  S := MeasureEnergy(SigOut, LTrm);
  if S = 0 then
  begin
    State^.PastGain := 0;
    Exit(0);
  end;
  Exp := FixedPoint.Sub(AmrNormL(S), 1);
  GainOut := FixedPoint.Round(FixedPoint.LShl(S, Exp));
  S := MeasureEnergy(SigIn, LTrm);
  if S = 0 then
    G0 := 0
  else
  begin
    I := AmrNormL(S);
    GainIn := FixedPoint.Round(FixedPoint.LShl(S, I));
    Exp := FixedPoint.Sub(Exp, I);
    S := AmrLDepositL(FixedPoint.DivS(GainOut, GainIn));
    S := FixedPoint.LShl(S, 7);
    S := FixedPoint.LShr(S, Exp);
    S := AmrInvSqrt(S);
    I := FixedPoint.Round(FixedPoint.LShl(S, 9));
    G0 := FixedPoint.Mult(I, FixedPoint.Sub(32767, AgcFac));
  end;
  Gain := State^.PastGain;
  I := 0;
  while I < LTrm do
  begin
    Gain := FixedPoint.Mult(Gain, AgcFac);
    Gain := FixedPoint.Add(Gain, G0);
    SigOut[I] := AmrExtractH(FixedPoint.LShl(FixedPoint.LMult(SigOut[I], Gain), 3));
    Inc(I);
  end;
  State^.PastGain := Gain;
  Result := 0;
end;

function AmrPostFilter(State: PAMRPostFilterState; Mode: Integer; Syn, Az4: PAMRSmallInt): Integer;
var
  Ap3: array[0..10] of SmallInt;
  Ap4: array[0..10] of SmallInt;
  Az: PAMRSmallInt;
  ISubfr: SmallInt;
  H: array[0..21] of SmallInt;
  I: SmallInt;
  Temp1: SmallInt;
  Temp2: SmallInt;
  LTmp: Integer;
  SynWork: PAMRSmallInt;
begin
  SynWork := PAMRSmallInt(@State^.SynthBuf[10]);
  CopySamples(Syn, SynWork, 160);
  Az := Az4;
  ISubfr := 0;
  while ISubfr < 160 do
  begin
    if (FixedPoint.Sub(Mode, MR122) = 0) or (FixedPoint.Sub(Mode, MR102) = 0) then
    begin
      AmrWeightAi(Az, PAMRSmallInt(@PstfiltGamma3MR122[0]), PAMRSmallInt(@Ap3[0]));
      AmrWeightAi(Az, PAMRSmallInt(@PstfiltGamma4MR122[0]), PAMRSmallInt(@Ap4[0]));
    end
    else
    begin
      AmrWeightAi(Az, PAMRSmallInt(@PstfiltGamma3[0]), PAMRSmallInt(@Ap3[0]));
      AmrWeightAi(Az, PAMRSmallInt(@PstfiltGamma4[0]), PAMRSmallInt(@Ap4[0]));
    end;
    AmrResidu(PAMRSmallInt(@Ap3[0]), PAMRSmallInt(@SynWork[ISubfr]), PAMRSmallInt(@State^.Res2[0]), 40);
    CopySamples(PAMRSmallInt(@Ap3[0]), PAMRSmallInt(@H[0]), (10 + 1));
    ZeroSamples(PAMRSmallInt(@H[10 + 1]), ((22 - 10) - 1));
    AmrSynFilt(PAMRSmallInt(@Ap4[0]), PAMRSmallInt(@H[0]), PAMRSmallInt(@H[0]), 22, PAMRSmallInt(@H[10 + 1]), 0);
    LTmp := FixedPoint.LMult(H[0], H[0]);
    I := 1;
    while I < 22 do
    begin
      LTmp := FixedPoint.LMac(LTmp, H[I], H[I]);
      Inc(I);
    end;
    Temp1 := AmrExtractH(LTmp);
    LTmp := FixedPoint.LMult(H[0], H[1]);
    I := 1;
    while I < (22 - 1) do
    begin
      LTmp := FixedPoint.LMac(LTmp, H[I], H[I + 1]);
      Inc(I);
    end;
    Temp2 := AmrExtractH(LTmp);
    if Temp2 <= 0 then
      Temp2 := 0
    else
    begin
      Temp2 := FixedPoint.Mult(Temp2, 26214);
      Temp2 := FixedPoint.DivS(Temp2, Temp1);
    end;
    AmrPreemphasis(State^.PreemphState, PAMRSmallInt(@State^.Res2[0]), Temp2, 40);
    AmrSynFilt(PAMRSmallInt(@Ap4[0]), PAMRSmallInt(@State^.Res2[0]), PAMRSmallInt(@Syn[ISubfr]), 40,
      PAMRSmallInt(@State^.MemSynPst[0]), 1);
    AmrAgc(State^.AgcState, PAMRSmallInt(@SynWork[ISubfr]), PAMRSmallInt(@Syn[ISubfr]), 29491, 40);
    Az := Az + (10 + 1);
    ISubfr := ISubfr + 40;
  end;
  CopySamples(PAMRSmallInt(@SynWork[160 - 10]), PAMRSmallInt(@SynWork[-10]), 10);
  Result := 0;
end;

function AmrPostProcess(State: PAMRPostProcessState; Signal: PAMRSmallInt; Lg: SmallInt): Integer;
var
  I: SmallInt;
  X2: SmallInt;
  LTmp: Integer;
begin
  I := 0;
  while I < Lg do
  begin
    X2 := State^.X1;
    State^.X1 := State^.X0;
    State^.X0 := Signal[I];
    LTmp := FixedPoint.Mpy3216(State^.Y1Hi, State^.Y1Lo, PostProA[1]);
    LTmp := FixedPoint.LAdd(LTmp, FixedPoint.Mpy3216(State^.Y2Hi, State^.Y2Lo, PostProA[2]));
    LTmp := FixedPoint.LMac(LTmp, State^.X0, PostProB[0]);
    LTmp := FixedPoint.LMac(LTmp, State^.X1, PostProB[1]);
    LTmp := FixedPoint.LMac(LTmp, X2, PostProB[2]);
    LTmp := FixedPoint.LShl(LTmp, 2);
    Signal[I] := FixedPoint.Round(FixedPoint.LShl(LTmp, 1));
    State^.Y2Hi := State^.Y1Hi;
    State^.Y2Lo := State^.Y1Lo;
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@State^.Y1Hi), PAMRSmallInt(@State^.Y1Lo));
    Inc(I);
  end;
  Result := 0;
end;

function DecodeSpeechFrame(State: PAMRSpeechDecodeFrameState; Mode: Integer; Serial: PAMRSmallInt; FrameType: Integer; Synth: PAMRSmallInt): Integer;
var
  Parm: array[0..57] of SmallInt;
  AzDec: array[0..43] of SmallInt;
  I: SmallInt;
begin
  FixedPoint.Sub(0, 0);
  FixedPoint.Sub(0, 0);
  if (FrameType = RxSidBad) or (FrameType = RxSidUpdate) then
  begin
    AmrBits2prm(MRDTX, Serial, PAMRSmallInt(@Parm[0]));
  end
  else
  begin
    AmrBits2prm(Mode, Serial, PAMRSmallInt(@Parm[0]));
  end;
  AmrDecoderAmr(State^.DecoderAmrState, Mode, PAMRSmallInt(@Parm[0]), FrameType, Synth, PAMRSmallInt(@AzDec[0]));
  AmrPostFilter(State^.PostState, Mode, Synth, PAMRSmallInt(@AzDec[0]));
  AmrPostProcess(State^.PostHPState, Synth, 160);
  for I := 0 to 159 do
    Synth[I] := Synth[I] and $FFF8;
  AmrFwc;
  Result := 0;
end;

function TestHomingParameters(InputFrame: PAMRSmallInt; Mode: Integer; Nparms: SmallInt): SmallInt;
var
  I: SmallInt;
  J: SmallInt;
  Param: array[0..56] of SmallInt;
begin
  AmrBits2prm(Mode, InputFrame, PAMRSmallInt(@Param[0]));
  J := 0;
  I := 0;
  while I < Nparms do
  begin
    J := Param[I] xor DHomingDhf[Mode][I];
    if J <> 0 then
      Break;
    Inc(I);
  end;
  Result := Ord((not (J <> 0)));
end;

function TestHomingFrame(InputFrame: PAMRSmallInt; Mode: Integer): SmallInt;
begin
  Result := TestHomingParameters(InputFrame, Mode, DHomingPrmno[Mode]);
end;

function TestInitialHomingFrame(InputFrame: PAMRSmallInt; Mode: Integer): SmallInt;
begin
  Result := TestHomingParameters(InputFrame, Mode, DHomingPrmnofsf[Mode]);
end;

function UnpackStorageBits(Q: ShortInt; Ft: SmallInt; PackedBits: PAMRByte; Mode: PAMRInteger; Bits: PAMRSmallInt): Integer;
var
  I: SmallInt;
  SidType: SmallInt;
  PackPtr: PAMRByte;
  Temp: Byte;
begin
  PackPtr := PAMRByte(PackedBits);
  if (Ft = 15) or ((Ft > 8) and (Ft < 15)) then
  begin
    Mode^ := Integer((-1));
    Exit(RxNoData);
  end;
  Temp := PackPtr^;
  Inc(PackPtr);
  I := 1;
  while I < (SpDecUnpackedSize[Ft] + 1) do
  begin
    if (Temp and $80) <> 0 then
      Bits[SpDecSortPtr[Ft][I - 1]] := 1
    else
      Bits[SpDecSortPtr[Ft][I - 1]] := 0;
    if (I mod 8) <> 0 then
      Temp := Temp shl 1
    else
    begin
      Temp := PackPtr^;
      Inc(PackPtr);
    end;
    Inc(I);
  end;
  if Ft = MRDTX then
  begin
    if (Temp and $80) <> 0 then
      SidType := 1
    else
      SidType := 0;
    Mode^ := Integer((SignedRightShift(Temp, 4) and $7));
    Mode^ := (SignedRightShift((Mode^ and $4), 2) or (Mode^ and $2)) or ((Mode^ and $1) shl 2);
    if Q <> 0 then
    begin
      if SidType <> 0 then
        Exit(RxSidUpdate)
      else
        Exit(RxSidFirst);
    end
    else
      Exit(RxSidBad);
  end
  else
  begin
    Mode^ := Integer(Ft);
    if Q <> 0 then
      Exit(RxSpeechGood)
    else
      Exit(RxSpeechBad);
  end;
end;

