function AmrDecoderAmrReset(ArgState: PAMRDecoderAmrState; Mode: Integer): Integer;
var
  I: SmallInt;
begin
  if ArgState = nil then
    Exit(-1);
  ArgState^.Exc := (PAMRSmallInt(@ArgState^.OldExc[0]) + 143) + (10 + 1);
  ZeroSamples(PAMRSmallInt(@ArgState^.OldExc[0]), (143 + (10 + 1)));
  if Mode <> MRDTX then
  begin
    ZeroSamples(PAMRSmallInt(@ArgState^.MemSyn[0]), 10);
  end;
  ArgState^.Sharp := 0;
  ArgState^.OldT0 := 40;
  if Mode <> MRDTX then
  begin
    CopySamples(PAMRSmallInt(@DecAmrLspInitData[0]), PAMRSmallInt(@ArgState^.LspOld[0]), 10);
  end;
  ArgState^.PrevBf := 0;
  ArgState^.PrevPdf := 0;
  ArgState^.State := 0;
  ArgState^.T0LagBuff := 40;
  ArgState^.InBackgroundNoise := 0;
  ArgState^.VoicedHangover := 0;
  if Mode <> MRDTX then
  begin
    I := 0;
    while I < 9 do
    begin
      ArgState^.ExcEnergyHist[I] := 0;
      Inc(I);
    end;
  end;
  I := 0;
  while I < 9 do
  begin
    ArgState^.LtpGainHistory[I] := 0;
    Inc(I);
  end;
  AmrCbGainAverageReset(ArgState^.CbGainAverState);
  if Mode <> MRDTX then
  begin
    AmrLspAvgReset(ArgState^.LspAvgSt);
  end;
  AmrDPlsfReset(ArgState^.LsfState);
  AmrEcGainPitchReset(ArgState^.EcGainPSt);
  AmrEcGainCodeReset(ArgState^.EcGainCSt);
  if Mode <> MRDTX then
  begin
    AmrGcPredReset(ArgState^.PredState);
  end;
  AmrBgnScdReset(ArgState^.BackgroundState);
  ArgState^.NodataSeed := 21845;
  AmrPhDispReset(ArgState^.PhDispSt);
  if Mode <> MRDTX then
  begin
    AmrDtxDecReset(ArgState^.DtxDecoderState);
  end;
  Result := 0;
end;

