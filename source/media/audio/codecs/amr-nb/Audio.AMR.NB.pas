{$IFDEF AMRNB_RESTORE_R}{$R+}{$UNDEF AMRNB_RESTORE_R}{$ENDIF}

constructor TAMRNBDecoder.Create;
var
  State: PAMRSpeechDecodeFrameState;
begin
  inherited;
  State := nil;
  FixedPoint.Overflow := 0;
  if InitSpeechDecoder(@State) <> 0 then
    raise EOutOfMemory.Create('AMR-NB decoder state');
  FState := State;
  FOverflow := FixedPoint.Overflow;
  FHomed := True;
end;

destructor TAMRNBDecoder.Destroy;
var
  State: PAMRSpeechDecodeFrameState;
begin
  State := FState;
  if State <> nil then
    FreeSpeechDecoder(@State);
  inherited;
end;

procedure TAMRNBDecoder.Reset;
begin
  FixedPoint.Overflow := 0;
  ResetSpeechDecoder(FState);
  FOverflow := FixedPoint.Overflow;
  FHomed := True;
end;

procedure TAMRNBDecoder.Decode(Mode, Kind: Integer; var Bits: array of SmallInt; out PCM: TAMRNBPCM);
var
  State: PAMRSpeechDecodeFrameState;
  ResetRequired: Boolean;
begin
  State := FState;
  if Kind = RxNoData then
    Mode := State^.PrevMode
  else
    State^.PrevMode := Mode;

  ResetRequired := False;
  if FHomed then
    ResetRequired := TestInitialHomingFrame(@Bits[0], Mode) <> 0;
  if ResetRequired then
    for var I := Low(PCM) to High(PCM) do
      PCM[I] := 8
  else
  begin
    // Keep the thread-local saturation flag with its decoder stream.
    FixedPoint.Overflow := FOverflow;
    DecodeSpeechFrame(State, Mode, @Bits[0], Kind, @PCM[0]);
    FOverflow := FixedPoint.Overflow;
  end;

  if not FHomed then
    ResetRequired := TestHomingFrame(@Bits[0], Mode) <> 0;
  if ResetRequired then
    Reset;
  FHomed := ResetRequired;
end;

procedure TAMRNBDecoder.DecodeSerial(Mode: TAMRNBMode; Kind: TAMRNBFrameKind; const Bits: array of SmallInt; out PCM: TAMRNBPCM);
var
  Serial: array[0..AMRNBMaxSerialBits - 1] of SmallInt;
begin
  if (Ord(Mode) > Ord(High(TAMRNBMode))) or (Ord(Kind) > Ord(High(TAMRNBFrameKind))) then
    raise EArgumentOutOfRangeException.Create('AMR-NB mode or frame type');
  if Length(Bits) <> Length(Serial) then
    raise EArgumentException.Create('AMR-NB serial frame requires 244 words');
  for var I := Low(Serial) to High(Serial) do
  begin
    if (Bits[I] < 0) or (Bits[I] > 1) then
      raise EArgumentException.Create('AMR-NB serial bits must be 0 or 1');
    Serial[I] := Bits[I];
  end;
  Decode(Ord(Mode), Ord(Kind), Serial, PCM);
end;

class function TAMRNBDecoder.StorageFrameSize(Header: Byte): Integer;
const
  FrameSizes: array[0..15] of Byte = (13, 14, 16, 18, 20, 21, 27, 32, 6, 0, 0, 0, 0, 0, 0, 1);
begin
  Result := FrameSizes[(Header shr 3) and 15];
end;

procedure TAMRNBDecoder.DecodeStorageFrame(const Frame: TBytes; out PCM: TAMRNBPCM);
var
  Serial: array[0..AMRNBMaxSerialBits - 1] of SmallInt;
  Payload: array[0..31] of Byte;
  Mode, Kind: Integer;
begin
  if (Length(Frame) = 0) or (StorageFrameSize(Frame[0]) <> Length(Frame)) then
    raise EArgumentException.Create('Invalid AMR-NB storage frame');
  FillChar(Serial, SizeOf(Serial), 0);
  FillChar(Payload, SizeOf(Payload), 0);
  if Length(Frame) > 1 then
    Move(Frame[1], Payload[0], Length(Frame) - 1);
  Kind := UnpackStorageBits((Frame[0] shr 2) and 1, (Frame[0] shr 3) and 15,
    @Payload[0], @Mode, @Serial[0]);
  Decode(Mode, Kind, Serial, PCM);
end;

end.

