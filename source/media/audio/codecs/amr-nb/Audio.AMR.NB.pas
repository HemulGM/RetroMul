function AmrDPlsf5(State: PAMRDPlsfState; Bfi: SmallInt; Indice, Lsp1Q, Lsp2Q: PAMRSmallInt): Integer;
var
  I: SmallInt;
  Codebook: PAMRSmallInt;
  Temp: SmallInt;
  Sign: SmallInt;
  Lsf1R: array[0..9] of SmallInt;
  Lsf2R: array[0..9] of SmallInt;
  Lsf1Q: array[0..9] of SmallInt;
  Lsf2Q: array[0..9] of SmallInt;
begin
  if Bfi <> 0 then
  begin
    I := 0;
    while I < 10 do
    begin
      Lsf1Q[I] := FixedPoint.Add(FixedPoint.Mult(State^.PastLsfQ[I], 31128), FixedPoint.Mult(DPlsf5MeanLsf[I], 1639));
      Lsf2Q[I] := Lsf1Q[I];
      Inc(I);
    end;
    I := 0;
    while I < 10 do
    begin
      Temp := FixedPoint.Add(DPlsf5MeanLsf[I], FixedPoint.Mult(State^.PastRQ[I], 21299));
      State^.PastRQ[I] := FixedPoint.Sub(Lsf2Q[I], Temp);
      Inc(I);
    end;
  end
  else
  begin
    Codebook := PAMRSmallInt(@DPlsf5Dico1Lsf[FixedPoint.ShiftLeft(Indice[0], 2)]);
    Lsf1R[0] := Codebook^;
    Inc(Codebook);
    Lsf1R[1] := Codebook^;
    Inc(Codebook);
    Lsf2R[0] := Codebook^;
    Inc(Codebook);
    Lsf2R[1] := Codebook^;
    Codebook := PAMRSmallInt(@DPlsf5Dico2Lsf[FixedPoint.ShiftLeft(Indice[1], 2)]);
    Lsf1R[2] := Codebook^;
    Inc(Codebook);
    Lsf1R[3] := Codebook^;
    Inc(Codebook);
    Lsf2R[2] := Codebook^;
    Inc(Codebook);
    Lsf2R[3] := Codebook^;
    Sign := Indice[2] and 1;
    I := FixedPoint.ShiftRight(Indice[2], 1);
    Codebook := PAMRSmallInt(@DPlsf5Dico3Lsf[FixedPoint.ShiftLeft(I, 2)]);
    if Sign = 0 then
    begin
      Lsf1R[4] := Codebook^;
      Inc(Codebook);
      Lsf1R[5] := Codebook^;
      Inc(Codebook);
      Lsf2R[4] := Codebook^;
      Inc(Codebook);
      Lsf2R[5] := Codebook^;
    end
    else
    begin
      Lsf1R[4] := AmrNegate(Codebook^);
      Inc(Codebook);
      Lsf1R[5] := AmrNegate(Codebook^);
      Inc(Codebook);
      Lsf2R[4] := AmrNegate(Codebook^);
      Inc(Codebook);
      Lsf2R[5] := AmrNegate(Codebook^);
    end;
    Codebook := PAMRSmallInt(@DPlsf5Dico4Lsf[FixedPoint.ShiftLeft(Indice[3], 2)]);
    Lsf1R[6] := Codebook^;
    Inc(Codebook);
    Lsf1R[7] := Codebook^;
    Inc(Codebook);
    Lsf2R[6] := Codebook^;
    Inc(Codebook);
    Lsf2R[7] := Codebook^;
    Codebook := PAMRSmallInt(@DPlsf5Dico5Lsf[FixedPoint.ShiftLeft(Indice[4], 2)]);
    Lsf1R[8] := Codebook^;
    Inc(Codebook);
    Lsf1R[9] := Codebook^;
    Inc(Codebook);
    Lsf2R[8] := Codebook^;
    Inc(Codebook);
    Lsf2R[9] := Codebook^;
    I := 0;
    while I < 10 do
    begin
      Temp := FixedPoint.Add(DPlsf5MeanLsf[I], FixedPoint.Mult(State^.PastRQ[I], 21299));
      Lsf1Q[I] := FixedPoint.Add(Lsf1R[I], Temp);
      Lsf2Q[I] := FixedPoint.Add(Lsf2R[I], Temp);
      State^.PastRQ[I] := Lsf2R[I];
      Inc(I);
    end;
  end;
  AmrReorderLsf(PAMRSmallInt(@Lsf1Q[0]), 205, 10);
  AmrReorderLsf(PAMRSmallInt(@Lsf2Q[0]), 205, 10);
  CopySamples(PAMRSmallInt(@Lsf2Q[0]), PAMRSmallInt(@State^.PastLsfQ[0]), 10);
  AmrLsfLsp(PAMRSmallInt(@Lsf1Q[0]), Lsp1Q, 10);
  AmrLsfLsp(PAMRSmallInt(@Lsf2Q[0]), Lsp2Q, 10);
  Result := 0;
end;

procedure AmrDecLag3(ArgIndex, T0Min, T0Max, ISubfr, T0Prev: SmallInt; T0, T0Frac: PAMRSmallInt; Flag4: SmallInt);
var
  I: SmallInt;
  TmpLag: SmallInt;
begin
  if ISubfr = 0 then
  begin
    if FixedPoint.Sub(ArgIndex, 197) < 0 then
    begin
      T0^ := FixedPoint.Add(FixedPoint.Mult(FixedPoint.Add(ArgIndex, 2), 10923), 19);
      I := FixedPoint.Add(FixedPoint.Add(T0^, T0^), T0^);
      T0Frac^ := FixedPoint.Add(FixedPoint.Sub(ArgIndex, I), 58);
    end
