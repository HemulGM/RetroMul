function ReadParameterBits(NoOfBits: SmallInt; Bitstream: PAMRSmallInt): SmallInt;
var
  Value: SmallInt;
  I: SmallInt;
  Bit: SmallInt;
begin
  Value := 0;
  I := 0;
  while I < NoOfBits do
  begin
    Value := FixedPoint.ShiftLeft(Value, 1);
    Bit := Bitstream^;
    Inc(Bitstream);
    if FixedPoint.Sub(Bit, 1) = 0 then
      Value := FixedPoint.Add(Value, 1);
    Inc(I);
  end;
  Result := Value;
end;

procedure AmrBits2prm(Mode: Integer; Bits, Prm: PAMRSmallInt);
var
  I: SmallInt;
begin
  I := 0;
  while I < Bits2prmPrmno[Mode] do
  begin
    Prm[I] := ReadParameterBits(Bits2prmBitno[Mode][I], Bits);
    Bits := Bits + Bits2prmBitno[Mode][I];
    FixedPoint.Add(0, 0);
    Inc(I);
  end;
end;

function AmrRxDtxHandler(State: PAMRdtxDecState; FrameType: Integer): Integer;
var
  NewState: Integer;
  EncState: Integer;
begin
  if (FixedPoint.Sub(FrameType, RxSidFirst) = 0) or (FixedPoint.Sub(FrameType, RxSidUpdate) = 0) or
    (FixedPoint.Sub(FrameType, RxSidBad) = 0) or
    (((FixedPoint.Sub(State^.DtxGlobalState, DTX) = 0) or (FixedPoint.Sub(State^.DtxGlobalState, DtxMute) = 0)) and
    ((FixedPoint.Sub(FrameType, RxNoData) = 0) or (FixedPoint.Sub(FrameType, RxSpeechBad) = 0) or
    (FixedPoint.Sub(FrameType, RxOnset) = 0))) then
  begin
    NewState := DTX;
    if (FixedPoint.Sub(State^.DtxGlobalState, DtxMute) = 0) and
      ((FixedPoint.Sub(FrameType, RxSidBad) = 0) or (FixedPoint.Sub(FrameType, RxSidFirst) = 0) or
      (FixedPoint.Sub(FrameType, RxOnset) = 0) or (FixedPoint.Sub(FrameType, RxNoData) = 0)) then
      NewState := DtxMute;
    State^.SinceLastSid := FixedPoint.Add(State^.SinceLastSid, 1);
    if (FixedPoint.Sub(FrameType, RxSidUpdate) <> 0) and (FixedPoint.Sub(State^.SinceLastSid, 50) > 0) then
      NewState := DtxMute;
  end
  else
  begin
    NewState := SPEECH;
    State^.SinceLastSid := 0;
  end;
  if (State^.DataUpdated = 0) and (FixedPoint.Sub(FrameType, RxSidUpdate) = 0) then
    State^.DecAnaElapsedCount := 0;
  State^.DecAnaElapsedCount := FixedPoint.Add(State^.DecAnaElapsedCount, 1);
  State^.DtxHangoverAdded := 0;
  if (FixedPoint.Sub(FrameType, RxSidFirst) = 0) or (FixedPoint.Sub(FrameType, RxSidUpdate) = 0) or
    (FixedPoint.Sub(FrameType, RxSidBad) = 0) or (FixedPoint.Sub(FrameType, RxOnset) = 0) or
    (FixedPoint.Sub(FrameType, RxNoData) = 0) then
  begin
    EncState := DTX;
    if (FixedPoint.Sub(FrameType, RxNoData) = 0) and (FixedPoint.Sub(NewState, SPEECH) = 0) then
      EncState := SPEECH;
  end
  else
    EncState := SPEECH;
  if FixedPoint.Sub(EncState, SPEECH) = 0 then
    State^.DtxHangoverCount := 7
  else
  begin
    if FixedPoint.Sub(State^.DecAnaElapsedCount, ((24 + 7) - 1)) > 0 then
    begin
      State^.DtxHangoverAdded := 1;
      State^.DecAnaElapsedCount := 0;
      State^.DtxHangoverCount := 0;
    end
    else
    begin
      if Ord((State^.DtxHangoverCount = 0)) <> 0 then
        State^.DecAnaElapsedCount := 0
      else
        State^.DtxHangoverCount := FixedPoint.Sub(State^.DtxHangoverCount, 1);
    end;
  end;
  if FixedPoint.Sub(NewState, SPEECH) <> 0 then
  begin
    State^.SidFrame := 0;
    State^.ValidData := 0;
    if FixedPoint.Sub(FrameType, RxSidFirst) = 0 then
      State^.SidFrame := 1
    else
    begin
      if Ord((FixedPoint.Sub(FrameType, RxSidUpdate) = 0)) <> 0 then
      begin
        State^.SidFrame := 1;
        State^.ValidData := 1;
      end
      else
      begin
        if Ord((FixedPoint.Sub(FrameType, RxSidBad) = 0)) <> 0 then
        begin
          State^.SidFrame := 1;
          State^.DtxHangoverAdded := 0;
        end;
      end;
    end;
  end;
  Result := NewState;
end;

procedure AmrInitDPlsf3(State: PAMRDPlsfState; ArgIndex: SmallInt);
