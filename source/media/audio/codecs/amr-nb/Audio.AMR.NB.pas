unit Audio.AMR.NB;

interface

uses
  System.SysUtils;

const
  AMRNBSampleRate = 8000;
  AMRNBSamplesPerFrame = 160;
  AMRNBMaxSerialBits = 244;

{$SCOPEDENUMS ON}

type
  TAMRNBMode = (MR475, MR515, MR59, MR67, MR74, MR795, MR102, MR122);

  TAMRNBFrameKind = (SpeechGood, SpeechDegraded, Onset, SpeechBad,
    SIDFirst, SIDUpdate, SIDBad, NoData);

  TAMRNBPCM = array[0..AMRNBSamplesPerFrame - 1] of SmallInt;

  // Stateful mono decoder. Each call produces one 20 ms PCM frame.
  TAMRNBDecoder = class sealed
  private
    FState: Pointer;
    FHomed: Boolean;
    FOverflow: Integer;
    procedure Decode(Mode, Kind: Integer; var Bits: array of SmallInt; out PCM: TAMRNBPCM);
  public
    constructor Create;
    destructor Destroy; override;
    procedure Reset;
    // TS 26.073 serial order, one 0/1 value per word.
    procedure DecodeSerial(Mode: TAMRNBMode; Kind: TAMRNBFrameKind; const Bits: array of SmallInt; out PCM: TAMRNBPCM);
    // RFC 4867 mono storage frame including its one-byte header.
    procedure DecodeStorageFrame(const Frame: TBytes; out PCM: TAMRNBPCM);
    // Includes the frame header. A return value of zero means an invalid header.
    class function StorageFrameSize(Header: Byte): Integer; static;
  end;

implementation

uses
  Audio.AMR.FixedPoint;

{$POINTERMATH ON}
{$B-}

