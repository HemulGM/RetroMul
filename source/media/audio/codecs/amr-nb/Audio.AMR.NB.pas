function EvaluateLspChebyshev(X: SmallInt; F: PAMRSmallInt; N: SmallInt): SmallInt;
var
  I: SmallInt;
  Cheb: SmallInt;
  B0H: SmallInt;
  B0L: SmallInt;
  B1H: SmallInt;
  B1L: SmallInt;
  B2H: SmallInt;
  B2L: SmallInt;
  T0: Integer;
begin
  B2H := 256;
  B2L := 0;
  T0 := FixedPoint.LMult(X, 512);
  T0 := FixedPoint.LMac(T0, F[1], 8192);
  FixedPoint.LExtract(T0, PAMRSmallInt(@B1H), PAMRSmallInt(@B1L));
  I := 2;
  while I < N do
  begin
    T0 := FixedPoint.Mpy3216(B1H, B1L, X);
    T0 := FixedPoint.LShl(T0, 1);
    T0 := FixedPoint.LMac(T0, B2H, SmallInt($8000));
    T0 := FixedPoint.LMsu(T0, B2L, 1);
    T0 := FixedPoint.LMac(T0, F[I], 8192);
    FixedPoint.LExtract(T0, PAMRSmallInt(@B0H), PAMRSmallInt(@B0L));
    B2L := B1L;
    B2H := B1H;
    B1L := B0L;
    B1H := B0H;
    Inc(I);
  end;
  T0 := FixedPoint.Mpy3216(B1H, B1L, X);
  T0 := FixedPoint.LMac(T0, B2H, SmallInt($8000));
  T0 := FixedPoint.LMsu(T0, B2L, 1);
  T0 := FixedPoint.LMac(T0, F[I], 4096);
  T0 := FixedPoint.LShl(T0, 6);
  Cheb := AmrExtractH(T0);
  Result := Cheb;
end;

procedure AmrAzLsp(A, Lsp, OldLsp: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  Nf: SmallInt;
  Ip: SmallInt;
  Xlow: SmallInt;
  Ylow: SmallInt;
  Xhigh: SmallInt;
  Yhigh: SmallInt;
  Xmid: SmallInt;
  Ymid: SmallInt;
  Xint: SmallInt;
  X: SmallInt;
  Y: SmallInt;
  Sign: SmallInt;
  Exp: SmallInt;
  Coef: PAMRSmallInt;
  F1: array[0..5] of SmallInt;
  F2: array[0..5] of SmallInt;
  T0: Integer;
begin
  F1[0] := 1024;
  F2[0] := 1024;
  I := 0;
  while I < (10 div 2) do
  begin
    T0 := FixedPoint.LMult(A[I + 1], 8192);
    T0 := FixedPoint.LMac(T0, A[10 - I], 8192);
    X := AmrExtractH(T0);
    F1[I + 1] := FixedPoint.Sub(X, F1[I]);
    T0 := FixedPoint.LMult(A[I + 1], 8192);
    T0 := FixedPoint.LMsu(T0, A[10 - I], 8192);
    X := AmrExtractH(T0);
    F2[I + 1] := FixedPoint.Add(X, F2[I]);
    Inc(I);
  end;
  Nf := 0;
  Ip := 0;
  Coef := PAMRSmallInt(@F1[0]);
  Xlow := AzLspGrid[0];
  Ylow := EvaluateLspChebyshev(Xlow, Coef, (10 div 2));
  J := 0;
  while (FixedPoint.Sub(Nf, 10) < 0) and (FixedPoint.Sub(J, 60) < 0) do
  begin
    Inc(J);
    Xhigh := Xlow;
    Yhigh := Ylow;
    Xlow := AzLspGrid[J];
    Ylow := EvaluateLspChebyshev(Xlow, Coef, (10 div 2));
    if FixedPoint.LMult(Ylow, Yhigh) <= Integer(0) then
    begin
      I := 0;
      while I < 4 do
      begin
        Xmid := FixedPoint.Add(FixedPoint.ShiftRight(Xlow, 1), FixedPoint.ShiftRight(Xhigh, 1));
        Ymid := EvaluateLspChebyshev(Xmid, Coef, (10 div 2));
        if FixedPoint.LMult(Ylow, Ymid) <= Integer(0) then
        begin
          Yhigh := Ymid;
          Xhigh := Xmid;
        end
        else
        begin
          Ylow := Ymid;
          Xlow := Xmid;
        end;
        Inc(I);
      end;
      X := FixedPoint.Sub(Xhigh, Xlow);
      Y := FixedPoint.Sub(Yhigh, Ylow);
      if Y = 0 then
        Xint := Xlow
      else
      begin
        Sign := Y;
        Y := AmrAbsS(Y);
        Exp := AmrNormS(Y);
        Y := FixedPoint.ShiftLeft(Y, Exp);
        Y := FixedPoint.DivS(SmallInt(16383), Y);
        T0 := FixedPoint.LMult(X, Y);
        T0 := FixedPoint.LShr(T0, FixedPoint.Sub(20, Exp));
        Y := AmrExtractL(T0);
        if Sign < 0 then
          Y := AmrNegate(Y);
        T0 := FixedPoint.LMult(Ylow, Y);
        T0 := FixedPoint.LShr(T0, 11);
        Xint := FixedPoint.Sub(Xlow, AmrExtractL(T0));
      end;
      Lsp[Nf] := Xint;
      Xlow := Xint;
      Inc(Nf);
      if Ip = 0 then
      begin
        Ip := 1;
        Coef := PAMRSmallInt(@F2[0]);
      end
      else
      begin
        Ip := 0;
        Coef := PAMRSmallInt(@F1[0]);
      end;
      Ylow := EvaluateLspChebyshev(Xlow, Coef, (10 div 2));
    end;
  end;
  if FixedPoint.Sub(Nf, 10) < 0 then
  begin
    I := 0;
    while I < 10 do
    begin
      Lsp[I] := OldLsp[I];
      Inc(I);
    end;
  end;
end;

procedure GetLspPolynomial(Lsp: PAMRSmallInt; F: PAMRInteger);
var
  I: SmallInt;
  J: SmallInt;
  Hi: SmallInt;
  Lo: SmallInt;
  T0: Integer;
begin
  F^ := FixedPoint.LMult(4096, 2048);
  Inc(F);
  F^ := FixedPoint.LMsu(Integer(0), Lsp^, 512);
  Inc(F);
  Lsp := Lsp + 2;
  I := 2;
  while I <= 5 do
  begin
    F^ := F[-2];
    J := 1;
    while J < I do
    begin
      FixedPoint.LExtract(F[-1], PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
      T0 := FixedPoint.Mpy3216(Hi, Lo, Lsp^);
      T0 := FixedPoint.LShl(T0, 1);
      F^ := FixedPoint.LAdd(F^, F[-2]);
      F^ := FixedPoint.LSub(F^, T0);
      Inc(J);
      Dec(F);
    end;
    F^ := FixedPoint.LMsu(F^, Lsp^, 512);
    F := F + I;
    Lsp := Lsp + 2;
    Inc(I);
  end;
end;

procedure AmrLspAz(Lsp, A: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  F1: array[0..5] of Integer;
  F2: array[0..5] of Integer;
  T0: Integer;
begin
  GetLspPolynomial(PAMRSmallInt(@Lsp[0]), PAMRInteger(@F1[0]));
  GetLspPolynomial(PAMRSmallInt(@Lsp[1]), PAMRInteger(@F2[0]));
  I := 5;
  while I > 0 do
  begin
    F1[I] := FixedPoint.LAdd(F1[I], F1[I - 1]);
    F2[I] := FixedPoint.LSub(F2[I], F2[I - 1]);
    Dec(I);
  end;
  A[0] := 4096;
  I := 1;
  J := 10;
  while I <= 5 do
  begin
    T0 := FixedPoint.LAdd(F1[I], F2[I]);
    A[I] := AmrExtractL(FixedPoint.LShrR(T0, 13));
    T0 := FixedPoint.LSub(F1[I], F2[I]);
    A[J] := AmrExtractL(FixedPoint.LShrR(T0, 13));
    Inc(I);
    Dec(J);
  end;
end;

procedure AmrIntLpc1and32(LspOld, LspMid, LspNew, Az: PAMRSmallInt);
var
  I: SmallInt;
  Lsp: array[0..9] of SmallInt;
begin
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspMid[I], 1), FixedPoint.ShiftRight(LspOld[I], 1));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + ((10 + 1) * 2);
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspMid[I], 1), FixedPoint.ShiftRight(LspNew[I], 1));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
end;

procedure AmrLspLsf(Lsp, Lsf: PAMRSmallInt; M: SmallInt);
var
  I: SmallInt;
  Ind: SmallInt;
  LTmp: Integer;
begin
  Ind := 63;
  I := M - 1;
  while I >= 0 do
  begin
    while FixedPoint.Sub(LspLsfTable[Ind], Lsp[I]) < 0 do
    begin
      Dec(Ind);
    end;
    LTmp := FixedPoint.LMult(FixedPoint.Sub(Lsp[I], LspLsfTable[Ind]), LspLsfSlope[Ind]);
    Lsf[I] := FixedPoint.Round(FixedPoint.LShl(LTmp, 3));
    Lsf[I] := FixedPoint.Add(Lsf[I], FixedPoint.ShiftLeft(Ind, 8));
    Dec(I);
  end;
end;

procedure AmrLsfWt(Lsf, Wf: PAMRSmallInt);
var
  Temp: SmallInt;
  I: SmallInt;
begin
  Wf[0] := Lsf[1];
  I := 1;
  while I < 9 do
  begin
    Wf[I] := FixedPoint.Sub(Lsf[I + 1], Lsf[I - 1]);
    Inc(I);
  end;
  Wf[9] := FixedPoint.Sub(16384, Lsf[8]);
  I := 0;
  while I < 10 do
  begin
    Temp := FixedPoint.Sub(Wf[I], 1843);
    if Temp < 0 then
      Wf[I] := FixedPoint.Sub(3427, FixedPoint.Mult(Wf[I], 28160))
    else
      Wf[I] := FixedPoint.Sub(1843, FixedPoint.Mult(Temp, 6242));
    Wf[I] := FixedPoint.ShiftLeft(Wf[I], 3);
    Inc(I);
  end;
end;

function QuantizeLsf5Subvector(LsfR1, LsfR2, Dico, Wf1, Wf2: PAMRSmallInt; DicoSize: SmallInt): SmallInt;
var
  IndexValue: SmallInt;
  I: SmallInt;
  Temp: SmallInt;
  Codebook: PAMRSmallInt;
  DistMin: Integer;
  Dist: Integer;
begin
  IndexValue := 0;
  DistMin := Integer($7FFFFFFF);
  Codebook := Dico;
  I := 0;
  while I < DicoSize do
  begin
    Temp := FixedPoint.Sub(LsfR1[0], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf1[0], Temp);
    Dist := FixedPoint.LMult(Temp, Temp);
    Temp := FixedPoint.Sub(LsfR1[1], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf1[1], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    Temp := FixedPoint.Sub(LsfR2[0], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf2[0], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    Temp := FixedPoint.Sub(LsfR2[1], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf2[1], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    if FixedPoint.LSub(Dist, DistMin) < Integer(0) then
    begin
      DistMin := Dist;
      IndexValue := I;
    end;
    Inc(I);
  end;
  Codebook := PAMRSmallInt(@Dico[FixedPoint.ShiftLeft(IndexValue, 2)]);
  LsfR1[0] := Codebook^;
  Inc(Codebook);
  LsfR1[1] := Codebook^;
  Inc(Codebook);
  LsfR2[0] := Codebook^;
  Inc(Codebook);
  LsfR2[1] := Codebook^;
  Result := IndexValue;
end;

function QuantizeSignedLsf5Subvector(LsfR1, LsfR2, Dico, Wf1, Wf2: PAMRSmallInt; DicoSize: SmallInt): SmallInt;
var
  IndexValue: SmallInt;
  Sign: SmallInt;
  I: SmallInt;
  Temp: SmallInt;
  Codebook: PAMRSmallInt;
  DistMin: Integer;
  Dist: Integer;
begin
  IndexValue := 0;
  Sign := 0;
  DistMin := Integer($7FFFFFFF);
  Codebook := Dico;
  I := 0;
  while I < DicoSize do
  begin
    Temp := FixedPoint.Sub(LsfR1[0], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf1[0], Temp);
    Dist := FixedPoint.LMult(Temp, Temp);
    Temp := FixedPoint.Sub(LsfR1[1], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf1[1], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    Temp := FixedPoint.Sub(LsfR2[0], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf2[0], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    Temp := FixedPoint.Sub(LsfR2[1], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf2[1], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    if FixedPoint.LSub(Dist, DistMin) < Integer(0) then
    begin
      DistMin := Dist;
      IndexValue := I;
      Sign := 0;
    end;
    Codebook := Codebook - 4;
    Temp := FixedPoint.Add(LsfR1[0], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf1[0], Temp);
    Dist := FixedPoint.LMult(Temp, Temp);
    Temp := FixedPoint.Add(LsfR1[1], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf1[1], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    Temp := FixedPoint.Add(LsfR2[0], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf2[0], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    Temp := FixedPoint.Add(LsfR2[1], Codebook^);
    Inc(Codebook);
    Temp := FixedPoint.Mult(Wf2[1], Temp);
    Dist := FixedPoint.LMac(Dist, Temp, Temp);
    if FixedPoint.LSub(Dist, DistMin) < Integer(0) then
    begin
      DistMin := Dist;
      IndexValue := I;
      Sign := 1;
    end;
    Inc(I);
  end;
  Codebook := PAMRSmallInt(@Dico[FixedPoint.ShiftLeft(IndexValue, 2)]);
  if Sign = 0 then
  begin
    LsfR1[0] := Codebook^;
    Inc(Codebook);
    LsfR1[1] := Codebook^;
    Inc(Codebook);
    LsfR2[0] := Codebook^;
    Inc(Codebook);
    LsfR2[1] := Codebook^;
  end
  else
  begin
    LsfR1[0] := AmrNegate(Codebook^);
    Inc(Codebook);
    LsfR1[1] := AmrNegate(Codebook^);
    Inc(Codebook);
    LsfR2[0] := AmrNegate(Codebook^);
    Inc(Codebook);
    LsfR2[1] := AmrNegate(Codebook^);
  end;
  IndexValue := FixedPoint.ShiftLeft(IndexValue, 1);
  IndexValue := FixedPoint.Add(IndexValue, Sign);
  Result := IndexValue;
end;

procedure AmrReorderLsf(Lsf: PAMRSmallInt; MinDist, N: SmallInt);
var
  I: SmallInt;
  LsfMin: SmallInt;
begin
  LsfMin := MinDist;
  I := 0;
  while I < N do
  begin
    if FixedPoint.Sub(Lsf[I], LsfMin) < 0 then
      Lsf[I] := LsfMin;
    LsfMin := FixedPoint.Add(Lsf[I], MinDist);
    Inc(I);
  end;
end;

procedure AmrLsfLsp(Lsf, Lsp: PAMRSmallInt; M: SmallInt);
var
  I: SmallInt;
  Ind: SmallInt;
  Offset: SmallInt;
  LTmp: Integer;
begin
  I := 0;
  while I < M do
  begin
    Ind := FixedPoint.ShiftRight(Lsf[I], 8);
    Offset := Lsf[I] and $FF;
    LTmp := FixedPoint.LMult(FixedPoint.Sub(LspLsfTable[Ind + 1], LspLsfTable[Ind]), Offset);
    Lsp[I] := FixedPoint.Add(LspLsfTable[Ind], AmrExtractL(FixedPoint.LShr(LTmp, 9)));
    Inc(I);
  end;
end;

procedure AmrQPlsf5(State: PAMRQPlsfState; Lsp1, Lsp2, Lsp1Q, Lsp2Q, Indice: PAMRSmallInt);
var
  I: SmallInt;
  Lsf1: array[0..9] of SmallInt;
  Lsf2: array[0..9] of SmallInt;
  Wf1: array[0..9] of SmallInt;
  Wf2: array[0..9] of SmallInt;
  LsfP: array[0..9] of SmallInt;
  LsfR1: array[0..9] of SmallInt;
  LsfR2: array[0..9] of SmallInt;
  Lsf1Q: array[0..9] of SmallInt;
  Lsf2Q: array[0..9] of SmallInt;
begin
  AmrLspLsf(Lsp1, PAMRSmallInt(@Lsf1[0]), 10);
  AmrLspLsf(Lsp2, PAMRSmallInt(@Lsf2[0]), 10);
  AmrLsfWt(PAMRSmallInt(@Lsf1[0]), PAMRSmallInt(@Wf1[0]));
  AmrLsfWt(PAMRSmallInt(@Lsf2[0]), PAMRSmallInt(@Wf2[0]));
  I := 0;
  while I < 10 do
  begin
    LsfP[I] := FixedPoint.Add(QPlsf5MeanLsf[I], FixedPoint.Mult(State^.PastRq[I], 21299));
    LsfR1[I] := FixedPoint.Sub(Lsf1[I], LsfP[I]);
    LsfR2[I] := FixedPoint.Sub(Lsf2[I], LsfP[I]);
    Inc(I);
  end;
  Indice[0] := QuantizeLsf5Subvector(PAMRSmallInt(@LsfR1[0]), PAMRSmallInt(@LsfR2[0]),
      PAMRSmallInt(@QPlsf5Dico1Lsf[0]), PAMRSmallInt(@Wf1[0]), PAMRSmallInt(@Wf2[0]), 128);
  Indice[1] := QuantizeLsf5Subvector(PAMRSmallInt(@LsfR1[2]), PAMRSmallInt(@LsfR2[2]),
      PAMRSmallInt(@QPlsf5Dico2Lsf[0]), PAMRSmallInt(@Wf1[2]), PAMRSmallInt(@Wf2[2]), 256);
  Indice[2] := QuantizeSignedLsf5Subvector(PAMRSmallInt(@LsfR1[4]), PAMRSmallInt(@LsfR2[4]),
      PAMRSmallInt(@QPlsf5Dico3Lsf[0]), PAMRSmallInt(@Wf1[4]), PAMRSmallInt(@Wf2[4]), 256);
  Indice[3] := QuantizeLsf5Subvector(PAMRSmallInt(@LsfR1[6]), PAMRSmallInt(@LsfR2[6]),
      PAMRSmallInt(@QPlsf5Dico4Lsf[0]), PAMRSmallInt(@Wf1[6]), PAMRSmallInt(@Wf2[6]), 256);
  Indice[4] := QuantizeLsf5Subvector(PAMRSmallInt(@LsfR1[8]), PAMRSmallInt(@LsfR2[8]),
      PAMRSmallInt(@QPlsf5Dico5Lsf[0]), PAMRSmallInt(@Wf1[8]), PAMRSmallInt(@Wf2[8]), 64);
  I := 0;
  while I < 10 do
  begin
    Lsf1Q[I] := FixedPoint.Add(LsfR1[I], LsfP[I]);
    Lsf2Q[I] := FixedPoint.Add(LsfR2[I], LsfP[I]);
    State^.PastRq[I] := LsfR2[I];
    Inc(I);
  end;
  AmrReorderLsf(PAMRSmallInt(@Lsf1Q[0]), 205, 10);
  AmrReorderLsf(PAMRSmallInt(@Lsf2Q[0]), 205, 10);
  AmrLsfLsp(PAMRSmallInt(@Lsf1Q[0]), Lsp1Q, 10);
  AmrLsfLsp(PAMRSmallInt(@Lsf2Q[0]), Lsp2Q, 10);
end;

procedure AmrIntLpc1and3(LspOld, LspMid, LspNew, Az: PAMRSmallInt);
var
  I: SmallInt;
  Lsp: array[0..9] of SmallInt;
begin
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspMid[I], 1), FixedPoint.ShiftRight(LspOld[I], 1));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  AmrLspAz(LspMid, Az);
  Az := Az + (10 + 1);
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspMid[I], 1), FixedPoint.ShiftRight(LspNew[I], 1));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  AmrLspAz(LspNew, Az);
end;

procedure AmrIntLpc1to32(LspOld, LspNew, Az: PAMRSmallInt);
var
  I: SmallInt;
  Lsp: array[0..9] of SmallInt;
begin
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspNew[I], 2), FixedPoint.Sub(LspOld[I], FixedPoint.ShiftRight(LspOld[I], 2)));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspOld[I], 1), FixedPoint.ShiftRight(LspNew[I], 1));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspOld[I], 2), FixedPoint.Sub(LspNew[I], FixedPoint.ShiftRight(LspNew[I], 2)));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
end;

function QuantizeLsfSubvector3(LsfR1, Dico, Wf1: PAMRSmallInt; DicoSize: SmallInt; UseHalf: Integer): SmallInt;
var
  I: SmallInt;
  IndexValue: SmallInt;
  Codebook: PAMRSmallInt;
  Temp: SmallInt;
  DistMin: Integer;
  Dist: Integer;
begin
  IndexValue := 0;
  DistMin := Integer($7FFFFFFF);
  Codebook := Dico;
  if UseHalf = 0 then
  begin
    I := 0;
    while I < DicoSize do
    begin
      Temp := FixedPoint.Sub(LsfR1[0], Codebook^);
      Inc(Codebook);
      Temp := FixedPoint.Mult(Wf1[0], Temp);
      Dist := FixedPoint.LMult(Temp, Temp);
      Temp := FixedPoint.Sub(LsfR1[1], Codebook^);
      Inc(Codebook);
      Temp := FixedPoint.Mult(Wf1[1], Temp);
      Dist := FixedPoint.LMac(Dist, Temp, Temp);
      Temp := FixedPoint.Sub(LsfR1[2], Codebook^);
      Inc(Codebook);
      Temp := FixedPoint.Mult(Wf1[2], Temp);
      Dist := FixedPoint.LMac(Dist, Temp, Temp);
      if FixedPoint.LSub(Dist, DistMin) < Integer(0) then
      begin
        DistMin := Dist;
        IndexValue := I;
      end;
      Inc(I);
    end;
    Codebook := PAMRSmallInt(@Dico[FixedPoint.Add(IndexValue, FixedPoint.Add(IndexValue, IndexValue))]);
  end
  else
  begin
    I := 0;
    while I < DicoSize do
    begin
      Temp := FixedPoint.Sub(LsfR1[0], Codebook^);
      Inc(Codebook);
      Temp := FixedPoint.Mult(Wf1[0], Temp);
      Dist := FixedPoint.LMult(Temp, Temp);
      Temp := FixedPoint.Sub(LsfR1[1], Codebook^);
      Inc(Codebook);
      Temp := FixedPoint.Mult(Wf1[1], Temp);
      Dist := FixedPoint.LMac(Dist, Temp, Temp);
      Temp := FixedPoint.Sub(LsfR1[2], Codebook^);
      Inc(Codebook);
      Temp := FixedPoint.Mult(Wf1[2], Temp);
      Dist := FixedPoint.LMac(Dist, Temp, Temp);
      if FixedPoint.LSub(Dist, DistMin) < Integer(0) then
      begin
        DistMin := Dist;
        IndexValue := I;
      end;
      Codebook := Codebook + 3;
      FixedPoint.Add(0, 0);
      Inc(I);
    end;
    Codebook := PAMRSmallInt(@Dico[FixedPoint.ShiftLeft(FixedPoint.Add(IndexValue, FixedPoint.Add(IndexValue, IndexValue)), 1)]);
  end;
  LsfR1[0] := Codebook^;
  Inc(Codebook);
  LsfR1[1] := Codebook^;
  Inc(Codebook);
  LsfR1[2] := Codebook^;
  Result := IndexValue;
end;

