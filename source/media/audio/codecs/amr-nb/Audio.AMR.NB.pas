procedure AmrQPlsf3(State: PAMRQPlsfState; Mode: Integer; Lsp1, Lsp1Q, Indice, PredInitI: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  Lsf1: array[0..9] of SmallInt;
  Wf1: array[0..9] of SmallInt;
  LsfP: array[0..9] of SmallInt;
  LsfR1: array[0..9] of SmallInt;
  Lsf1Q: array[0..9] of SmallInt;
  LPredInitErr: Integer;
  LMinPredInitErr: Integer;
  TempR1: array[0..9] of SmallInt;
  TempP: array[0..9] of SmallInt;
begin
  AmrLspLsf(Lsp1, PAMRSmallInt(@Lsf1[0]), 10);
  AmrLsfWt(PAMRSmallInt(@Lsf1[0]), PAMRSmallInt(@Wf1[0]));
  if Ord((FixedPoint.Sub(Mode, MRDTX) <> 0)) <> 0 then
  begin
    I := 0;
    while I < 10 do
    begin
      LsfP[I] := FixedPoint.Add(QPlsf3MeanLsf[I], FixedPoint.Mult(State^.PastRq[I], QPlsf3PredFac[I]));
      LsfR1[I] := FixedPoint.Sub(Lsf1[I], LsfP[I]);
      Inc(I);
    end;
  end
  else
  begin
    PredInitI^ := 0;
    LMinPredInitErr := $7FFFFFFF;
    for J := 0 to 7 do
    begin
      LPredInitErr := 0;
      I := 0;
      while I < 10 do
      begin
        TempP[I] := FixedPoint.Add(QPlsf3MeanLsf[I], QPlsf3PastRqInit[(J * 10) + I]);
        TempR1[I] := FixedPoint.Sub(Lsf1[I], TempP[I]);
        LPredInitErr := FixedPoint.LMac(LPredInitErr, TempR1[I], TempR1[I]);
        Inc(I);
      end;
      if FixedPoint.LSub(LPredInitErr, LMinPredInitErr) < Integer(0) then
      begin
        LMinPredInitErr := LPredInitErr;
        CopySamples(PAMRSmallInt(@TempR1[0]), PAMRSmallInt(@LsfR1[0]), 10);
        CopySamples(PAMRSmallInt(@TempP[0]), PAMRSmallInt(@LsfP[0]), 10);
        CopySamples(PAMRSmallInt(@QPlsf3PastRqInit[J * 10]), PAMRSmallInt(@State^.PastRq[0]), 10);
        PredInitI^ := J;
      end;
    end;
  end;
  if (FixedPoint.Sub(Mode, MR475) = 0) or (FixedPoint.Sub(Mode, MR515) = 0) then
  begin
    Indice[0] := QuantizeLsfSubvector3(PAMRSmallInt(@LsfR1[0]), PAMRSmallInt(@QPlsf3Dico1Lsf[0]),
        PAMRSmallInt(@Wf1[0]), 256, 0);
    Indice[1] := QuantizeLsfSubvector3(PAMRSmallInt(@LsfR1[3]), PAMRSmallInt(@QPlsf3Dico2Lsf[0]),
        PAMRSmallInt(@Wf1[3]), (512 div 2), 1);
    Indice[2] := QuantizeLsfSubvector4(PAMRSmallInt(@LsfR1[6]), PAMRSmallInt(@QPlsf3Mr5153Lsf[0]),
        PAMRSmallInt(@Wf1[6]), 128);
  end
  else
  begin
    if FixedPoint.Sub(Mode, MR795) = 0 then
    begin
      Indice[0] := QuantizeLsfSubvector3(PAMRSmallInt(@LsfR1[0]), PAMRSmallInt(@QPlsf3Mr7951Lsf[0]),
          PAMRSmallInt(@Wf1[0]), 512, 0);
      Indice[1] := QuantizeLsfSubvector3(PAMRSmallInt(@LsfR1[3]), PAMRSmallInt(@QPlsf3Dico2Lsf[0]),
          PAMRSmallInt(@Wf1[3]), 512, 0);
      Indice[2] := QuantizeLsfSubvector4(PAMRSmallInt(@LsfR1[6]), PAMRSmallInt(@QPlsf3Dico3Lsf[0]),
          PAMRSmallInt(@Wf1[6]), 512);
    end
    else
    begin
      Indice[0] := QuantizeLsfSubvector3(PAMRSmallInt(@LsfR1[0]), PAMRSmallInt(@QPlsf3Dico1Lsf[0]),
          PAMRSmallInt(@Wf1[0]), 256, 0);
      Indice[1] := QuantizeLsfSubvector3(PAMRSmallInt(@LsfR1[3]), PAMRSmallInt(@QPlsf3Dico2Lsf[0]),
          PAMRSmallInt(@Wf1[3]), 512, 0);
      Indice[2] := QuantizeLsfSubvector4(PAMRSmallInt(@LsfR1[6]), PAMRSmallInt(@QPlsf3Dico3Lsf[0]),
          PAMRSmallInt(@Wf1[6]), 512);
    end;
  end;
  I := 0;
  while I < 10 do
  begin
    Lsf1Q[I] := FixedPoint.Add(LsfR1[I], LsfP[I]);
    State^.PastRq[I] := LsfR1[I];
    Inc(I);
  end;
  AmrReorderLsf(PAMRSmallInt(@Lsf1Q[0]), 205, 10);
  AmrLsfLsp(PAMRSmallInt(@Lsf1Q[0]), Lsp1Q, 10);
end;

procedure AmrIntLpc1to3(LspOld, LspNew, Az: PAMRSmallInt);
var
  I: SmallInt;
  Lsp: array[0..9] of SmallInt;
begin
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspNew[I], 2), FixedPoint.Sub(LspOld[I], FixedPoint.ShiftRight(LspOld[I], 2)));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspOld[I], 1), FixedPoint.ShiftRight(LspNew[I], 1));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  I := 0;
  while I < 10 do
  begin
    Lsp[I] := FixedPoint.Add(FixedPoint.ShiftRight(LspOld[I], 2), FixedPoint.Sub(LspNew[I], FixedPoint.ShiftRight(LspNew[I], 2)));
    Inc(I);
  end;
  AmrLspAz(PAMRSmallInt(@Lsp[0]), Az);
  Az := Az + (10 + 1);
  AmrLspAz(LspNew, Az);
end;

function AmrLsp(State: PAMRlspState; ReqMode, UsedMode: Integer; Az, AzQ, LspNew: PAMRSmallInt; Anap: PPAMRSmallInt): Integer;
var
  LspNewQ: array[0..9] of SmallInt;
  LspMid: array[0..9] of SmallInt;
  LspMidQ: array[0..9] of SmallInt;
  PredInitI: SmallInt;
begin
  if FixedPoint.Sub(ReqMode, MR122) = 0 then
  begin
    AmrAzLsp(PAMRSmallInt(@Az[10 + 1]), PAMRSmallInt(@LspMid[0]), PAMRSmallInt(@State^.LspOld[0]));
    AmrAzLsp(PAMRSmallInt(@Az[(10 + 1) * 3]), LspNew, PAMRSmallInt(@LspMid[0]));
    AmrIntLpc1and32(PAMRSmallInt(@State^.LspOld[0]), PAMRSmallInt(@LspMid[0]), LspNew, Az);
    if FixedPoint.Sub(UsedMode, MRDTX) <> 0 then
    begin
      AmrQPlsf5(State^.QSt, PAMRSmallInt(@LspMid[0]), LspNew, PAMRSmallInt(@LspMidQ[0]),
        PAMRSmallInt(@LspNewQ[0]), Anap^);
      AmrIntLpc1and3(PAMRSmallInt(@State^.LspOldQ[0]), PAMRSmallInt(@LspMidQ[0]), PAMRSmallInt(@LspNewQ[0]), AzQ);
      Anap^ := Anap^ + FixedPoint.Add(0, 5);
    end;
  end
  else
  begin
    AmrAzLsp(PAMRSmallInt(@Az[(10 + 1) * 3]), LspNew, PAMRSmallInt(@State^.LspOld[0]));
    AmrIntLpc1to32(PAMRSmallInt(@State^.LspOld[0]), LspNew, Az);
    if FixedPoint.Sub(UsedMode, MRDTX) <> 0 then
    begin
      AmrQPlsf3(State^.QSt, ReqMode, LspNew, PAMRSmallInt(@LspNewQ[0]), Anap^, PAMRSmallInt(@PredInitI));
      AmrIntLpc1to3(PAMRSmallInt(@State^.LspOldQ[0]), PAMRSmallInt(@LspNewQ[0]), AzQ);
      Anap^ := Anap^ + FixedPoint.Add(0, 3);
    end;
  end;
  CopySamples(LspNew, PAMRSmallInt(@State^.LspOld[0]), 10);
  CopySamples(PAMRSmallInt(@LspNewQ[0]), PAMRSmallInt(@State^.LspOldQ[0]), 10);
  Result := 0;
end;

function AmrDtxDecReset(State: PAMRdtxDecState): Integer;
var
  I: Integer;
begin
  if State = nil then
    Exit(-1);
  State^.SinceLastSid := 0;
  State^.TrueSidPeriodInv := 1 shl 13;
  State^.LogEn := 3500;
  State^.OldLogEn := 3500;
  State^.LPnSeedRx := $70816958;
  CopySamples(PAMRSmallInt(@DtxDecLspInitData[0]), PAMRSmallInt(@State^.Lsp[0]), 10);
  CopySamples(PAMRSmallInt(@DtxDecLspInitData[0]), PAMRSmallInt(@State^.LspOld[0]), 10);
  State^.LsfHistPtr := 0;
  State^.LogPgMean := 0;
  State^.LogEnHistPtr := 0;
  CopySamples(PAMRSmallInt(@DtxDecMeanLsf[0]), PAMRSmallInt(@State^.LsfHist[0]), 10);
  I := 1;
  while I < 8 do
  begin
    CopySamples(PAMRSmallInt(@State^.LsfHist[0]), PAMRSmallInt(@State^.LsfHist[10 * I]), 10);
    Inc(I);
  end;
  ZeroSamples(PAMRSmallInt(@State^.LsfHistMean[0]), (10 * 8));
  I := 0;
  while I < 8 do
  begin
    State^.LogEnHist[I] := State^.LogEn;
    Inc(I);
