  SpeechBits: array[TAMRWBMode] of SmallInt = (132, 177, 253, 285, 317, 365, 397, 461, 477);
  SIDBits = 35;
  SIDFrame = 9;
  LostFrame = 14;
  NoDataFrame = 15;
  SerialZero = -127;
  SerialOne = 127;

{$IFOPT Q+}{$DEFINE AMRWB_RESTORE_Q}{$ENDIF}
{$IFOPT R+}{$DEFINE AMRWB_RESTORE_R}{$ENDIF}
{$Q-}
{$R-}

