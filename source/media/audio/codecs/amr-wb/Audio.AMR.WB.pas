  begin
    IsfQ[I + 5] := QisfNsDico3IsfNoise[((Indice[2] * 3) + I)];
    Inc(I);
  end;
  I := 0;
  while I < 4 do
  begin
    IsfQ[I + 8] := QisfNsDico4IsfNoise[((Indice[3] * 4) + I)];
    Inc(I);
  end;
  I := 0;
  while I < 4 do
  begin
    IsfQ[I + 12] := QisfNsDico5IsfNoise[((Indice[4] * 4) + I)];
