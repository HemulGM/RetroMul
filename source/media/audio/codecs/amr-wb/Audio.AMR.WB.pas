function Allocate(Size: NativeInt): Pointer;
begin
  try
    Result := AllocMem(Size);
  except
    on EOutOfMemory do
      Result := nil;
  end;
end;

procedure CopySamples(Source, Dest: PAMRSmallInt; Count: SmallInt);
begin
  for var I := 0 to Count - 1 do
    Dest[I] := Source[I];
end;

function AmrDtxDecReset(State: PAMRdtxDecState; IsfInit: PAMRSmallInt): SmallInt;
var
  I: SmallInt;
begin
  if State = nil then
    Exit(-1);
  State^.SinceLastSid := 0;
  State^.TrueSidPeriodInv := 1 shl 13;
  State^.LogEn := 3500;
  State^.OldLogEn := 3500;
  State^.CngSeed := 21845;
  State^.HistPtr := 0;
  CopySamples(IsfInit, PAMRSmallInt(@State^.Isf[0]), 16);
  CopySamples(IsfInit, PAMRSmallInt(@State^.IsfOld[0]), 16);
  for I := 0 to 7 do
  begin
    CopySamples(IsfInit, PAMRSmallInt(@State^.IsfHist[I * 16]), 16);
    State^.LogEnHist[I] := SignedRightShift(3500, 3);
  end;
  State^.DtxHangoverCount := 7;
  State^.DecAnaElapsedCount := 32767;
  State^.SidFrame := 0;
  State^.ValidData := 0;
  State^.DtxHangoverAdded := 0;
  State^.DtxGlobalState := 0;
  State^.DataUpdated := 0;
  State^.DitherSeed := 21845;
  State^.CNDith := 0;
  State^.DtxVadHist := 0;
  Result := 0;
end;

function AmrDtxDecInit(State: PPAMRdtxDecState; IsfInit: PAMRSmallInt): SmallInt;
var
  S: PAMRdtxDecState;
begin
  if State = nil then
    Exit(-1);
  State^ := nil;
  S := PAMRdtxDecState(Allocate(SizeOf(TAMRdtxDecState)));
  if S = nil then
    Exit(-1);
  AmrDtxDecReset(S, IsfInit);
  State^ := S;
  Result := 0;
end;

