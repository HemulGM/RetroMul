unit Audio.AMR.WB;

interface

uses
  System.SysUtils;

const
  AMRWBSampleRate = 16000;
  AMRWBSamplesPerFrame = 320;
  AMRWBMaxSerialBits = 477;

{$SCOPEDENUMS ON}

type
  TAMRWBMode = (MR660, MR885, MR1265, MR1425, MR1585, MR1825, MR1985, MR2305, MR2385);

  TAMRWBFrameKind = (SpeechGood, SpeechDegraded, SpeechLost, SpeechBad,
    SIDFirst, SIDUpdate, SIDBad, NoData);

  TAMRWBPCM = array[0..AMRWBSamplesPerFrame - 1] of SmallInt;

  // Create a separate decoder for each channel. Each frame represents 20 ms.
  TAMRWBDecoder = class sealed
  private
    FState: Pointer;
    FHomed: Boolean;
    FPreviousMode: SmallInt;
    procedure Decode(Mode: SmallInt; Kind: TAMRWBFrameKind; var Bits: array of SmallInt; out PCM: TAMRWBPCM);
  public
    constructor Create;
    destructor Destroy; override;
    procedure Reset;
    // TS 26.173 serial order, one 0 or 1 per entry.
    procedure DecodeSerial(Mode: TAMRWBMode; Kind: TAMRWBFrameKind; const Bits: array of SmallInt; out PCM: TAMRWBPCM);
    // A complete RFC 4867 frame, including its one-byte header.
    procedure DecodeStorageFrame(const Frame: TBytes; out PCM: TAMRWBPCM);
    class function StorageFrameSize(Header: Byte): Integer; static;
  end;

implementation

uses
  Audio.AMR.FixedPoint;

{$POINTERMATH ON}
{$B-}

