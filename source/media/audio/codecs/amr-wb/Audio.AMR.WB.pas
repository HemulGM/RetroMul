procedure InitDecoder(SpdState: PAMRPointer);
var
  State: PAMRDecoderState;
begin
  SpdState^ := nil;
  State := PAMRDecoderState(Allocate(SizeOf(TAMRDecoderState)));
  if State = nil then
    Exit;
  State^.DtxDecSt := nil;
  if AmrDtxDecInit(PPAMRdtxDecState(@State^.DtxDecSt),
    PAMRSmallInt(@DecMainIsfInit[0])) <> 0 then
  begin
    FreeMem(State);
    Exit;
  end;
  ResetDecoder(Pointer(State), 1);
  SpdState^ := Pointer(State);
end;

procedure AmrDtxDecExit(State: PPAMRdtxDecState);
begin
  if (State = nil) or (State^ = nil) then
    Exit;
  FreeMem(State^);
  State^ := nil;
end;

procedure FreeDecoder(SpdState: Pointer);
begin
  AmrDtxDecExit(PPAMRdtxDecState(@PAMRDecoderState(SpdState)^.DtxDecSt));
  FreeMem(SpdState);
end;

function AmrRxDtxHandler(State: PAMRdtxDecState; FrameType: SmallInt): SmallInt;
var
  NewState: SmallInt;
  EncState: SmallInt;
begin
  if (FixedPoint.Sub(FrameType, 4) = 0) or (FixedPoint.Sub(FrameType, 5) = 0) or (FixedPoint.Sub(FrameType, 6) = 0) or
    (((FixedPoint.Sub(State^.DtxGlobalState, 1) = 0) or (FixedPoint.Sub(State^.DtxGlobalState, 2) = 0)) and
    ((FixedPoint.Sub(FrameType, 7) = 0) or (FixedPoint.Sub(FrameType, 3) = 0) or (FixedPoint.Sub(FrameType, 2) = 0))) then
  begin
    NewState := 1;
    if (FixedPoint.Sub(State^.DtxGlobalState, 2) = 0) and
      ((FixedPoint.Sub(FrameType, 6) = 0) or (FixedPoint.Sub(FrameType, 4) = 0) or (FixedPoint.Sub(FrameType, 2) = 0) or
      (FixedPoint.Sub(FrameType, 7) = 0)) then
      NewState := 2;
    State^.SinceLastSid := FixedPoint.Add(State^.SinceLastSid, 1);
    if (FixedPoint.Sub(FrameType, 5) <> 0) and (FixedPoint.Sub(State^.SinceLastSid, 50) > 0) then
      NewState := 2;
  end
  else
  begin
    NewState := 0;
    State^.SinceLastSid := 0;
  end;
  if (State^.DataUpdated = 0) and (FixedPoint.Sub(FrameType, 5) = 0) then
    State^.DecAnaElapsedCount := 0;
  State^.DecAnaElapsedCount := FixedPoint.Add(State^.DecAnaElapsedCount, 1);
  State^.DtxHangoverAdded := 0;
  if (FixedPoint.Sub(FrameType, 4) = 0) or (FixedPoint.Sub(FrameType, 5) = 0) or (FixedPoint.Sub(FrameType, 6) = 0) or
    ((FixedPoint.Sub(FrameType, 7) = 0) and
    ((FixedPoint.Sub(State^.DtxGlobalState, 0) <> 0) or (FixedPoint.Sub(State^.DtxVadHist, 7) >= 0))) then
    EncState := 1
  else
    EncState := 0;
  if FixedPoint.Sub(EncState, 0) = 0 then
    State^.DtxHangoverCount := 7
  else
  begin
    if FixedPoint.Sub(State^.DecAnaElapsedCount, ((24 + 7) - 1)) > 0 then
    begin
      State^.DtxHangoverAdded := 1;
      State^.DecAnaElapsedCount := 0;
      State^.DtxHangoverCount := 0;
    end
    else
    begin
      if Ord((State^.DtxHangoverCount = 0)) <> 0 then
        State^.DecAnaElapsedCount := 0
      else
        State^.DtxHangoverCount := FixedPoint.Sub(State^.DtxHangoverCount, 1);
    end;
  end;
  if FixedPoint.Sub(NewState, 0) <> 0 then
  begin
    State^.SidFrame := 0;
    State^.ValidData := 0;
    if FixedPoint.Sub(FrameType, 4) = 0 then
      State^.SidFrame := 1
    else
    begin
      if Ord((FixedPoint.Sub(FrameType, 5) = 0)) <> 0 then
      begin
        State^.SidFrame := 1;
        State^.ValidData := 1;
      end
      else
      begin
        if Ord((FixedPoint.Sub(FrameType, 6) = 0)) <> 0 then
        begin
          State^.SidFrame := 1;
          State^.DtxHangoverAdded := 0;
        end;
      end;
    end;
  end;
  Result := NewState;
end;

function ReadSerialParameter(BitCount: SmallInt; var Parameters: PAMRSmallInt): SmallInt;
var
  Value: SmallInt;
  I: SmallInt;
  Bit: SmallInt;
begin
  Value := 0;
  I := 0;
  while I < BitCount do
  begin
    Value := FixedPoint.ShiftLeft(Value, 1);
    Bit := Parameters^;
    Inc(Parameters);
    if Bit = SmallInt(127) then
      Value := FixedPoint.Add(Value, 1);
    Inc(I);
  end;
  Result := Value;
end;

procedure AmrReorderIsf(Isf: PAMRSmallInt; MinDist, N: SmallInt);
var
  I: SmallInt;
  IsfMin: SmallInt;
begin
  IsfMin := MinDist;
  I := 0;
  while I < (N - 1) do
  begin
    if FixedPoint.Sub(Isf[I], IsfMin) < 0 then
      Isf[I] := IsfMin;
    IsfMin := FixedPoint.Add(Isf[I], MinDist);
    Inc(I);
  end;
end;

