function AmrRandom(Seed: PAMRSmallInt): SmallInt;
begin
  Seed^ := AmrExtractL(FixedPoint.LAdd(FixedPoint.LShr(FixedPoint.LMult(Seed^, 31821), 1), 13849));
  Result := Seed^;
end;

function AmrMultR(Left, Right: SmallInt): SmallInt;
var
  Value: SmallInt;
  LProductArr: Integer;
begin
  LProductArr := Integer(Left) * Integer(Right);
  LProductArr := LProductArr + Integer($4000);
  LProductArr := LProductArr and Integer($FFFF8000);
  LProductArr := SignedRightShift(LProductArr, 15);
  if (LProductArr and Integer($10000)) <> 0 then
    LProductArr := LProductArr or Integer($FFFF0000);
  Value := FixedPoint.Saturate(LProductArr);
  Result := Value;
end;

procedure DitherComfortNoise(Isf: PAMRSmallInt; LLogEnInt: PAMRInteger; DitherSeed: PAMRSmallInt);
var
  Temp: SmallInt;
  Temp1: SmallInt;
  I: SmallInt;
  DitherFac: SmallInt;
  RandDith: SmallInt;
  RandDith2: SmallInt;
begin
  RandDith := FixedPoint.ShiftRight(AmrRandom(DitherSeed), 1);
  RandDith2 := FixedPoint.ShiftRight(AmrRandom(DitherSeed), 1);
  RandDith := FixedPoint.Add(RandDith, RandDith2);
  LLogEnInt^ := FixedPoint.LAdd(LLogEnInt^, FixedPoint.LMult(RandDith, 75));
  if LLogEnInt^ < 0 then
    LLogEnInt^ := 0;
  DitherFac := 256;
  RandDith := FixedPoint.ShiftRight(AmrRandom(DitherSeed), 1);
  RandDith2 := FixedPoint.ShiftRight(AmrRandom(DitherSeed), 1);
  RandDith := FixedPoint.Add(RandDith, RandDith2);
  Temp := FixedPoint.Add(Isf[0], AmrMultR(RandDith, DitherFac));
  if FixedPoint.Sub(Temp, 128) < 0 then
    Isf[0] := 128
  else
    Isf[0] := Temp;
  I := 1;
  while I < (16 - 1) do
  begin
    DitherFac := FixedPoint.Add(DitherFac, 2);
    RandDith := FixedPoint.ShiftRight(AmrRandom(DitherSeed), 1);
    RandDith2 := FixedPoint.ShiftRight(AmrRandom(DitherSeed), 1);
    RandDith := FixedPoint.Add(RandDith, RandDith2);
    Temp := FixedPoint.Add(Isf[I], AmrMultR(RandDith, DitherFac));
    Temp1 := FixedPoint.Sub(Temp, Isf[I - 1]);
    if FixedPoint.Sub(Temp1, 448) < 0 then
      Isf[I] := FixedPoint.Add(Isf[I - 1], 448)
    else
      Isf[I] := Temp;
    Inc(I);
  end;
  if FixedPoint.Sub(Isf[16 - 2], 16384) > 0 then
    Isf[16 - 2] := 16384;
end;

function AmrDotProduct12(X, Y: PAMRSmallInt; Lg: SmallInt; Exp: PAMRSmallInt): Integer;
var
  I: SmallInt;
  Sft: SmallInt;
  LSum: Integer;
begin
  LSum := 1;
  I := 0;
  while I < Lg do
  begin
    LSum := FixedPoint.LMac(LSum, X[I], Y[I]);
    Inc(I);
  end;
  Sft := AmrNormL(LSum);
  LSum := FixedPoint.LShl(LSum, Sft);
  Exp^ := FixedPoint.Sub(30, Sft);
  Result := LSum;
end;

procedure AmrIsqrtN(Frac: PAMRInteger; Exp: PAMRSmallInt);
var
  I: SmallInt;
  A: SmallInt;
  Tmp: SmallInt;
begin
  if Frac^ <= Integer(0) then
  begin
    Exp^ := 0;
    Frac^ := $7FFFFFFF;
    Exit;
  end;
  if FixedPoint.Sub(SmallInt((Exp^ and 1)), 1) = 0 then
    Frac^ := FixedPoint.LShr(Frac^, 1);
  Exp^ := AmrNegate(FixedPoint.ShiftRight(FixedPoint.Sub(Exp^, 1), 1));
  Frac^ := FixedPoint.LShr(Frac^, 9);
  I := AmrExtractH(Frac^);
  Frac^ := FixedPoint.LShr(Frac^, 1);
  A := AmrExtractL(Frac^);
  A := SmallInt((A and SmallInt($7FFF)));
  I := FixedPoint.Sub(I, 16);
  Frac^ := AmrLDepositH(MathOpTableIsqrt[I]);
  Tmp := FixedPoint.Sub(MathOpTableIsqrt[I], MathOpTableIsqrt[I + 1]);
  Frac^ := FixedPoint.LMsu(Frac^, Tmp, A);
end;

function AmrDtxDec(State: PAMRdtxDecState; Exc2: PAMRSmallInt; NewState: SmallInt; ArgIsf: PAMRSmallInt; var Parameters: PAMRSmallInt): SmallInt;
var
  LogEnIndex: SmallInt;
  Ind: array[0..6] of SmallInt;
  I: SmallInt;
  J: SmallInt;
  IntFac: SmallInt;
  Gain: SmallInt;
  LIsf: array[0..15] of Integer;
  LLogEnInt: Integer;
  Level32: Integer;
  Ener32: Integer;
  Ptr: SmallInt;
  TmpIntLength: SmallInt;
  Tmp: SmallInt;
  Exp: SmallInt;
  Exp0: SmallInt;
  LogEnIntE: SmallInt;
  LogEnIntM: SmallInt;
  Level: SmallInt;
begin
  if (State^.DtxHangoverAdded <> 0) and (State^.SidFrame <> 0) then
  begin
    Ptr := FixedPoint.Add(State^.HistPtr, 1);
    if FixedPoint.Sub(Ptr, 8) = 0 then
      Ptr := 0;
    CopySamples(PAMRSmallInt(@State^.IsfHist[State^.HistPtr * 16]), PAMRSmallInt(@State^.IsfHist[Ptr * 16]), 16);
    State^.LogEnHist[Ptr] := State^.LogEnHist[State^.HistPtr];
    State^.LogEn := 0;
    I := 0;
    while I < 16 do
    begin
      LIsf[I] := 0;
      Inc(I);
    end;
    I := 0;
    while I < 8 do
    begin
      State^.LogEn := FixedPoint.Add(State^.LogEn, State^.LogEnHist[I]);
      J := 0;
      while J < 16 do
      begin
        LIsf[J] := FixedPoint.LAdd(LIsf[J], AmrLDepositL(State^.IsfHist[(I * 16) + J]));
        Inc(J);
      end;
      Inc(I);
    end;
    State^.LogEn := FixedPoint.ShiftRight(State^.LogEn, 1);
    State^.LogEn := FixedPoint.Add(State^.LogEn, 1024);
    if State^.LogEn < 0 then
      State^.LogEn := 0;
    J := 0;
    while J < 16 do
    begin
      State^.Isf[J] := AmrExtractL(FixedPoint.LShr(LIsf[J], 3));
      Inc(J);
    end;
  end;
  if State^.SidFrame <> 0 then
  begin
    CopySamples(PAMRSmallInt(@State^.Isf[0]), PAMRSmallInt(@State^.IsfOld[0]), 16);
    State^.OldLogEn := State^.LogEn;
    if State^.ValidData <> 0 then
    begin
      TmpIntLength := State^.SinceLastSid;
      if FixedPoint.Sub(TmpIntLength, 32) > 0 then
        TmpIntLength := 32;
      if FixedPoint.Sub(TmpIntLength, 2) >= 0 then
        State^.TrueSidPeriodInv := FixedPoint.DivS((1 shl 10), FixedPoint.ShiftLeft(TmpIntLength, 10))
      else
        State^.TrueSidPeriodInv := 1 shl 14;
      Ind[0] := ReadSerialParameter(6, Parameters);
      Ind[1] := ReadSerialParameter(6, Parameters);
      Ind[2] := ReadSerialParameter(6, Parameters);
      Ind[3] := ReadSerialParameter(5, Parameters);
      Ind[4] := ReadSerialParameter(5, Parameters);
      AmrDisfNs(PAMRSmallInt(@Ind[0]), PAMRSmallInt(@State^.Isf[0]));
      LogEnIndex := ReadSerialParameter(6, Parameters);
      State^.CNDith := ReadSerialParameter(1, Parameters);
      State^.LogEn := FixedPoint.ShiftLeft(LogEnIndex, (15 - 6));
      State^.LogEn := FixedPoint.Mult(State^.LogEn, 12483);
      if (State^.DataUpdated = 0) or (FixedPoint.Sub(State^.DtxGlobalState, 0) = 0) then
      begin
        CopySamples(PAMRSmallInt(@State^.Isf[0]), PAMRSmallInt(@State^.IsfOld[0]), 16);
        State^.OldLogEn := State^.LogEn;
      end;
    end;
  end;
  if (State^.SidFrame <> 0) and (State^.ValidData <> 0) then
    State^.SinceLastSid := 0;
  IntFac := FixedPoint.ShiftLeft(State^.SinceLastSid, 10);
  IntFac := FixedPoint.Mult(IntFac, State^.TrueSidPeriodInv);
  if FixedPoint.Sub(IntFac, 1024) > 0 then
    IntFac := 1024;
  IntFac := FixedPoint.ShiftLeft(IntFac, 4);
  LLogEnInt := FixedPoint.LMult(IntFac, State^.LogEn);
  I := 0;
  while I < 16 do
  begin
    ArgIsf[I] := FixedPoint.Mult(IntFac, State^.Isf[I]);
    Inc(I);
  end;
  IntFac := FixedPoint.Sub(16384, IntFac);
  LLogEnInt := FixedPoint.LMac(LLogEnInt, IntFac, State^.OldLogEn);
  I := 0;
  while I < 16 do
  begin
    ArgIsf[I] := FixedPoint.Add(ArgIsf[I], FixedPoint.Mult(IntFac, State^.IsfOld[I]));
    ArgIsf[I] := FixedPoint.ShiftLeft(ArgIsf[I], 1);
    Inc(I);
  end;
  if State^.CNDith <> 0 then
  begin
    DitherComfortNoise(ArgIsf, PAMRInteger(@LLogEnInt), PAMRSmallInt(@State^.DitherSeed));
  end;
  LLogEnInt := FixedPoint.LShr(LLogEnInt, 9);
  LogEnIntE := AmrExtractH(LLogEnInt);
  LogEnIntM := AmrExtractL(FixedPoint.LShr(FixedPoint.LSub(LLogEnInt, AmrLDepositH(LogEnIntE)), 1));
  LogEnIntE := FixedPoint.Add(LogEnIntE, (16 - 1));
  Level32 := FixedPoint.Pow2(LogEnIntE, LogEnIntM);
  Exp0 := AmrNormL(Level32);
  Level32 := FixedPoint.LShl(Level32, Exp0);
  Exp0 := FixedPoint.Sub(15, Exp0);
  Level := AmrExtractH(Level32);
  I := 0;
  while I < 256 do
  begin
    Exc2[I] := FixedPoint.ShiftRight(AmrRandom(PAMRSmallInt(@State^.CngSeed)), 4);
    Inc(I);
  end;
  Ener32 := AmrDotProduct12(Exc2, Exc2, 256, PAMRSmallInt(@Exp));
  AmrIsqrtN(PAMRInteger(@Ener32), PAMRSmallInt(@Exp));
  Gain := AmrExtractH(Ener32);
  Gain := FixedPoint.Mult(Level, Gain);
  Exp := FixedPoint.Add(Exp0, Exp);
  Exp := FixedPoint.Add(Exp, 4);
  I := 0;
  while I < 256 do
  begin
    Tmp := FixedPoint.Mult(Exc2[I], Gain);
    Exc2[I] := FixedPoint.ShiftLeft(Tmp, Exp);
    Inc(I);
  end;
  if FixedPoint.Sub(NewState, 2) = 0 then
  begin
    TmpIntLength := State^.SinceLastSid;
    if FixedPoint.Sub(TmpIntLength, 32) > 0 then
      TmpIntLength := 32;
    if TmpIntLength <= 0 then
      TmpIntLength := 8;
    State^.TrueSidPeriodInv := FixedPoint.DivS((1 shl 10), FixedPoint.ShiftLeft(TmpIntLength, 10));
    State^.SinceLastSid := 0;
    State^.OldLogEn := State^.LogEn;
    State^.LogEn := FixedPoint.Sub(State^.LogEn, 64);
  end;
  if (State^.SidFrame <> 0) and
    ((State^.ValidData <> 0) or ((State^.ValidData = 0) and (State^.DtxHangoverAdded <> 0))) then
  begin
    State^.SinceLastSid := 0;
    State^.DataUpdated := 1;
  end;
  Result := 0;
end;

procedure AmrIsfIsp(Isf, Isp: PAMRSmallInt; M: SmallInt);
var
  I: SmallInt;
  Ind: SmallInt;
  Offset: SmallInt;
  LTmp: Integer;
begin
  I := 0;
  while I < (M - 1) do
  begin
    Isp[I] := Isf[I];
    Inc(I);
  end;
  Isp[M - 1] := FixedPoint.ShiftLeft(Isf[M - 1], 1);
  I := 0;
  while I < M do
  begin
    Ind := FixedPoint.ShiftRight(Isp[I], 7);
    Offset := SmallInt((Isp[I] and $7F));
    LTmp := FixedPoint.LMult(FixedPoint.Sub(IspIsfTable[Ind + 1], IspIsfTable[Ind]), Offset);
    Isp[I] := FixedPoint.Add(IspIsfTable[Ind], AmrExtractL(FixedPoint.LShr(LTmp, 8)));
    Inc(I);
  end;
end;

procedure GetIspPolynomial16kHz(Isp: PAMRSmallInt; F: PAMRInteger; N: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  Hi: SmallInt;
  Lo: SmallInt;
  T0: Integer;
begin
  F[0] := FixedPoint.LMult(4096, 256);
  F[1] := FixedPoint.LMult(Isp[0], (-64));
  F := F + 2;
  Isp := Isp + 2;
  I := 2;
  while I <= N do
  begin
    F^ := F[-2];
    J := 1;
    while J < I do
    begin
      FixedPoint.LExtract(F[-1], PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
      T0 := FixedPoint.Mpy3216(Hi, Lo, Isp^);
      T0 := FixedPoint.LShl(T0, 1);
      F^ := FixedPoint.LSub(F^, T0);
      F^ := FixedPoint.LAdd(F^, F[-2]);
      Inc(J);
      Dec(F);
    end;
    F^ := FixedPoint.LMsu(F^, Isp^, 64);
    F := F + I;
    Isp := Isp + 2;
    Inc(I);
  end;
end;

procedure GetIspPolynomial(Isp: PAMRSmallInt; F: PAMRInteger; N: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  Hi: SmallInt;
  Lo: SmallInt;
  T0: Integer;
begin
  F[0] := FixedPoint.LMult(4096, 1024);
  F[1] := FixedPoint.LMult(Isp[0], (-256));
  F := F + 2;
  Isp := Isp + 2;
  I := 2;
  while I <= N do
  begin
    F^ := F[-2];
    J := 1;
    while J < I do
    begin
      FixedPoint.LExtract(F[-1], PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
      T0 := FixedPoint.Mpy3216(Hi, Lo, Isp^);
      T0 := FixedPoint.LShl(T0, 1);
      F^ := FixedPoint.LSub(F^, T0);
      F^ := FixedPoint.LAdd(F^, F[-2]);
      Inc(J);
      Dec(F);
    end;
    F^ := FixedPoint.LMsu(F^, Isp^, 256);
    F := F + I;
    Isp := Isp + 2;
    Inc(I);
  end;
end;

procedure AmrIspAz(Isp, A: PAMRSmallInt; M, AdaptiveScaling: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  Hi: SmallInt;
  Lo: SmallInt;
  F1: array[0..10] of Integer;
  F2: array[0..9] of Integer;
  Nc: SmallInt;
  T0: Integer;
  Q: SmallInt;
  QSug: SmallInt;
  Tmax: Integer;
begin
  Nc := FixedPoint.ShiftRight(M, 1);
  if FixedPoint.Sub(Nc, 8) > 0 then
  begin
    GetIspPolynomial16kHz(PAMRSmallInt(@Isp[0]), PAMRInteger(@F1[0]), Nc);
    I := 0;
    while I <= Nc do
    begin
      F1[I] := FixedPoint.LShl(F1[I], 2);
      Inc(I);
    end;
  end
  else
  begin
    GetIspPolynomial(PAMRSmallInt(@Isp[0]), PAMRInteger(@F1[0]), Nc);
  end;
  if FixedPoint.Sub(Nc, 8) > 0 then
  begin
    GetIspPolynomial16kHz(PAMRSmallInt(@Isp[1]), PAMRInteger(@F2[0]), FixedPoint.Sub(Nc, 1));
    I := 0;
    while I <= (Nc - 1) do
    begin
      F2[I] := FixedPoint.LShl(F2[I], 2);
      Inc(I);
    end;
  end
  else
  begin
    GetIspPolynomial(PAMRSmallInt(@Isp[1]), PAMRInteger(@F2[0]), FixedPoint.Sub(Nc, 1));
  end;
  I := FixedPoint.Sub(Nc, 1);
  while I > 1 do
  begin
    F2[I] := FixedPoint.LSub(F2[I], F2[I - 2]);
    Dec(I);
  end;
  I := 0;
  while I < Nc do
  begin
    FixedPoint.LExtract(F1[I], PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
    T0 := FixedPoint.Mpy3216(Hi, Lo, Isp[M - 1]);
    F1[I] := FixedPoint.LAdd(F1[I], T0);
    FixedPoint.LExtract(F2[I], PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
    T0 := FixedPoint.Mpy3216(Hi, Lo, Isp[M - 1]);
    F2[I] := FixedPoint.LSub(F2[I], T0);
    Inc(I);
  end;
  A[0] := 4096;
  Tmax := 1;
  I := 1;
  J := FixedPoint.Sub(M, 1);
  while I < Nc do
  begin
    T0 := FixedPoint.LAdd(F1[I], F2[I]);
    Tmax := Tmax or AmrLAbs(T0);
    A[I] := AmrExtractL(FixedPoint.LShrR(T0, 12));
    T0 := FixedPoint.LSub(F1[I], F2[I]);
    Tmax := Tmax or AmrLAbs(T0);
    A[J] := AmrExtractL(FixedPoint.LShrR(T0, 12));
    Inc(I);
    Dec(J);
  end;
  if FixedPoint.Sub(AdaptiveScaling, 1) = 0 then
    Q := FixedPoint.Sub(4, AmrNormL(Tmax))
  else
    Q := 0;
  if Q > 0 then
  begin
    QSug := FixedPoint.Add(12, Q);
    I := 1;
    J := FixedPoint.Sub(M, 1);
    while I < Nc do
    begin
      T0 := FixedPoint.LAdd(F1[I], F2[I]);
      A[I] := AmrExtractL(FixedPoint.LShrR(T0, QSug));
      T0 := FixedPoint.LSub(F1[I], F2[I]);
      A[J] := AmrExtractL(FixedPoint.LShrR(T0, QSug));
      Inc(I);
      Dec(J);
    end;
    A[0] := FixedPoint.ShiftRight(A[0], Q);
  end
  else
  begin
    QSug := 12;
    Q := 0;
  end;
  FixedPoint.LExtract(F1[Nc], PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
  T0 := FixedPoint.Mpy3216(Hi, Lo, Isp[M - 1]);
  T0 := FixedPoint.LAdd(F1[Nc], T0);
  A[Nc] := AmrExtractL(FixedPoint.LShrR(T0, QSug));
  A[M] := FixedPoint.ShrR(Isp[M - 1], FixedPoint.Add(3, Q));
end;

procedure AmrSynFilt32(A: PAMRSmallInt; M: SmallInt; Exc: PAMRSmallInt; Qnew: SmallInt; SigHi, SigLo: PAMRSmallInt; Lg: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  A0: SmallInt;
  S: SmallInt;
  LTmp: Integer;
begin
  S := FixedPoint.Sub(AmrNormS(A[0]), 2);
  A0 := FixedPoint.ShiftRight(A[0], FixedPoint.Add(4, Qnew));
  I := 0;
  while I < Lg do
  begin
    LTmp := 0;
    J := 1;
    while J <= M do
    begin
      LTmp := FixedPoint.LMsu(LTmp, SigLo[I - J], A[J]);
      Inc(J);
    end;
    LTmp := FixedPoint.LShr(LTmp, (16 - 4));
    LTmp := FixedPoint.LMac(LTmp, Exc[I], A0);
    J := 1;
    while J <= M do
    begin
      LTmp := FixedPoint.LMsu(LTmp, SigHi[I - J], A[J]);
      Inc(J);
    end;
    LTmp := FixedPoint.LShl(LTmp, FixedPoint.Add(3, S));
    SigHi[I] := AmrExtractH(LTmp);
    LTmp := FixedPoint.LShr(LTmp, 4);
    SigLo[I] := AmrExtractL(FixedPoint.LMsu(LTmp, SigHi[I], 2048));
    Inc(I);
  end;
end;

procedure AmrDeemph32(XHi, XLo, Y: PAMRSmallInt; Mu, L: SmallInt; Mem: PAMRSmallInt);
var
  I: SmallInt;
  Fac: SmallInt;
  LTmp: Integer;
begin
  Fac := FixedPoint.ShiftRight(Mu, 1);
  LTmp := AmrLDepositH(XHi[0]);
  LTmp := FixedPoint.LMac(LTmp, XLo[0], 8);
  LTmp := FixedPoint.LShl(LTmp, 3);
  LTmp := FixedPoint.LMac(LTmp, Mem^, Fac);
  LTmp := FixedPoint.LShl(LTmp, 1);
  Y[0] := FixedPoint.Round(LTmp);
  I := 1;
  while I < L do
  begin
    LTmp := AmrLDepositH(XHi[I]);
    LTmp := FixedPoint.LMac(LTmp, XLo[I], 8);
    LTmp := FixedPoint.LShl(LTmp, 3);
    LTmp := FixedPoint.LMac(LTmp, Y[I - 1], Fac);
    LTmp := FixedPoint.LShl(LTmp, 1);
    Y[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
  Mem^ := Y[L - 1];
end;

procedure AmrHP5012k8(Signal: PAMRSmallInt; Lg: SmallInt; Mem: PAMRSmallInt);
var
  I: SmallInt;
  X2: SmallInt;
  Y2Hi: SmallInt;
  Y2Lo: SmallInt;
  Y1Hi: SmallInt;
  Y1Lo: SmallInt;
  X0: SmallInt;
  X1: SmallInt;
  LTmp: Integer;
begin
  Y2Hi := Mem[0];
  Y2Lo := Mem[1];
  Y1Hi := Mem[2];
  Y1Lo := Mem[3];
  X0 := Mem[4];
  X1 := Mem[5];
  I := 0;
  while I < Lg do
  begin
    X2 := X1;
    X1 := X0;
    X0 := Signal[I];
    LTmp := 16384;
    LTmp := FixedPoint.LMac(LTmp, Y1Lo, Hp50A[1]);
    LTmp := FixedPoint.LMac(LTmp, Y2Lo, Hp50A[2]);
    LTmp := FixedPoint.LShr(LTmp, 15);
    LTmp := FixedPoint.LMac(LTmp, Y1Hi, Hp50A[1]);
    LTmp := FixedPoint.LMac(LTmp, Y2Hi, Hp50A[2]);
    LTmp := FixedPoint.LMac(LTmp, X0, Hp50B[0]);
    LTmp := FixedPoint.LMac(LTmp, X1, Hp50B[1]);
    LTmp := FixedPoint.LMac(LTmp, X2, Hp50B[2]);
    LTmp := FixedPoint.LShl(LTmp, 2);
    Y2Hi := Y1Hi;
    Y2Lo := Y1Lo;
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@Y1Hi), PAMRSmallInt(@Y1Lo));
    LTmp := FixedPoint.LShl(LTmp, 1);
    Signal[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
  Mem[0] := Y2Hi;
  Mem[1] := Y2Lo;
  Mem[2] := Y1Hi;
  Mem[3] := Y1Lo;
  Mem[4] := X0;
  Mem[5] := X1;
end;

function Interpolate5Over4(X, Fir: PAMRSmallInt; Frac, Resol, NbCoef: SmallInt): SmallInt;
var
  I: SmallInt;
  K: SmallInt;
  LSum: Integer;
begin
  X := (X - NbCoef) + 1;
  LSum := 0;
  I := 0;
  K := FixedPoint.Sub(FixedPoint.Sub(Resol, 1), Frac);
  while I < (2 * NbCoef) do
  begin
    LSum := FixedPoint.LMac(LSum, X[I], Fir[K]);
    Inc(I);
    K := SmallInt((K + Resol));
  end;
  LSum := FixedPoint.LShl(LSum, 1);
  Result := FixedPoint.Round(LSum);
end;

procedure Upsample5Over4(SigD, SigU: PAMRSmallInt; LFrame: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  Pos: SmallInt;
  Frac: SmallInt;
begin
  Pos := 0;
  J := 0;
  while J < LFrame do
  begin
    I := FixedPoint.Mult(Pos, 6554);
    Frac := FixedPoint.Sub(Pos, FixedPoint.Add(FixedPoint.ShiftLeft(I, 2), I));
    SigU[J] := Interpolate5Over4(PAMRSmallInt(@SigD[I]), PAMRSmallInt(@Decim54FirUp[0]), Frac, 5, 12);
    Pos := FixedPoint.Add(Pos, 4);
    Inc(J);
  end;
end;

procedure AmrOversamp16k(Sig12k8: PAMRSmallInt; Lg: SmallInt; Sig16k, Mem: PAMRSmallInt);
var
  LgUp: SmallInt;
  Signal: array[0..87] of SmallInt;
begin
  CopySamples(Mem, PAMRSmallInt(@Signal[0]), (2 * 12));
  CopySamples(Sig12k8, (PAMRSmallInt(@Signal[0]) + (2 * 12)), Lg);
  LgUp := FixedPoint.ShiftLeft(FixedPoint.Mult(Lg, 20480), 1);
  Upsample5Over4((PAMRSmallInt(@Signal[0]) + 12), Sig16k, LgUp);
  CopySamples((PAMRSmallInt(@Signal[0]) + Lg), Mem, (2 * 12));
end;

procedure AmrScaleSig(X: PAMRSmallInt; Lg, Exp: SmallInt);
var
  I: SmallInt;
  LTmp: Integer;
begin
  I := 0;
  while I < Lg do
  begin
    LTmp := AmrLDepositH(X[I]);
    LTmp := FixedPoint.LShl(LTmp, Exp);
    X[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
end;

procedure AmrHP40012k8(Signal: PAMRSmallInt; Lg: SmallInt; Mem: PAMRSmallInt);
var
  I: SmallInt;
  X2: SmallInt;
  Y2Hi: SmallInt;
  Y2Lo: SmallInt;
  Y1Hi: SmallInt;
  Y1Lo: SmallInt;
  X0: SmallInt;
  X1: SmallInt;
  LTmp: Integer;
begin
  Y2Hi := Mem[0];
  Y2Lo := Mem[1];
  Y1Hi := Mem[2];
  Y1Lo := Mem[3];
  X0 := Mem[4];
  X1 := Mem[5];
  I := 0;
  while I < Lg do
  begin
    X2 := X1;
    X1 := X0;
    X0 := Signal[I];
    LTmp := 16384;
    LTmp := FixedPoint.LMac(LTmp, Y1Lo, Hp400A[1]);
    LTmp := FixedPoint.LMac(LTmp, Y2Lo, Hp400A[2]);
    LTmp := FixedPoint.LShr(LTmp, 15);
    LTmp := FixedPoint.LMac(LTmp, Y1Hi, Hp400A[1]);
    LTmp := FixedPoint.LMac(LTmp, Y2Hi, Hp400A[2]);
    LTmp := FixedPoint.LMac(LTmp, X0, Hp400B[0]);
    LTmp := FixedPoint.LMac(LTmp, X1, Hp400B[1]);
    LTmp := FixedPoint.LMac(LTmp, X2, Hp400B[2]);
    LTmp := FixedPoint.LShl(LTmp, 1);
    Y2Hi := Y1Hi;
    Y2Lo := Y1Lo;
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@Y1Hi), PAMRSmallInt(@Y1Lo));
    Signal[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
  Mem[0] := Y2Hi;
  Mem[1] := Y2Lo;
  Mem[2] := Y1Hi;
  Mem[3] := Y1Lo;
  Mem[4] := X0;
  Mem[5] := X1;
end;

function AmrMpy32(Hi1, Lo1, Hi2, Lo2: SmallInt): Integer;
var
  L32: Integer;
begin
  L32 := FixedPoint.LMult(Hi1, Hi2);
  L32 := FixedPoint.LMac(L32, FixedPoint.Mult(Hi1, Lo2), 1);
  L32 := FixedPoint.LMac(L32, FixedPoint.Mult(Lo1, Hi2), 1);
  Result := L32;
end;

procedure AmrIsfExtrapolation(HfIsf: PAMRSmallInt);
var
  IsfDiff: array[0..13] of SmallInt;
  IsfCorr: array[0..2] of Integer;
  LTmp: Integer;
  Coeff: SmallInt;
  Mean: SmallInt;
  Tmp: SmallInt;
  Tmp2: SmallInt;
  Tmp3: SmallInt;
  Exp: SmallInt;
  Exp2: SmallInt;
  Hi: SmallInt;
  Lo: SmallInt;
  I: SmallInt;
  MaxCorr: SmallInt;
begin
  HfIsf[20 - 1] := HfIsf[16 - 1];
  I := 1;
  while I < (16 - 1) do
  begin
    IsfDiff[I - 1] := FixedPoint.Sub(HfIsf[I], HfIsf[I - 1]);
    Inc(I);
  end;
  LTmp := 0;
  I := 3;
  while I < (16 - 1) do
  begin
    LTmp := FixedPoint.LMac(LTmp, IsfDiff[I - 1], 2731);
    Inc(I);
  end;
  Mean := FixedPoint.Round(LTmp);
  IsfCorr[0] := 0;
  IsfCorr[1] := 0;
  IsfCorr[2] := 0;
  Tmp := 0;
  I := 0;
  while I < (16 - 2) do
  begin
    if FixedPoint.Sub(IsfDiff[I], Tmp) > 0 then
      Tmp := IsfDiff[I];
    Inc(I);
  end;
  Exp := AmrNormS(Tmp);
  I := 0;
  while I < (16 - 2) do
  begin
    IsfDiff[I] := FixedPoint.ShiftLeft(IsfDiff[I], Exp);
    Inc(I);
  end;
  Mean := FixedPoint.ShiftLeft(Mean, Exp);
  I := 7;
  while I < (16 - 2) do
  begin
    Tmp2 := FixedPoint.Sub(IsfDiff[I], Mean);
    Tmp3 := FixedPoint.Sub(IsfDiff[I - 2], Mean);
    LTmp := FixedPoint.LMult(Tmp2, Tmp3);
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
    LTmp := AmrMpy32(Hi, Lo, Hi, Lo);
    IsfCorr[0] := FixedPoint.LAdd(IsfCorr[0], LTmp);
    Inc(I);
  end;
  I := 7;
  while I < (16 - 2) do
  begin
    Tmp2 := FixedPoint.Sub(IsfDiff[I], Mean);
    Tmp3 := FixedPoint.Sub(IsfDiff[I - 3], Mean);
    LTmp := FixedPoint.LMult(Tmp2, Tmp3);
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
    LTmp := AmrMpy32(Hi, Lo, Hi, Lo);
    IsfCorr[1] := FixedPoint.LAdd(IsfCorr[1], LTmp);
    Inc(I);
  end;
  I := 7;
  while I < (16 - 2) do
  begin
    Tmp2 := FixedPoint.Sub(IsfDiff[I], Mean);
    Tmp3 := FixedPoint.Sub(IsfDiff[I - 4], Mean);
    LTmp := FixedPoint.LMult(Tmp2, Tmp3);
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@Hi), PAMRSmallInt(@Lo));
    LTmp := AmrMpy32(Hi, Lo, Hi, Lo);
    IsfCorr[2] := FixedPoint.LAdd(IsfCorr[2], LTmp);
    Inc(I);
  end;
  if FixedPoint.LSub(IsfCorr[0], IsfCorr[1]) > 0 then
    MaxCorr := 0
  else
    MaxCorr := 1;
  if FixedPoint.LSub(IsfCorr[2], IsfCorr[MaxCorr]) > 0 then
    MaxCorr := 2;
  MaxCorr := FixedPoint.Add(MaxCorr, 1);
  I := 16 - 1;
  while I < (20 - 1) do
  begin
    Tmp := FixedPoint.Sub(HfIsf[(I - 1) - MaxCorr], HfIsf[(I - 2) - MaxCorr]);
    HfIsf[I] := FixedPoint.Add(HfIsf[I - 1], Tmp);
    Inc(I);
  end;
  Tmp := FixedPoint.Add(HfIsf[4], HfIsf[3]);
  Tmp := FixedPoint.Sub(HfIsf[2], Tmp);
  Tmp := FixedPoint.Mult(Tmp, 5461);
  Tmp := FixedPoint.Add(Tmp, 20390);
  if FixedPoint.Sub(Tmp, 19456) > 0 then
    Tmp := 19456;
  Tmp := FixedPoint.Sub(Tmp, HfIsf[16 - 2]);
  Tmp2 := FixedPoint.Sub(HfIsf[20 - 2], HfIsf[16 - 2]);
  Exp2 := AmrNormS(Tmp2);
  Exp := AmrNormS(Tmp);
  Exp := FixedPoint.Sub(Exp, 1);
  Tmp := FixedPoint.ShiftLeft(Tmp, Exp);
  Tmp2 := FixedPoint.ShiftLeft(Tmp2, Exp2);
  Coeff := FixedPoint.DivS(Tmp, Tmp2);
  Exp := FixedPoint.Sub(Exp2, Exp);
  I := 16 - 1;
  while I < (20 - 1) do
  begin
    Tmp := FixedPoint.Mult(FixedPoint.Sub(HfIsf[I], HfIsf[I - 1]), Coeff);
    IsfDiff[I - (16 - 1)] := FixedPoint.ShiftLeft(Tmp, Exp);
    Inc(I);
  end;
  I := 16;
  while I < (20 - 1) do
  begin
    Tmp := FixedPoint.Sub(FixedPoint.Add(IsfDiff[I - (16 - 1)], IsfDiff[I - 16]), 1280);
    if Tmp < 0 then
    begin
      if FixedPoint.Sub(IsfDiff[I - (16 - 1)], IsfDiff[I - 16]) > 0 then
        IsfDiff[I - 16] := FixedPoint.Sub(1280, IsfDiff[I - (16 - 1)])
      else
        IsfDiff[I - (16 - 1)] := FixedPoint.Sub(1280, IsfDiff[I - 16]);
    end;
    Inc(I);
  end;
  I := 16 - 1;
  while I < (20 - 1) do
  begin
    HfIsf[I] := FixedPoint.Add(HfIsf[I - 1], IsfDiff[I - (16 - 1)]);
    Inc(I);
  end;
  I := 0;
  while I < (20 - 1) do
  begin
    HfIsf[I] := FixedPoint.Mult(HfIsf[I], 26214);
    Inc(I);
  end;
  AmrIsfIsp(HfIsf, HfIsf, 20);
end;

procedure AmrWeightA(A, Ap: PAMRSmallInt; Gamma, M: SmallInt);
var
  I: SmallInt;
  Fac: SmallInt;
begin
  Ap[0] := A[0];
  Fac := Gamma;
  I := 1;
  while I < M do
  begin
    Ap[I] := FixedPoint.Round(FixedPoint.LMult(A[I], Fac));
    Fac := FixedPoint.Round(FixedPoint.LMult(Fac, Gamma));
    Inc(I);
  end;
  Ap[M] := FixedPoint.Round(FixedPoint.LMult(A[M], Fac));
end;

procedure AmrSynFilt(A: PAMRSmallInt; M: SmallInt; X, Y: PAMRSmallInt; Lg: SmallInt; Mem: PAMRSmallInt; Update: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  YBuf: array[0..99] of SmallInt;
  A0: SmallInt;
  S: SmallInt;
  LTmp: Integer;
  Yy: PAMRSmallInt;
begin
  Yy := PAMRSmallInt(@YBuf[0]);
  I := 0;
  while I < M do
  begin
    Yy^ := Mem[I];
    Inc(Yy);
    Inc(I);
  end;
  S := FixedPoint.Sub(AmrNormS(A[0]), 2);
  A0 := FixedPoint.ShiftRight(A[0], 1);
  I := 0;
  while I < Lg do
  begin
    LTmp := FixedPoint.LMult(X[I], A0);
    J := 1;
    while J <= M do
    begin
      LTmp := FixedPoint.LMsu(LTmp, A[J], Yy[I - J]);
      Inc(J);
    end;
    LTmp := FixedPoint.LShl(LTmp, FixedPoint.Add(3, S));
    Yy[I] := FixedPoint.Round(LTmp);
    Y[I] := Yy[I];
    Inc(I);
  end;
  if Update <> 0 then
  begin
    I := 0;
    while I < M do
    begin
      Mem[I] := Yy[(Lg - M) + I];
      Inc(I);
    end;
  end;
end;

procedure AmrFilt6k7k(Signal: PAMRSmallInt; Lg: SmallInt; Mem: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  X: array[0..109] of SmallInt;
  LTmp: Integer;
begin
  CopySamples(Mem, PAMRSmallInt(@X[0]), (31 - 1));
  I := 0;
  while I < Lg do
  begin
    X[(I + 31) - 1] := FixedPoint.ShiftRight(Signal[I], 2);
    Inc(I);
  end;
  I := 0;
  while I < Lg do
  begin
    LTmp := 0;
    for J := 0 to 30 do
      LTmp := FixedPoint.LMac(LTmp, X[I + J], Hp6kFir6k7k[J]);
    Signal[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
  CopySamples((PAMRSmallInt(@X[0]) + Lg), Mem, (31 - 1));
end;

procedure AmrFilt7k(Signal: PAMRSmallInt; Lg: SmallInt; Mem: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  X: array[0..109] of SmallInt;
  LTmp: Integer;
begin
  CopySamples(Mem, PAMRSmallInt(@X[0]), (31 - 1));
  I := 0;
  while I < Lg do
  begin
    X[(I + 31) - 1] := Signal[I];
    Inc(I);
  end;
  I := 0;
  while I < Lg do
  begin
    LTmp := 0;
    for J := 0 to 30 do
      LTmp := FixedPoint.LMac(LTmp, X[I + J], Hp7kFir7k[J]);
    Signal[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
  CopySamples((PAMRSmallInt(@X[0]) + Lg), Mem, (31 - 1));
end;

procedure SynthesizeSubframe(Aq, Exc: PAMRSmallInt; QNew: SmallInt; Synth16k: PAMRSmallInt; Parameters: SmallInt; HfIsf: PAMRSmallInt; NbBits, NewDTXState: SmallInt; State: PAMRDecoderState; Bfi: SmallInt);
var
  I: SmallInt;
  Fac: SmallInt;
  Tmp: SmallInt;
  Exp: SmallInt;
  Ener: SmallInt;
  ExpEner: SmallInt;
  LTmp: Integer;
  SynthHi: array[0..79] of SmallInt;
  SynthLo: array[0..79] of SmallInt;
  Synth: array[0..63] of SmallInt;
  HF: array[0..79] of SmallInt;
  Ap: array[0..20] of SmallInt;
  HfA: array[0..20] of SmallInt;
  HFCorrGain: SmallInt;
  HFGainInd: SmallInt;
  Gain1: SmallInt;
  Gain2: SmallInt;
  Weight1: SmallInt;
  Weight2: SmallInt;
begin
  CopySamples(PAMRSmallInt(@State^.MemSynHi[0]), PAMRSmallInt(@SynthHi[0]), 16);
  CopySamples(PAMRSmallInt(@State^.MemSynLo[0]), PAMRSmallInt(@SynthLo[0]), 16);
  AmrSynFilt32(Aq, 16, Exc, QNew, (PAMRSmallInt(@SynthHi[0]) + 16), (PAMRSmallInt(@SynthLo[0]) + 16), 64);
  CopySamples((PAMRSmallInt(@SynthHi[0]) + 64), PAMRSmallInt(@State^.MemSynHi[0]), 16);
  CopySamples((PAMRSmallInt(@SynthLo[0]) + 64), PAMRSmallInt(@State^.MemSynLo[0]), 16);
  AmrDeemph32((PAMRSmallInt(@SynthHi[0]) + 16), (PAMRSmallInt(@SynthLo[0]) + 16), PAMRSmallInt(@Synth[0]), 22282,
    64, PAMRSmallInt(@State^.MemDeemph));
  AmrHP5012k8(PAMRSmallInt(@Synth[0]), 64, PAMRSmallInt(@State^.MemSigOut[0]));
  AmrOversamp16k(PAMRSmallInt(@Synth[0]), 64, Synth16k, PAMRSmallInt(@State^.MemOversamp[0]));
  I := 0;
  while I < 80 do
  begin
    HF[I] := FixedPoint.ShiftRight(AmrRandom(PAMRSmallInt(@State^.Seed2)), 3);
    Inc(I);
  end;
  AmrScaleSig(Exc, 64, (-3));
  QNew := FixedPoint.Sub(QNew, 3);
  Ener := AmrExtractH(AmrDotProduct12(Exc, Exc, 64, PAMRSmallInt(@ExpEner)));
  ExpEner := FixedPoint.Sub(ExpEner, FixedPoint.Add(QNew, QNew));
  Tmp := AmrExtractH(AmrDotProduct12(PAMRSmallInt(@HF[0]), PAMRSmallInt(@HF[0]), 80, PAMRSmallInt(@Exp)));
  if FixedPoint.Sub(Tmp, Ener) > 0 then
  begin
    Tmp := FixedPoint.ShiftRight(Tmp, 1);
    Exp := FixedPoint.Add(Exp, 1);
  end;
  LTmp := AmrLDepositH(FixedPoint.DivS(Tmp, Ener));
  Exp := FixedPoint.Sub(Exp, ExpEner);
  AmrIsqrtN(PAMRInteger(@LTmp), PAMRSmallInt(@Exp));
  LTmp := FixedPoint.LShl(LTmp, FixedPoint.Add(Exp, 1));
  Tmp := AmrExtractH(LTmp);
  I := 0;
  while I < 80 do
  begin
    HF[I] := FixedPoint.Mult(HF[I], Tmp);
    Inc(I);
  end;
  AmrHP40012k8(PAMRSmallInt(@Synth[0]), 64, PAMRSmallInt(@State^.MemHp400[0]));
  LTmp := 1;
  I := 0;
  while I < 64 do
  begin
    LTmp := FixedPoint.LMac(LTmp, Synth[I], Synth[I]);
    Inc(I);
  end;
  Exp := AmrNormL(LTmp);
  Ener := AmrExtractH(FixedPoint.LShl(LTmp, Exp));
  LTmp := 1;
  I := 1;
  while I < 64 do
  begin
    LTmp := FixedPoint.LMac(LTmp, Synth[I], Synth[I - 1]);
    Inc(I);
  end;
  Tmp := AmrExtractH(FixedPoint.LShl(LTmp, Exp));
  if Tmp > 0 then
    Fac := FixedPoint.DivS(Tmp, Ener)
  else
    Fac := 0;
  Gain1 := FixedPoint.Sub(32767, Fac);
  Gain2 := FixedPoint.Mult(FixedPoint.Sub(32767, Fac), 20480);
  Gain2 := FixedPoint.ShiftLeft(Gain2, 1);
  if State^.VadHist > 0 then
  begin
    Weight1 := 0;
    Weight2 := 32767;
  end
  else
  begin
    Weight1 := 32767;
    Weight2 := 0;
  end;
  Tmp := FixedPoint.Mult(Weight1, Gain1);
  Tmp := FixedPoint.Add(Tmp, FixedPoint.Mult(Weight2, Gain2));
  if Tmp <> 0 then
    Tmp := FixedPoint.Add(Tmp, 1);
  if FixedPoint.Sub(Tmp, 3277) < 0 then
    Tmp := 3277;
  if (FixedPoint.Sub(NbBits, 477) >= 0) and (Bfi = 0) then
  begin
    HFGainInd := Parameters;
    HFCorrGain := DecMainHPGain[HFGainInd];
    I := 0;
    while I < 80 do
    begin
      HF[I] := FixedPoint.ShiftLeft(FixedPoint.Mult(HF[I], HFCorrGain), 1);
      Inc(I);
    end;
  end
  else
  begin
    I := 0;
    while I < 80 do
    begin
      HF[I] := FixedPoint.Mult(HF[I], Tmp);
      Inc(I);
    end;
  end;
  if (FixedPoint.Sub(NbBits, 132) <= 0) and (FixedPoint.Sub(NewDTXState, 0) = 0) then
  begin
    AmrIsfExtrapolation(HfIsf);
    AmrIspAz(HfIsf, PAMRSmallInt(@HfA[0]), 20, 0);
    AmrWeightA(PAMRSmallInt(@HfA[0]), PAMRSmallInt(@Ap[0]), 29491, 20);
    AmrSynFilt(PAMRSmallInt(@Ap[0]), 20, PAMRSmallInt(@HF[0]), PAMRSmallInt(@HF[0]), 80,
      PAMRSmallInt(@State^.MemSynHf[0]), 1);
  end
  else
  begin
    AmrWeightA(Aq, PAMRSmallInt(@Ap[0]), 19661, 16);
    AmrSynFilt(PAMRSmallInt(@Ap[0]), 16, PAMRSmallInt(@HF[0]), PAMRSmallInt(@HF[0]), 80,
      (PAMRSmallInt(@State^.MemSynHf[0]) + (20 - 16)), 1);
  end;
  AmrFilt6k7k(PAMRSmallInt(@HF[0]), 80, PAMRSmallInt(@State^.MemHf[0]));
  if FixedPoint.Sub(NbBits, 477) >= 0 then
  begin
    AmrFilt7k(PAMRSmallInt(@HF[0]), 80, PAMRSmallInt(@State^.MemHf3[0]));
  end;
  I := 0;
  while I < 80 do
  begin
    Synth16k[I] := FixedPoint.Add(Synth16k[I], HF[I]);
    Inc(I);
  end;
end;

procedure AmrDpisf2s36b(Indice, IsfQ, PastIsfq, Isfold, IsfBuf: PAMRSmallInt; Bfi, EncDec: SmallInt);
var
  RefIsf: array[0..15] of SmallInt;
  I: SmallInt;
  J: SmallInt;
  Tmp: SmallInt;
  LTmp: Integer;
begin
  if Bfi = 0 then
  begin
    I := 0;
    while I < 9 do
    begin
      IsfQ[I] := Qpisf2sDico1Isf[((Indice[0] * 9) + I)];
      Inc(I);
    end;
    I := 0;
    while I < 7 do
    begin
      IsfQ[I + 9] := Qpisf2sDico2Isf[((Indice[1] * 7) + I)];
      Inc(I);
    end;
    I := 0;
    while I < 5 do
    begin
      IsfQ[I] := FixedPoint.Add(IsfQ[I], Qpisf2sDico21Isf36b[((Indice[2] * 5) + I)]);
      Inc(I);
    end;
    I := 0;
    while I < 4 do
    begin
      IsfQ[I + 5] := FixedPoint.Add(IsfQ[I + 5], Qpisf2sDico22Isf36b[((Indice[3] * 4) + I)]);
      Inc(I);
    end;
    I := 0;
    while I < 7 do
    begin
      IsfQ[I + 9] := FixedPoint.Add(IsfQ[I + 9], Qpisf2sDico23Isf36b[((Indice[4] * 7) + I)]);
      Inc(I);
    end;
    I := 0;
    while I < 16 do
    begin
      Tmp := IsfQ[I];
      IsfQ[I] := FixedPoint.Add(Tmp, Qpisf2sMeanIsf[I]);
      IsfQ[I] := FixedPoint.Add(IsfQ[I], FixedPoint.Mult(10923, PastIsfq[I]));
      PastIsfq[I] := Tmp;
      Inc(I);
    end;
    if EncDec <> 0 then
    begin
      I := 0;
      while I < 16 do
      begin
        J := 3 - 1;
        while J > 0 do
        begin
          IsfBuf[(J * 16) + I] := IsfBuf[((J - 1) * 16) + I];
          Dec(J);
        end;
        IsfBuf[I] := IsfQ[I];
        Inc(I);
      end;
    end;
  end
  else
  begin
    I := 0;
    while I < 16 do
    begin
      LTmp := FixedPoint.LMult(Qpisf2sMeanIsf[I], 8192);
      J := 0;
      while J < 3 do
      begin
        LTmp := FixedPoint.LMac(LTmp, IsfBuf[(J * 16) + I], 8192);
        Inc(J);
      end;
      RefIsf[I] := FixedPoint.Round(LTmp);
      Inc(I);
    end;
    I := 0;
    while I < 16 do
    begin
      IsfQ[I] := FixedPoint.Add(FixedPoint.Mult(29491, Isfold[I]), FixedPoint.Mult((32768 - 29491), RefIsf[I]));
      Inc(I);
    end;
    I := 0;
    while I < 16 do
    begin
      Tmp := FixedPoint.Add(RefIsf[I], FixedPoint.Mult(PastIsfq[I], 10923));
      PastIsfq[I] := FixedPoint.Sub(IsfQ[I], Tmp);
      PastIsfq[I] := FixedPoint.ShiftRight(PastIsfq[I], 1);
      Inc(I);
    end;
  end;
  AmrReorderIsf(IsfQ, 128, 16);
end;

