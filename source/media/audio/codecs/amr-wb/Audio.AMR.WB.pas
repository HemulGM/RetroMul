    begin
      Tmp := FixedPoint.Add(RefIsf[I], FixedPoint.Mult(PastIsfq[I], 10923));
      PastIsfq[I] := FixedPoint.Sub(IsfQ[I], Tmp);
      PastIsfq[I] := FixedPoint.ShiftRight(PastIsfq[I], 1);
      Inc(I);
    end;
  end;
  AmrReorderIsf(IsfQ, 128, 16);
end;

procedure AmrIntIsp(IspOld, IspNew, Frac, Az: PAMRSmallInt);
var
  I: SmallInt;
  K: SmallInt;
  FacOld: SmallInt;
  FacNew: SmallInt;
  Isp: array[0..15] of SmallInt;
  LTmp: Integer;
begin
  for K := 0 to 2 do
  begin
    FacNew := Frac[K];
    FacOld := FixedPoint.Add(FixedPoint.Sub(32767, FacNew), 1);
    I := 0;
    while I < 16 do
    begin
      LTmp := FixedPoint.LMult(IspOld[I], FacOld);
      LTmp := FixedPoint.LMac(LTmp, IspNew[I], FacNew);
      Isp[I] := FixedPoint.Round(LTmp);
      Inc(I);
    end;
    AmrIspAz(PAMRSmallInt(@Isp[0]), Az, 16, 0);
    Az := Az + (16 + 1);
  end;
  AmrIspAz(IspNew, Az, 16, 0);
end;

procedure AmrInsert(ArgArray: PAMRSmallInt; N, X: SmallInt);
var
  I: SmallInt;
begin
  I := SmallInt((N - 1));
  while I >= 0 do
  begin
    if FixedPoint.Sub(X, ArgArray[I]) < 0 then
      ArgArray[I + 1] := ArgArray[I]
    else
      Break;
    Dec(I);
  end;
  ArgArray[I + 1] := X;
end;

procedure AmrInsertionSort(ArgArray: PAMRSmallInt; N: SmallInt);
var
  I: SmallInt;
begin
  I := 0;
  while I < N do
  begin
    AmrInsert(ArgArray, I, ArgArray[I]);
    Inc(I);
  end;
end;

procedure AmrLagconc(GainHist, LagHist, T0, OldT0, Seed: PAMRSmallInt; UnusableFrame: SmallInt);
var
  MaxLag: SmallInt;
  MinLag: SmallInt;
  LastLag: SmallInt;
  LagDif: SmallInt;
  MeanLag: SmallInt;
  LagHist2: array[0..4] of SmallInt;
  I: SmallInt;
  Tmp: SmallInt;
  Tmp2: SmallInt;
  MinGain: SmallInt;
  LastGain: SmallInt;
  SecLastGain: SmallInt;
  D: SmallInt;
  D2: SmallInt;
begin
  LagHist2[0] := 0;
  LagHist2[1] := 0;
  LagHist2[2] := 0;
  LagHist2[3] := 0;
  LagHist2[4] := 0;
  LastGain := GainHist[4];
  SecLastGain := GainHist[3];
  LastLag := LagHist[0];
  MinLag := LagHist[0];
  I := 1;
  while I < 5 do
  begin
    if FixedPoint.Sub(LagHist[I], MinLag) < 0 then
      MinLag := LagHist[I];
    Inc(I);
  end;
  MaxLag := LagHist[0];
  I := 1;
  while I < 5 do
  begin
    if FixedPoint.Sub(LagHist[I], MaxLag) > 0 then
      MaxLag := LagHist[I];
    Inc(I);
  end;
  MinGain := GainHist[0];
  I := 1;
  while I < 5 do
  begin
    if FixedPoint.Sub(GainHist[I], MinGain) < 0 then
      MinGain := GainHist[I];
    Inc(I);
  end;
  LagDif := FixedPoint.Sub(MaxLag, MinLag);
  if UnusableFrame <> 0 then
  begin
    if (FixedPoint.Sub(MinGain, 8192) > 0) and (FixedPoint.Sub(LagDif, 10) < 0) then
      T0^ := OldT0^
    else
    begin
      if (FixedPoint.Sub(LastGain, 8192) > 0) and (FixedPoint.Sub(SecLastGain, 8192) > 0) then
        T0^ := LagHist[0]
      else
      begin
        I := 0;
        while I < 5 do
        begin
          LagHist2[I] := LagHist[I];
          Inc(I);
        end;
        AmrInsertionSort(PAMRSmallInt(@LagHist2[0]), 5);
        LagDif := FixedPoint.Sub(LagHist2[4], LagHist2[2]);
        if FixedPoint.Sub(LagDif, 40) > 0 then
          LagDif := 40;
        D := AmrRandom(Seed);
        Tmp := FixedPoint.ShiftRight(LagDif, 1);
        D2 := FixedPoint.Mult(Tmp, D);
        Tmp := FixedPoint.Add(FixedPoint.Add(LagHist2[2], LagHist2[3]), LagHist2[4]);
        T0^ := FixedPoint.Add(FixedPoint.Mult(Tmp, 10923), D2);
      end;
    end;
    if FixedPoint.Sub(T0^, MaxLag) > 0 then
      T0^ := MaxLag;
    if FixedPoint.Sub(T0^, MinLag) < 0 then
      T0^ := MinLag;
  end
  else
  begin
    MeanLag := 0;
    I := 0;
    while I < 5 do
    begin
      MeanLag := FixedPoint.Add(MeanLag, LagHist[I]);
      Inc(I);
    end;
    MeanLag := FixedPoint.Mult(MeanLag, 6554);
    Tmp := FixedPoint.Sub(T0^, MaxLag);
    Tmp2 := FixedPoint.Sub(T0^, LastLag);
    if (FixedPoint.Sub(LagDif, 10) < 0) and (FixedPoint.Sub(T0^, FixedPoint.Sub(MinLag, 5)) > 0) and (FixedPoint.Sub(Tmp, 5) < 0) then
      T0^ := T0^
    else
    begin
      if (FixedPoint.Sub(LastGain, 8192) > 0) and (FixedPoint.Sub(SecLastGain, 8192) > 0) and (FixedPoint.Add(Tmp2, 10) > 0) and
        (FixedPoint.Sub(Tmp2, 10) < 0) then
        T0^ := T0^
      else
      begin
        if (FixedPoint.Sub(MinGain, 6554) < 0) and (FixedPoint.Sub(LastGain, MinGain) = 0) and (FixedPoint.Sub(T0^, MinLag) > 0) and
          (FixedPoint.Sub(T0^, MaxLag) < 0) then
          T0^ := T0^
        else
        begin
          if (FixedPoint.Sub(LagDif, 70) < 0) and (FixedPoint.Sub(T0^, MinLag) > 0) and (FixedPoint.Sub(T0^, MaxLag) < 0) then
            T0^ := T0^
          else
          begin
            if (FixedPoint.Sub(T0^, MeanLag) > 0) and (FixedPoint.Sub(T0^, MaxLag) < 0) then
              T0^ := T0^
            else
            begin
              if (Ord((FixedPoint.Sub(MinGain, 8192) > 0)) and Ord((FixedPoint.Sub(LagDif, 10) < 0))) <> 0 then
                T0^ := LagHist[0]
              else
              begin
                if (FixedPoint.Sub(LastGain, 8192) > 0) and (FixedPoint.Sub(SecLastGain, 8192) > 0) then
                  T0^ := LagHist[0]
                else
                begin
                  I := 0;
                  while I < 5 do
                  begin
                    LagHist2[I] := LagHist[I];
                    Inc(I);
                  end;
                  AmrInsertionSort(PAMRSmallInt(@LagHist2[0]), 5);
                  LagDif := FixedPoint.Sub(LagHist2[4], LagHist2[2]);
                  if FixedPoint.Sub(LagDif, 40) > 0 then
                    LagDif := 40;
                  D := AmrRandom(Seed);
                  Tmp := FixedPoint.ShiftRight(LagDif, 1);
                  D2 := FixedPoint.Mult(Tmp, D);
                  Tmp := FixedPoint.Add(FixedPoint.Add(LagHist2[2], LagHist2[3]), LagHist2[4]);
                  T0^ := FixedPoint.Add(FixedPoint.Mult(Tmp, 10923), D2);
                end;
              end;
              if FixedPoint.Sub(T0^, MaxLag) > 0 then
                T0^ := MaxLag;
              if FixedPoint.Sub(T0^, MinLag) < 0 then
                T0^ := MinLag;
            end;
          end;
        end;
      end;
    end;
  end;
end;

procedure AmrPredLt4(Exc: PAMRSmallInt; T0, Frac, LSubfr: SmallInt);
var
  I: SmallInt;
  J: SmallInt;
  K: SmallInt;
  X: PAMRSmallInt;
  LSum: Integer;
begin
  X := PAMRSmallInt(@Exc[-T0]);
  Frac := AmrNegate(Frac);
  if Frac < 0 then
  begin
    Frac := FixedPoint.Add(Frac, 4);
    Dec(X);
  end;
  X := (X - 16) + 1;
  J := 0;
  while J < LSubfr do
  begin
    LSum := 0;
    I := 0;
    K := FixedPoint.Sub(FixedPoint.Sub(4, 1), Frac);
    while I < (2 * 16) do
    begin
      LSum := FixedPoint.LMac(LSum, X[I], PredLt4Inter42[K]);
      Inc(I);
      K := K + 4;
    end;
    LSum := FixedPoint.LShl(LSum, 1);
    Exc[J] := FixedPoint.Round(LSum);
    Inc(X);
    Inc(J);
  end;
end;

procedure AmrDECACELP2t64Fx(ArgIndex: SmallInt; Code: PAMRSmallInt);
var
  I: SmallInt;
  I0: SmallInt;
  I1: SmallInt;
begin
  for I := 0 to 63 do
    Code[I] := 0;
  I0 := SmallInt((FixedPoint.ShiftRight(ArgIndex, 5) and $3E));
  I1 := SmallInt(FixedPoint.Add(FixedPoint.ShiftLeft(SmallInt((ArgIndex and $1F)), 1), 1));
  if (FixedPoint.ShiftRight(ArgIndex, 6) and 32) = 0 then
    Code[I0] := 512
  else
    Code[I0] := -512;
  if (ArgIndex and 32) = 0 then
    Code[I1] := 512
  else
    Code[I1] := -512;
end;

procedure AmrDec1pN1(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  Pos1: SmallInt;
  Mask: Integer;
  I: Integer;
begin
  Mask := AmrLDepositL(FixedPoint.Sub(FixedPoint.ShiftLeft(1, N), 1));
  Pos1 := FixedPoint.Add(AmrExtractL((ArgIndex and Mask)), Offset);
  I := FixedPoint.LShr(ArgIndex, N) and 1;
  if FixedPoint.LSub(I, 1) = 0 then
    Pos1 := FixedPoint.Add(Pos1, 16);
  Pos[0] := Pos1;
end;

procedure AddCodebookPulses(Pos: PAMRSmallInt; NbPulse, Track: SmallInt; Code: PAMRSmallInt);
var
  I: SmallInt;
  K: SmallInt;
begin
  K := 0;
  while K < NbPulse do
  begin
    I := SmallInt(FixedPoint.Add(FixedPoint.ShiftLeft(SmallInt((Pos[K] and (16 - 1))), 2), Track));
    if (Pos[K] and 16) = 0 then
      Code[I] := FixedPoint.Add(Code[I], 512)
    else
      Code[I] := FixedPoint.Sub(Code[I], 512);
    Inc(K);
  end;
end;

procedure AmrDec2p2N1(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  Pos1: SmallInt;
  Pos2: SmallInt;
  Tmp: SmallInt;
  Mask: Integer;
  I: Integer;
begin
  Mask := AmrLDepositL(FixedPoint.Sub(FixedPoint.ShiftLeft(1, N), 1));
  Pos1 := AmrExtractL(FixedPoint.LAdd((FixedPoint.LShr(ArgIndex, N) and Mask), AmrLDepositL(Offset)));
  Tmp := FixedPoint.ShiftLeft(N, 1);
  I := FixedPoint.LShr(ArgIndex, Tmp) and 1;
  Pos2 := FixedPoint.Add(AmrExtractL((ArgIndex and Mask)), Offset);
  if FixedPoint.Sub(Pos2, Pos1) < 0 then
  begin
    if FixedPoint.LSub(I, 1) = 0 then
      Pos1 := FixedPoint.Add(Pos1, 16)
    else
      Pos2 := FixedPoint.Add(Pos2, 16);
  end
  else
  begin
    if FixedPoint.LSub(I, 1) = 0 then
    begin
      Pos1 := FixedPoint.Add(Pos1, 16);
      Pos2 := FixedPoint.Add(Pos2, 16);
    end;
  end;
  Pos[0] := Pos1;
  Pos[1] := Pos2;
end;

procedure AmrDec3p3N1(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  J: SmallInt;
  Tmp: SmallInt;
  Mask: Integer;
  Idx: Integer;
begin
  Tmp := FixedPoint.Sub(FixedPoint.ShiftLeft(N, 1), 1);
  Mask := FixedPoint.LSub(FixedPoint.LShl(1, Tmp), 1);
  Idx := ArgIndex and Mask;
  J := Offset;
  Tmp := FixedPoint.Sub(FixedPoint.ShiftLeft(N, 1), 1);
  if (FixedPoint.LShr(ArgIndex, Tmp) and 1) <> 0 then
    J := FixedPoint.Add(J, FixedPoint.ShiftLeft(1, FixedPoint.Sub(N, 1)));
  AmrDec2p2N1(Idx, SmallInt((N - 1)), J, Pos);
  Mask := FixedPoint.Sub(FixedPoint.ShiftLeft(1, FixedPoint.Add(N, 1)), 1);
  Tmp := FixedPoint.ShiftLeft(N, 1);
  Idx := FixedPoint.LShr(ArgIndex, Tmp) and Mask;
  AmrDec1pN1(Idx, N, Offset, (Pos + 2));
end;

procedure AmrDec4p4N1(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  J: SmallInt;
  Tmp: SmallInt;
  Mask: Integer;
  Idx: Integer;
begin
  Tmp := FixedPoint.Sub(FixedPoint.ShiftLeft(N, 1), 1);
  Mask := FixedPoint.LSub(FixedPoint.LShl(1, Tmp), 1);
  Idx := ArgIndex and Mask;
  J := Offset;
  Tmp := FixedPoint.Sub(FixedPoint.ShiftLeft(N, 1), 1);
  if (FixedPoint.LShr(ArgIndex, Tmp) and 1) <> 0 then
    J := FixedPoint.Add(J, FixedPoint.ShiftLeft(1, FixedPoint.Sub(N, 1)));
  AmrDec2p2N1(Idx, SmallInt((N - 1)), J, Pos);
  Tmp := FixedPoint.Add(FixedPoint.ShiftLeft(N, 1), 1);
  Mask := FixedPoint.LSub(FixedPoint.LShl(1, Tmp), 1);
  Idx := FixedPoint.LShr(ArgIndex, FixedPoint.ShiftLeft(N, 1)) and Mask;
  AmrDec2p2N1(Idx, N, Offset, (Pos + 2));
end;

procedure AmrDec4p4N(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  J: SmallInt;
  N1: SmallInt;
  Tmp: SmallInt;
begin
  N1 := SmallInt((N - 1));
  J := FixedPoint.Add(Offset, FixedPoint.ShiftLeft(1, N1));
  Tmp := FixedPoint.Sub(FixedPoint.ShiftLeft(N, 2), 2);
  case FixedPoint.LShr(ArgIndex, Tmp) and 3 of
    0:
      begin
        Tmp := FixedPoint.Add(FixedPoint.ShiftLeft(N1, 2), 1);
        if (FixedPoint.LShr(ArgIndex, Tmp) and 1) = 0 then
        begin
          AmrDec4p4N1(ArgIndex, N1, Offset, Pos);
        end
        else
        begin
          AmrDec4p4N1(ArgIndex, N1, J, Pos);
        end;
      end;
    1:
      begin
        Tmp := FixedPoint.Add(AmrExtractL(FixedPoint.LShr(FixedPoint.LMult(3, N1), 1)), 1);
        AmrDec1pN1(FixedPoint.LShr(ArgIndex, Tmp), N1, Offset, Pos);
        AmrDec3p3N1(ArgIndex, N1, J, (Pos + 1));
      end;
    2:
      begin
        Tmp := FixedPoint.Add(FixedPoint.ShiftLeft(N1, 1), 1);
        AmrDec2p2N1(FixedPoint.LShr(ArgIndex, Tmp), N1, Offset, Pos);
        AmrDec2p2N1(ArgIndex, N1, J, (Pos + 2));
      end;
    3:
      begin
        Tmp := FixedPoint.Add(N1, 1);
        AmrDec3p3N1(FixedPoint.LShr(ArgIndex, Tmp), N1, Offset, Pos);
        AmrDec1pN1(ArgIndex, N1, J, (Pos + 3));
      end;
  end;
end;

procedure AmrDec5p5N(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  J: SmallInt;
  N1: SmallInt;
  Tmp: SmallInt;
  Idx: Integer;
begin
  N1 := SmallInt((N - 1));
  J := FixedPoint.Add(Offset, FixedPoint.ShiftLeft(1, N1));
  Tmp := FixedPoint.Add(FixedPoint.ShiftLeft(N, 1), 1);
  Idx := FixedPoint.LShr(ArgIndex, Tmp);
  Tmp := FixedPoint.Sub(AmrExtractL(FixedPoint.LShr(FixedPoint.LMult(5, N), 1)), 1);
  if (FixedPoint.LShr(ArgIndex, Tmp) and 1) = 0 then
  begin
    AmrDec3p3N1(Idx, N1, Offset, Pos);
    AmrDec2p2N1(ArgIndex, N, Offset, (Pos + 3));
  end
  else
  begin
    AmrDec3p3N1(Idx, N1, J, Pos);
    AmrDec2p2N1(ArgIndex, N, Offset, (Pos + 3));
  end;
end;

procedure AmrDec6p6N2(ArgIndex: Integer; N, Offset: SmallInt; Pos: PAMRSmallInt);
var
  J: SmallInt;
  N1: SmallInt;
  OffsetA: SmallInt;
  OffsetB: SmallInt;
begin
  N1 := SmallInt((N - 1));
  J := FixedPoint.Add(Offset, FixedPoint.ShiftLeft(1, N1));
  OffsetB := J;
  OffsetA := OffsetB;
  if (FixedPoint.LShr(ArgIndex, SmallInt(((6 * N) - 5))) and 1) = 0 then
    OffsetA := Offset
  else
    OffsetB := Offset;
  case FixedPoint.LShr(ArgIndex, SmallInt(((6 * N) - 4))) and 3 of
    0:
      begin
        AmrDec5p5N(FixedPoint.LShr(ArgIndex, N), N1, OffsetA, Pos);
        AmrDec1pN1(ArgIndex, N1, OffsetA, (Pos + 5));
      end;
    1:
      begin
        AmrDec5p5N(FixedPoint.LShr(ArgIndex, N), N1, OffsetA, Pos);
        AmrDec1pN1(ArgIndex, N1, OffsetB, (Pos + 5));
      end;
    2:
      begin
        AmrDec4p4N(FixedPoint.LShr(ArgIndex, SmallInt(((2 * N1) + 1))), N1, OffsetA, Pos);
        AmrDec2p2N1(ArgIndex, N1, OffsetB, (Pos + 4));
      end;
    3:
      begin
        AmrDec3p3N1(FixedPoint.LShr(ArgIndex, SmallInt(((3 * N1) + 1))), N1, Offset, Pos);
        AmrDec3p3N1(ArgIndex, N1, J, (Pos + 3));
      end;
  end;
end;

procedure AmrDECACELP4t64Fx(ArgIndex: PAMRSmallInt; Nbbits: SmallInt; Code: PAMRSmallInt);
var
  I: SmallInt;
  K: SmallInt;
  Pos: array[0..5] of SmallInt;
  LIndex: Integer;
begin
  for I := 0 to 63 do
    Code[I] := 0;
  if FixedPoint.Sub(Nbbits, 20) = 0 then
  begin
    K := 0;
    while K < 4 do
    begin
      LIndex := ArgIndex[K];
      AmrDec1pN1(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
      AddCodebookPulses(PAMRSmallInt(@Pos[0]), 1, K, Code);
      Inc(K);
    end;
  end
  else
  begin
    if FixedPoint.Sub(Nbbits, 36) = 0 then
    begin
      K := 0;
      while K < 4 do
      begin
        LIndex := ArgIndex[K];
        AmrDec2p2N1(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
        AddCodebookPulses(PAMRSmallInt(@Pos[0]), 2, K, Code);
        Inc(K);
      end;
    end
    else
    begin
      if FixedPoint.Sub(Nbbits, 44) = 0 then
      begin
        K := 0;
        while K < (4 - 2) do
        begin
          LIndex := ArgIndex[K];
          AmrDec3p3N1(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
          AddCodebookPulses(PAMRSmallInt(@Pos[0]), 3, K, Code);
          Inc(K);
        end;
        K := 2;
        while K < 4 do
        begin
          LIndex := ArgIndex[K];
          AmrDec2p2N1(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
          AddCodebookPulses(PAMRSmallInt(@Pos[0]), 2, K, Code);
          Inc(K);
        end;
      end
      else
      begin
        if FixedPoint.Sub(Nbbits, 52) = 0 then
        begin
          K := 0;
          while K < 4 do
          begin
            LIndex := ArgIndex[K];
            AmrDec3p3N1(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
            AddCodebookPulses(PAMRSmallInt(@Pos[0]), 3, K, Code);
            Inc(K);
          end;
        end
        else
        begin
          if FixedPoint.Sub(Nbbits, 64) = 0 then
          begin
            K := 0;
            while K < 4 do
            begin
              LIndex := FixedPoint.LAdd(FixedPoint.LShl(ArgIndex[K], 14), ArgIndex[K + 4]);
              AmrDec4p4N(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
              AddCodebookPulses(PAMRSmallInt(@Pos[0]), 4, K, Code);
              Inc(K);
            end;
          end
          else
          begin
            if FixedPoint.Sub(Nbbits, 72) = 0 then
            begin
              K := 0;
              while K < (4 - 2) do
              begin
                LIndex := FixedPoint.LAdd(FixedPoint.LShl(ArgIndex[K], 10), ArgIndex[K + 4]);
                AmrDec5p5N(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
                AddCodebookPulses(PAMRSmallInt(@Pos[0]), 5, K, Code);
                Inc(K);
              end;
              K := 2;
              while K < 4 do
              begin
                LIndex := FixedPoint.LAdd(FixedPoint.LShl(ArgIndex[K], 14), ArgIndex[K + 4]);
                AmrDec4p4N(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
                AddCodebookPulses(PAMRSmallInt(@Pos[0]), 4, K, Code);
                Inc(K);
              end;
            end
            else
            begin
              if FixedPoint.Sub(Nbbits, 88) = 0 then
              begin
                K := 0;
                while K < 4 do
                begin
                  LIndex := FixedPoint.LAdd(FixedPoint.LShl(ArgIndex[K], 11), ArgIndex[K + 4]);
                  AmrDec6p6N2(LIndex, 4, 0, PAMRSmallInt(@Pos[0]));
                  AddCodebookPulses(PAMRSmallInt(@Pos[0]), 6, K, Code);
                  Inc(K);
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

procedure AmrPreemph(X: PAMRSmallInt; Mu, Lg: SmallInt; Mem: PAMRSmallInt);
var
  I: SmallInt;
  Temp: SmallInt;
  LTmp: Integer;
begin
  Temp := X[Lg - 1];
  I := SmallInt((Lg - 1));
  while I > 0 do
  begin
    LTmp := AmrLDepositH(X[I]);
    LTmp := FixedPoint.LMsu(LTmp, X[I - 1], Mu);
    X[I] := FixedPoint.Round(LTmp);
    Dec(I);
  end;
  LTmp := AmrLDepositH(X[0]);
  LTmp := FixedPoint.LMsu(LTmp, Mem^, Mu);
  X[0] := FixedPoint.Round(LTmp);
  Mem^ := Temp;
end;

procedure AmrPitShrp(X: PAMRSmallInt; PitLag, Sharp, LSubfr: SmallInt);
var
  I: SmallInt;
  LTmp: Integer;
begin
  I := PitLag;
  while I < LSubfr do
  begin
    LTmp := AmrLDepositH(X[I]);
    LTmp := FixedPoint.LMac(LTmp, X[I - PitLag], Sharp);
    X[I] := FixedPoint.Round(LTmp);
    Inc(I);
  end;
end;

function AmrMedian5(X: PAMRSmallInt): SmallInt;
var
  X1: SmallInt;
  X2: SmallInt;
  X3: SmallInt;
  X4: SmallInt;
  X5: SmallInt;
  Tmp: SmallInt;
begin
  X1 := X[-2];
  X2 := X[-1];
  X3 := X[0];
  X4 := X[1];
  X5 := X[2];
  if FixedPoint.Sub(X2, X1) < 0 then
  begin
    Tmp := X1;
    X1 := X2;
    X2 := Tmp;
  end;
  if FixedPoint.Sub(X3, X1) < 0 then
  begin
    Tmp := X1;
    X1 := X3;
    X3 := Tmp;
  end;
  if FixedPoint.Sub(X4, X1) < 0 then
  begin
    Tmp := X1;
    X1 := X4;
    X4 := Tmp;
  end;
  if FixedPoint.Sub(X5, X1) < 0 then
    X5 := X1;
  if FixedPoint.Sub(X3, X2) < 0 then
  begin
    Tmp := X2;
    X2 := X3;
    X3 := Tmp;
  end;
  if FixedPoint.Sub(X4, X2) < 0 then
  begin
    Tmp := X2;
    X2 := X4;
    X4 := Tmp;
  end;
  if FixedPoint.Sub(X5, X2) < 0 then
    X5 := X2;
  if FixedPoint.Sub(X4, X3) < 0 then
    X3 := X4;
  if FixedPoint.Sub(X5, X3) < 0 then
    X3 := X5;
  Result := X3;
end;

procedure AmrDGain2(ArgIndex, Nbits: SmallInt; Code: PAMRSmallInt; LSubfr: SmallInt; GainPit: PAMRSmallInt; GainCod: PAMRInteger; Bfi, PrevBfi, State, UnusableFrame, VadHist: SmallInt; Mem: PAMRSmallInt);
var
  P: PAMRSmallInt;
  PastGainPit: PAMRSmallInt;
  PastGainCode: PAMRSmallInt;
  PastQuaEn: PAMRSmallInt;
  Gbuf: PAMRSmallInt;
  Pbuf: PAMRSmallInt;
  PrevGc: PAMRSmallInt;
  Pbuf2: PAMRSmallInt;
  I: SmallInt;
  Tmp: SmallInt;
  Exp: SmallInt;
  Frac: SmallInt;
  Gcode0: SmallInt;
  ExpGcode0: SmallInt;
  QuaEner: SmallInt;
  GcodeInov: SmallInt;
  GCode: SmallInt;
  LTmp: Integer;
begin
  PastQuaEn := Mem;
  PastGainPit := Mem + 4;
  PastGainCode := Mem + 5;
  PrevGc := Mem + 6;
  Pbuf := Mem + 7;
  Gbuf := Mem + 12;
  Pbuf2 := Mem + 17;
  LTmp := AmrDotProduct12(Code, Code, LSubfr, PAMRSmallInt(@Exp));
  Exp := FixedPoint.Sub(Exp, (18 + 6));
  AmrIsqrtN(PAMRInteger(@LTmp), PAMRSmallInt(@Exp));
  GcodeInov := AmrExtractH(FixedPoint.LShl(LTmp, FixedPoint.Sub(Exp, 3)));
  if Bfi <> 0 then
  begin
    Tmp := AmrMedian5(PAMRSmallInt(@Pbuf[2]));
    PastGainPit^ := Tmp;
    if FixedPoint.Sub(PastGainPit^, 15565) > 0 then
      PastGainPit^ := 15565;
    if UnusableFrame <> 0 then
      GainPit^ := FixedPoint.Mult(AMRPdownUnusable[State], PastGainPit^)
    else
      GainPit^ := FixedPoint.Mult(AMRPdownUsable[State], PastGainPit^);
    Tmp := AmrMedian5(PAMRSmallInt(@Gbuf[2]));
    if FixedPoint.Sub(VadHist, 2) > 0 then
      PastGainCode^ := Tmp
    else
    begin
      if UnusableFrame <> 0 then
        PastGainCode^ := FixedPoint.Mult(AMRCdownUnusable[State], Tmp)
      else
        PastGainCode^ := FixedPoint.Mult(AMRCdownUsable[State], Tmp);
    end;
    LTmp := FixedPoint.LMult(PastQuaEn[0], 8192);
    LTmp := FixedPoint.LMac(LTmp, PastQuaEn[1], 8192);
    LTmp := FixedPoint.LMac(LTmp, PastQuaEn[2], 8192);
    LTmp := FixedPoint.LMac(LTmp, PastQuaEn[3], 8192);
    QuaEner := AmrExtractH(LTmp);
    QuaEner := FixedPoint.Sub(QuaEner, 3072);
    if FixedPoint.Sub(QuaEner, (-14336)) < 0 then
      QuaEner := -14336;
    PastQuaEn[3] := PastQuaEn[2];
    PastQuaEn[2] := PastQuaEn[1];
    PastQuaEn[1] := PastQuaEn[0];
    PastQuaEn[0] := QuaEner;
    I := 1;
    while I < 5 do
    begin
      Gbuf[I - 1] := Gbuf[I];
      Inc(I);
    end;
    Gbuf[4] := PastGainCode^;
    I := 1;
    while I < 5 do
    begin
      Pbuf[I - 1] := Pbuf[I];
      Inc(I);
    end;
    Pbuf[4] := PastGainPit^;
    GainCod^ := FixedPoint.LMult(PastGainCode^, GcodeInov);
    Exit;
  end;
  LTmp := AmrLDepositH(30);
  LTmp := FixedPoint.LShl(LTmp, 8);
  LTmp := FixedPoint.LMac(LTmp, DGain2Pred[0], PastQuaEn[0]);
  LTmp := FixedPoint.LMac(LTmp, DGain2Pred[1], PastQuaEn[1]);
  LTmp := FixedPoint.LMac(LTmp, DGain2Pred[2], PastQuaEn[2]);
  LTmp := FixedPoint.LMac(LTmp, DGain2Pred[3], PastQuaEn[3]);
  Gcode0 := AmrExtractH(LTmp);
  LTmp := FixedPoint.LMult(Gcode0, 5443);
  LTmp := FixedPoint.LShr(LTmp, 8);
  FixedPoint.LExtract(LTmp, PAMRSmallInt(@ExpGcode0), PAMRSmallInt(@Frac));
  Gcode0 := AmrExtractL(FixedPoint.Pow2(14, Frac));
  ExpGcode0 := FixedPoint.Sub(ExpGcode0, 14);
  if FixedPoint.Sub(Nbits, 6) = 0 then
    P := PAMRSmallInt(@DGain2TQuaGain6b[FixedPoint.Add(ArgIndex, ArgIndex)])
  else
    P := PAMRSmallInt(@DGain2TQuaGain7b[FixedPoint.Add(ArgIndex, ArgIndex)]);
  GainPit^ := P^;
  Inc(P);
  GCode := P^;
  LTmp := FixedPoint.LMult(GCode, Gcode0);
  LTmp := FixedPoint.LShl(LTmp, FixedPoint.Add(ExpGcode0, 4));
  GainCod^ := LTmp;
  if FixedPoint.Sub(PrevBfi, 1) = 0 then
  begin
    LTmp := FixedPoint.LMult(PrevGc^, 5120);
    if (FixedPoint.LSub(GainCod^, LTmp) > 0) and (FixedPoint.LSub(GainCod^, 6553600) > 0) then
      GainCod^ := LTmp;
  end;
  PastGainCode^ := FixedPoint.Round(FixedPoint.LShl(GainCod^, 3));
  PastGainPit^ := GainPit^;
  PrevGc^ := PastGainCode^;
  I := 1;
  while I < 5 do
  begin
    Gbuf[I - 1] := Gbuf[I];
    Inc(I);
  end;
  Gbuf[4] := PastGainCode^;
  I := 1;
  while I < 5 do
  begin
    Pbuf[I - 1] := Pbuf[I];
    Inc(I);
  end;
  Pbuf[4] := PastGainPit^;
  I := 1;
  while I < 5 do
  begin
    Pbuf2[I - 1] := Pbuf2[I];
    Inc(I);
  end;
  Pbuf2[4] := PastGainPit^;
  FixedPoint.LExtract(GainCod^, PAMRSmallInt(@Exp), PAMRSmallInt(@Frac));
  LTmp := FixedPoint.Mpy3216(Exp, Frac, GcodeInov);
  GainCod^ := FixedPoint.LShl(LTmp, 3);
  LTmp := AmrLDepositL(GCode);
  FixedPoint.Log2(LTmp, PAMRSmallInt(@Exp), PAMRSmallInt(@Frac));
  Exp := FixedPoint.Sub(Exp, 11);
  LTmp := FixedPoint.Mpy3216(Exp, Frac, 24660);
  QuaEner := AmrExtractL(FixedPoint.LShr(LTmp, 3));
  PastQuaEn[3] := PastQuaEn[2];
  PastQuaEn[2] := PastQuaEn[1];
  PastQuaEn[1] := PastQuaEn[0];
  PastQuaEn[0] := QuaEner;
end;

function AmrVoiceFactor(Exc: PAMRSmallInt; QExc, GainPit: SmallInt; Code: PAMRSmallInt; GainCode, LSubfr: SmallInt): SmallInt;
var
  I: SmallInt;
  Tmp: SmallInt;
  Exp: SmallInt;
  Ener1: SmallInt;
  Exp1: SmallInt;
  Ener2: SmallInt;
  Exp2: SmallInt;
  LTmp: Integer;
begin
  Ener1 := AmrExtractH(AmrDotProduct12(Exc, Exc, LSubfr, PAMRSmallInt(@Exp1)));
  Exp1 := FixedPoint.Sub(Exp1, FixedPoint.Add(QExc, QExc));
  LTmp := FixedPoint.LMult(GainPit, GainPit);
  Exp := AmrNormL(LTmp);
  Tmp := AmrExtractH(FixedPoint.LShl(LTmp, Exp));
  Ener1 := FixedPoint.Mult(Ener1, Tmp);
  Exp1 := FixedPoint.Sub(FixedPoint.Sub(Exp1, Exp), 10);
  Ener2 := AmrExtractH(AmrDotProduct12(Code, Code, LSubfr, PAMRSmallInt(@Exp2)));
  Exp := AmrNormS(GainCode);
  Tmp := FixedPoint.ShiftLeft(GainCode, Exp);
  Tmp := FixedPoint.Mult(Tmp, Tmp);
  Ener2 := FixedPoint.Mult(Ener2, Tmp);
  Exp2 := FixedPoint.Sub(Exp2, FixedPoint.Add(Exp, Exp));
  I := FixedPoint.Sub(Exp1, Exp2);
  if I >= 0 then
  begin
    Ener1 := FixedPoint.ShiftRight(Ener1, 1);
    Ener2 := FixedPoint.ShiftRight(Ener2, FixedPoint.Add(I, 1));
  end
  else
  begin
    Ener1 := FixedPoint.ShiftRight(Ener1, FixedPoint.Sub(1, I));
    Ener2 := FixedPoint.ShiftRight(Ener2, 1);
  end;
  Tmp := FixedPoint.Sub(Ener1, Ener2);
  Ener1 := FixedPoint.Add(FixedPoint.Add(Ener1, Ener2), 1);
  if Tmp >= 0 then
    Tmp := FixedPoint.DivS(Tmp, Ener1)
  else
    Tmp := AmrNegate(FixedPoint.DivS(AmrNegate(Tmp), Ener1));
  Result := Tmp;
end;

procedure AmrPhaseDispersion(GainCode, GainPit: SmallInt; Code: PAMRSmallInt; Mode: SmallInt; DispMem: PAMRSmallInt);
var
  I: SmallInt;
  J: SmallInt;
  State: SmallInt;
  PrevGainPit: PAMRSmallInt;
  PrevGainCode: PAMRSmallInt;
  PrevState: PAMRSmallInt;
  Code2: array[0..127] of SmallInt;
begin
  PrevState := DispMem;
  PrevGainCode := DispMem + 1;
  PrevGainPit := DispMem + 2;
  ZeroSamples(PAMRSmallInt(@Code2[0]), (2 * 64));
  if FixedPoint.Sub(GainPit, 9830) < 0 then
    State := 0
  else
  begin
    if FixedPoint.Sub(GainPit, 14746) < 0 then
      State := 1
    else
      State := 2;
  end;
  I := 5;
  while I > 0 do
  begin
    PrevGainPit[I] := PrevGainPit[I - 1];
    Dec(I);
  end;
  PrevGainPit[0] := GainPit;
  if FixedPoint.Sub(FixedPoint.Sub(GainCode, PrevGainCode^), FixedPoint.ShiftLeft(PrevGainCode^, 1)) > 0 then
  begin
    if FixedPoint.Sub(State, 2) < 0 then
      State := FixedPoint.Add(State, 1);
  end
  else
  begin
    J := 0;
    I := 0;
    while I < 6 do
    begin
      if FixedPoint.Sub(PrevGainPit[I], 9830) < 0 then
        J := FixedPoint.Add(J, 1);
      Inc(I);
    end;
    if FixedPoint.Sub(J, 2) > 0 then
      State := 0;
    if FixedPoint.Sub(FixedPoint.Sub(State, PrevState^), 1) > 0 then
      State := FixedPoint.Sub(State, 1);
  end;
  PrevGainCode^ := GainCode;
  PrevState^ := State;
  State := FixedPoint.Add(State, Mode);
  if State = 0 then
  begin
    I := 0;
    while I < 64 do
    begin
      if Code[I] <> 0 then
      begin
        J := 0;
        while J < 64 do
        begin
          Code2[I + J] := FixedPoint.Add(Code2[I + J], AmrMultR(Code[I], PhDispPhImpLow[J]));
          Inc(J);
        end;
      end;
      Inc(I);
    end;
  end
  else
  begin
    if FixedPoint.Sub(State, 1) = 0 then
    begin
      I := 0;
      while I < 64 do
      begin
        if Code[I] <> 0 then
        begin
          J := 0;
          while J < 64 do
          begin
            Code2[I + J] := FixedPoint.Add(Code2[I + J], AmrMultR(Code[I], PhDispPhImpMid[J]));
            Inc(J);
          end;
        end;
        Inc(I);
      end;
    end;
  end;
  if FixedPoint.Sub(State, 2) < 0 then
  begin
    I := 0;
    while I < 64 do
    begin
      Code[I] := FixedPoint.Add(Code2[I], Code2[I + 64]);
      Inc(I);
    end;
  end;
end;

function AmrIsqrt(LX: Integer): Integer;
var
  Exp: SmallInt;
  LY: Integer;
begin
  Exp := AmrNormL(LX);
  LX := FixedPoint.LShl(LX, Exp);
  Exp := FixedPoint.Sub(31, Exp);
  AmrIsqrtN(PAMRInteger(@LX), PAMRSmallInt(@Exp));
  LY := FixedPoint.LShl(LX, Exp);
  Result := LY;
end;

procedure AmrAgc2(SigIn, SigOut: PAMRSmallInt; LTrm: SmallInt);
var
  I: SmallInt;
  Exp: SmallInt;
  GainIn: SmallInt;
  GainOut: SmallInt;
  G0: SmallInt;
  S: Integer;
  Temp: SmallInt;
begin
  Temp := FixedPoint.ShiftRight(SigOut[0], 2);
  S := FixedPoint.LMult(Temp, Temp);
  I := 1;
  while I < LTrm do
  begin
    Temp := FixedPoint.ShiftRight(SigOut[I], 2);
    S := FixedPoint.LMac(S, Temp, Temp);
    Inc(I);
  end;
  if S = 0 then
    Exit;
  Exp := FixedPoint.Sub(AmrNormL(S), 1);
  GainOut := FixedPoint.Round(FixedPoint.LShl(S, Exp));
  Temp := FixedPoint.ShiftRight(SigIn[0], 2);
  S := FixedPoint.LMult(Temp, Temp);
  I := 1;
  while I < LTrm do
  begin
    Temp := FixedPoint.ShiftRight(SigIn[I], 2);
    S := FixedPoint.LMac(S, Temp, Temp);
    Inc(I);
  end;
  if S = 0 then
    G0 := 0
  else
  begin
    I := AmrNormL(S);
    GainIn := FixedPoint.Round(FixedPoint.LShl(S, I));
    Exp := FixedPoint.Sub(Exp, I);
    S := AmrLDepositL(FixedPoint.DivS(GainOut, GainIn));
    S := FixedPoint.LShl(S, 7);
    S := FixedPoint.LShr(S, Exp);
    S := AmrIsqrt(S);
    G0 := FixedPoint.Round(FixedPoint.LShl(S, 9));
  end;
  I := 0;
  while I < LTrm do
  begin
    SigOut[I] := AmrExtractH(FixedPoint.LShl(FixedPoint.LMult(SigOut[I], G0), 2));
    Inc(I);
  end;
end;

procedure AmrDtxDecActivityUpdate(State: PAMRdtxDecState; Isf, Exc: PAMRSmallInt);
var
  I: SmallInt;
  LFrameEn: Integer;
  LogEnE: SmallInt;
  LogEnM: SmallInt;
  LogEn: SmallInt;
begin
  State^.HistPtr := FixedPoint.Add(State^.HistPtr, 1);
  if FixedPoint.Sub(State^.HistPtr, 8) = 0 then
    State^.HistPtr := 0;
  CopySamples(Isf, PAMRSmallInt(@State^.IsfHist[State^.HistPtr * 16]), 16);
  LFrameEn := 0;
  for I := 0 to 255 do
    LFrameEn := FixedPoint.LMac(LFrameEn, Exc[I], Exc[I]);
  LFrameEn := FixedPoint.LShr(LFrameEn, 1);
  FixedPoint.Log2(LFrameEn, PAMRSmallInt(@LogEnE), PAMRSmallInt(@LogEnM));
  LogEn := FixedPoint.ShiftLeft(LogEnE, 7);
  LogEn := FixedPoint.Add(LogEn, FixedPoint.ShiftRight(LogEnM, (15 - 7)));
  LogEn := FixedPoint.Sub(LogEn, 1024);
  State^.LogEnHist[State^.HistPtr] := LogEn;
end;

procedure DecodeFrame(Mode: SmallInt; Parameters, Synth16k, FrameLength: PAMRSmallInt; SpdState: Pointer; FrameType: SmallInt);
var
  StateValue: PAMRDecoderState;
  OldExc: array[0..504] of SmallInt;
  Exc: PAMRSmallInt;
  PAq: PAMRSmallInt;
  Aq: array[0..67] of SmallInt;
  Ispnew: array[0..15] of SmallInt;
  Isf: array[0..15] of SmallInt;
  Code: array[0..63] of SmallInt;
  Code2: array[0..63] of SmallInt;
  Exc2: array[0..255] of SmallInt;
  Fac: SmallInt;
  StabFac: SmallInt;
  VoiceFac: SmallInt;
  QNew: SmallInt;
  LTmp: Integer;
  LGainCode: Integer;
  I: SmallInt;
  J: SmallInt;
  ISubfr: SmallInt;
  IndexValue: SmallInt;
  Ind: array[0..7] of SmallInt;
  Max: SmallInt;
  Tmp: SmallInt;
  T0: SmallInt;
  T0Frac: SmallInt;
  PitFlag: SmallInt;
  T0Max: SmallInt;
  Select: SmallInt;
  T0Min: SmallInt;
  GainPit: SmallInt;
  GainCode: SmallInt;
  GainCodeLo: SmallInt;
  NewDTXState: SmallInt;
  Bfi: SmallInt;
  UnusableFrame: SmallInt;
  NbBits: SmallInt;
  VadFlag: SmallInt;
  PitSharp: SmallInt;
  Excp: array[0..63] of SmallInt;
  IsfTmp: array[0..15] of SmallInt;
  HfIsf: array[0..19] of SmallInt;
  CorrGain: SmallInt;
begin
  QNew := 0;
  T0Min := 0;
  CorrGain := 0;
  StateValue := PAMRDecoderState(SpdState);
  NbBits := DecMainNbOfBits[Mode];
  FrameLength^ := 320;
  NewDTXState := AmrRxDtxHandler(StateValue^.DtxDecSt, FrameType);
  if FixedPoint.Sub(NewDTXState, 0) <> 0 then
  begin
    AmrDtxDec(StateValue^.DtxDecSt, PAMRSmallInt(@Exc2[0]), NewDTXState, PAMRSmallInt(@Isf[0]), Parameters);
  end;
  if (FixedPoint.Sub(FrameType, 3) = 0) or (FixedPoint.Sub(FrameType, 1) = 0) then
  begin
    Bfi := 1;
    UnusableFrame := 0;
  end
  else
  begin
    if (FixedPoint.Sub(FrameType, 7) = 0) or (FixedPoint.Sub(FrameType, 2) = 0) then
    begin
      Bfi := 1;
      UnusableFrame := 1;
    end
    else
    begin
      Bfi := 0;
      UnusableFrame := 0;
    end;
  end;
  if Bfi <> 0 then
  begin
    StateValue^.State := FixedPoint.Add(StateValue^.State, 1);
    if FixedPoint.Sub(StateValue^.State, 6) > 0 then
      StateValue^.State := 6;
  end
  else
    StateValue^.State := FixedPoint.ShiftRight(StateValue^.State, 1);
  if FixedPoint.Sub(StateValue^.DtxDecSt^.DtxGlobalState, 1) = 0 then
  begin
    StateValue^.State := 5;
    StateValue^.PrevBfi := 0;
  end
  else
  begin
    if FixedPoint.Sub(StateValue^.DtxDecSt^.DtxGlobalState, 2) = 0 then
    begin
      StateValue^.State := 5;
      StateValue^.PrevBfi := 1;
    end;
  end;
  if FixedPoint.Sub(NewDTXState, 0) = 0 then
  begin
    VadFlag := ReadSerialParameter(1, Parameters);
    if Bfi = 0 then
    begin
      if VadFlag = 0 then
      begin
        StateValue^.VadHist := FixedPoint.Add(StateValue^.VadHist, 1);
        StateValue^.DtxDecSt^.DtxVadHist := FixedPoint.Add(StateValue^.DtxDecSt^.DtxVadHist, 1);
      end
      else
      begin
        StateValue^.VadHist := 0;
        StateValue^.DtxDecSt^.DtxVadHist := 0;
      end;
    end
    else
    begin
      if StateValue^.DtxDecSt^.DtxVadHist > 0 then
        StateValue^.DtxDecSt^.DtxVadHist := FixedPoint.Add(StateValue^.DtxDecSt^.DtxVadHist, 1);
    end;
  end;
  if FixedPoint.Sub(NewDTXState, 0) <> 0 then
  begin
    AmrIsfIsp(PAMRSmallInt(@Isf[0]), PAMRSmallInt(@Ispnew[0]), 16);
    AmrIspAz(PAMRSmallInt(@Ispnew[0]), PAMRSmallInt(@Aq[0]), 16, 1);
    CopySamples(PAMRSmallInt(@StateValue^.Isfold[0]), PAMRSmallInt(@IsfTmp[0]), 16);
    ISubfr := 0;
    while ISubfr < 256 do
    begin
      J := FixedPoint.ShiftRight(ISubfr, 6);
      I := 0;
      while I < 16 do
      begin
        LTmp := FixedPoint.LMult(IsfTmp[I], FixedPoint.Sub(32767, DecMainInterpolFrac[J]));
        LTmp := FixedPoint.LMac(LTmp, Isf[I], DecMainInterpolFrac[J]);
        HfIsf[I] := FixedPoint.Round(LTmp);
        Inc(I);
      end;
      SynthesizeSubframe(PAMRSmallInt(@Aq[0]), PAMRSmallInt(@Exc2[ISubfr]), 0,
        PAMRSmallInt(@Synth16k[(ISubfr * 5) div 4]), SmallInt(1), PAMRSmallInt(@HfIsf[0]), NbBits, NewDTXState,
        StateValue, Bfi);
      ISubfr := ISubfr + 64;
    end;
    ResetDecoder(StateValue, 0);
    CopySamples(PAMRSmallInt(@Isf[0]), PAMRSmallInt(@StateValue^.Isfold[0]), 16);
    StateValue^.PrevBfi := Bfi;
    StateValue^.DtxDecSt^.DtxGlobalState := NewDTXState;
    Exit;
  end;
  CopySamples(PAMRSmallInt(@StateValue^.OldExc[0]), PAMRSmallInt(@OldExc[0]), (231 + (16 + 1)));
  Exc := (PAMRSmallInt(@OldExc[0]) + 231) + (16 + 1);
  if FixedPoint.Sub(NbBits, 132) <= 0 then
  begin
    Ind[0] := ReadSerialParameter(8, Parameters);
    Ind[1] := ReadSerialParameter(8, Parameters);
    Ind[2] := ReadSerialParameter(7, Parameters);
    Ind[3] := ReadSerialParameter(7, Parameters);
    Ind[4] := ReadSerialParameter(6, Parameters);
    AmrDpisf2s36b(PAMRSmallInt(@Ind[0]), PAMRSmallInt(@Isf[0]), PAMRSmallInt(@StateValue^.PastIsfq[0]),
      PAMRSmallInt(@StateValue^.Isfold[0]), PAMRSmallInt(@StateValue^.IsfBuf[0]), Bfi, 1);
  end
  else
  begin
    Ind[0] := ReadSerialParameter(8, Parameters);
    Ind[1] := ReadSerialParameter(8, Parameters);
    Ind[2] := ReadSerialParameter(6, Parameters);
    Ind[3] := ReadSerialParameter(7, Parameters);
    Ind[4] := ReadSerialParameter(7, Parameters);
    Ind[5] := ReadSerialParameter(5, Parameters);
    Ind[6] := ReadSerialParameter(5, Parameters);
    AmrDpisf2s46b(PAMRSmallInt(@Ind[0]), PAMRSmallInt(@Isf[0]), PAMRSmallInt(@StateValue^.PastIsfq[0]),
      PAMRSmallInt(@StateValue^.Isfold[0]), PAMRSmallInt(@StateValue^.IsfBuf[0]), Bfi, 1);
  end;
  AmrIsfIsp(PAMRSmallInt(@Isf[0]), PAMRSmallInt(@Ispnew[0]), 16);
  if StateValue^.FirstFrame <> 0 then
  begin
    StateValue^.FirstFrame := 0;
    CopySamples(PAMRSmallInt(@Ispnew[0]), PAMRSmallInt(@StateValue^.IspOld[0]), 16);
  end;
  AmrIntIsp(PAMRSmallInt(@StateValue^.IspOld[0]), PAMRSmallInt(@Ispnew[0]),
    PAMRSmallInt(@DecMainInterpolFrac[0]), PAMRSmallInt(@Aq[0]));
  CopySamples(PAMRSmallInt(@Ispnew[0]), PAMRSmallInt(@StateValue^.IspOld[0]), 16);
  LTmp := 0;
  I := 0;
  while I < (16 - 1) do
  begin
    Tmp := FixedPoint.Sub(Isf[I], StateValue^.Isfold[I]);
    LTmp := FixedPoint.LMac(LTmp, Tmp, Tmp);
    Inc(I);
  end;
  Tmp := AmrExtractH(FixedPoint.LShl(LTmp, 8));
  Tmp := FixedPoint.Mult(Tmp, 26214);
  Tmp := FixedPoint.Sub(20480, Tmp);
  StabFac := FixedPoint.ShiftLeft(Tmp, 1);
  if StabFac < 0 then
    StabFac := 0;
  CopySamples(PAMRSmallInt(@StateValue^.Isfold[0]), PAMRSmallInt(@IsfTmp[0]), 16);
  CopySamples(PAMRSmallInt(@Isf[0]), PAMRSmallInt(@StateValue^.Isfold[0]), 16);
  PAq := PAMRSmallInt(@Aq[0]);
  ISubfr := 0;
  while ISubfr < 256 do
  begin
    PitFlag := ISubfr;
    if (FixedPoint.Sub(ISubfr, (2 * 64)) = 0) and (FixedPoint.Sub(NbBits, 132) > 0) then
      PitFlag := 0;
    if PitFlag = 0 then
    begin
      if FixedPoint.Sub(NbBits, 177) <= 0 then
      begin
        IndexValue := ReadSerialParameter(8, Parameters);
        if FixedPoint.Sub(IndexValue, ((92 - 34) * 2)) < 0 then
        begin
          T0 := FixedPoint.Add(34, FixedPoint.ShiftRight(IndexValue, 1));
          T0Frac := FixedPoint.Sub(IndexValue, FixedPoint.ShiftLeft(FixedPoint.Sub(T0, 34), 1));
          T0Frac := FixedPoint.ShiftLeft(T0Frac, 1);
        end
        else
        begin
          T0 := FixedPoint.Add(IndexValue, (92 - ((92 - 34) * 2)));
          T0Frac := 0;
        end;
      end
      else
      begin
        IndexValue := ReadSerialParameter(9, Parameters);
        if FixedPoint.Sub(IndexValue, ((128 - 34) * 4)) < 0 then
        begin
          T0 := FixedPoint.Add(34, FixedPoint.ShiftRight(IndexValue, 2));
          T0Frac := FixedPoint.Sub(IndexValue, FixedPoint.ShiftLeft(FixedPoint.Sub(T0, 34), 2));
        end
        else
        begin
          if FixedPoint.Sub(IndexValue, (((128 - 34) * 4) + ((160 - 128) * 2))) < 0 then
          begin
            IndexValue := FixedPoint.Sub(IndexValue, ((128 - 34) * 4));
            T0 := FixedPoint.Add(128, FixedPoint.ShiftRight(IndexValue, 1));
            T0Frac := FixedPoint.Sub(IndexValue, FixedPoint.ShiftLeft(FixedPoint.Sub(T0, 128), 1));
            T0Frac := FixedPoint.ShiftLeft(T0Frac, 1);
          end
          else
          begin
            T0 := FixedPoint.Add(IndexValue, ((160 - ((128 - 34) * 4)) - ((160 - 128) * 2)));
            T0Frac := 0;
          end;
        end;
      end;
      T0Min := FixedPoint.Sub(T0, 8);
      if FixedPoint.Sub(T0Min, 34) < 0 then
        T0Min := 34;
      T0Max := FixedPoint.Add(T0Min, 15);
      if FixedPoint.Sub(T0Max, 231) > 0 then
      begin
        T0Max := 231;
        T0Min := FixedPoint.Sub(T0Max, 15);
      end;
    end
    else
    begin
      if FixedPoint.Sub(NbBits, 177) <= 0 then
      begin
        IndexValue := ReadSerialParameter(5, Parameters);
        T0 := FixedPoint.Add(T0Min, FixedPoint.ShiftRight(IndexValue, 1));
        T0Frac := FixedPoint.Sub(IndexValue, FixedPoint.ShiftLeft(FixedPoint.Sub(T0, T0Min), 1));
        T0Frac := FixedPoint.ShiftLeft(T0Frac, 1);
      end
      else
      begin
        IndexValue := ReadSerialParameter(6, Parameters);
        T0 := FixedPoint.Add(T0Min, FixedPoint.ShiftRight(IndexValue, 2));
        T0Frac := FixedPoint.Sub(IndexValue, FixedPoint.ShiftLeft(FixedPoint.Sub(T0, T0Min), 2));
      end;
    end;
    if Bfi <> 0 then
    begin
      AmrLagconc(PAMRSmallInt(@StateValue^.DecGain[17]), PAMRSmallInt(@StateValue^.LagHist[0]),
        PAMRSmallInt(@T0), PAMRSmallInt(@StateValue^.OldT0), PAMRSmallInt(@StateValue^.Seed3), UnusableFrame);
      T0Frac := 0;
    end;
    AmrPredLt4(PAMRSmallInt(@Exc[ISubfr]), T0, T0Frac, (64 + 1));
    if UnusableFrame <> 0 then
      Select := 1
    else
    begin
      if FixedPoint.Sub(NbBits, 177) <= 0 then
        Select := 0
      else
        Select := ReadSerialParameter(1, Parameters);
    end;
    if Select = 0 then
    begin
      I := 0;
      while I < 64 do
      begin
        LTmp := FixedPoint.LMult(5898, Exc[(I - 1) + ISubfr]);
        LTmp := FixedPoint.LMac(LTmp, 20972, Exc[I + ISubfr]);
        LTmp := FixedPoint.LMac(LTmp, 5898, Exc[(I + 1) + ISubfr]);
        Code[I] := FixedPoint.Round(LTmp);
        Inc(I);
      end;
      CopySamples(PAMRSmallInt(@Code[0]), PAMRSmallInt(@Exc[ISubfr]), 64);
    end;
    if UnusableFrame <> 0 then
    begin
      I := 0;
      while I < 64 do
      begin
        Code[I] := FixedPoint.ShiftRight(AmrRandom(PAMRSmallInt(@StateValue^.Seed)), 3);
        Inc(I);
      end;
    end
    else
    begin
      if FixedPoint.Sub(NbBits, 132) <= 0 then
      begin
        Ind[0] := ReadSerialParameter(12, Parameters);
        AmrDECACELP2t64Fx(Ind[0], PAMRSmallInt(@Code[0]));
      end
      else
      begin
        if FixedPoint.Sub(NbBits, 177) <= 0 then
        begin
          I := 0;
          while I < 4 do
          begin
            Ind[I] := ReadSerialParameter(5, Parameters);
            Inc(I);
          end;
          AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 20, PAMRSmallInt(@Code[0]));
        end
        else
        begin
          if FixedPoint.Sub(NbBits, 253) <= 0 then
          begin
            I := 0;
            while I < 4 do
            begin
              Ind[I] := ReadSerialParameter(9, Parameters);
              Inc(I);
            end;
            AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 36, PAMRSmallInt(@Code[0]));
          end
          else
          begin
            if FixedPoint.Sub(NbBits, 285) <= 0 then
            begin
              Ind[0] := ReadSerialParameter(13, Parameters);
              Ind[1] := ReadSerialParameter(13, Parameters);
              Ind[2] := ReadSerialParameter(9, Parameters);
              Ind[3] := ReadSerialParameter(9, Parameters);
              AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 44, PAMRSmallInt(@Code[0]));
            end
            else
            begin
              if FixedPoint.Sub(NbBits, 317) <= 0 then
              begin
                I := 0;
                while I < 4 do
                begin
                  Ind[I] := ReadSerialParameter(13, Parameters);
                  Inc(I);
                end;
                AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 52, PAMRSmallInt(@Code[0]));
              end
              else
              begin
                if FixedPoint.Sub(NbBits, 365) <= 0 then
                begin
                  I := 0;
                  while I < 4 do
                  begin
                    Ind[I] := ReadSerialParameter(2, Parameters);
                    Inc(I);
                  end;
                  I := 4;
                  while I < 8 do
                  begin
                    Ind[I] := ReadSerialParameter(14, Parameters);
                    Inc(I);
                  end;
                  AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 64, PAMRSmallInt(@Code[0]));
                end
                else
                begin
                  if FixedPoint.Sub(NbBits, 397) <= 0 then
                  begin
                    Ind[0] := ReadSerialParameter(10, Parameters);
                    Ind[1] := ReadSerialParameter(10, Parameters);
                    Ind[2] := ReadSerialParameter(2, Parameters);
                    Ind[3] := ReadSerialParameter(2, Parameters);
                    Ind[4] := ReadSerialParameter(10, Parameters);
                    Ind[5] := ReadSerialParameter(10, Parameters);
                    Ind[6] := ReadSerialParameter(14, Parameters);
                    Ind[7] := ReadSerialParameter(14, Parameters);
                    AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 72, PAMRSmallInt(@Code[0]));
                  end
                  else
                  begin
                    I := 0;
                    while I < 4 do
                    begin
                      Ind[I] := ReadSerialParameter(11, Parameters);
                      Inc(I);
                    end;
                    I := 4;
                    while I < 8 do
                    begin
                      Ind[I] := ReadSerialParameter(11, Parameters);
                      Inc(I);
                    end;
                    AmrDECACELP4t64Fx(PAMRSmallInt(@Ind[0]), 88, PAMRSmallInt(@Code[0]));
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
    Tmp := 0;
    AmrPreemph(PAMRSmallInt(@Code[0]), StateValue^.TiltCode, 64, PAMRSmallInt(@Tmp));
    Tmp := T0;
    if FixedPoint.Sub(T0Frac, 2) > 0 then
      Tmp := FixedPoint.Add(Tmp, 1);
    AmrPitShrp(PAMRSmallInt(@Code[0]), Tmp, 27853, 64);
    if FixedPoint.Sub(NbBits, 177) <= 0 then
    begin
      IndexValue := ReadSerialParameter(6, Parameters);
      AmrDGain2(IndexValue, 6, PAMRSmallInt(@Code[0]), 64, PAMRSmallInt(@GainPit), PAMRInteger(@LGainCode), Bfi,
        StateValue^.PrevBfi, StateValue^.State, UnusableFrame, StateValue^.VadHist,
        PAMRSmallInt(@StateValue^.DecGain[0]));
    end
    else
    begin
      IndexValue := ReadSerialParameter(7, Parameters);
      AmrDGain2(IndexValue, 7, PAMRSmallInt(@Code[0]), 64, PAMRSmallInt(@GainPit), PAMRInteger(@LGainCode), Bfi,
        StateValue^.PrevBfi, StateValue^.State, UnusableFrame, StateValue^.VadHist,
        PAMRSmallInt(@StateValue^.DecGain[0]));
    end;
    Tmp := StateValue^.Qsubfr[0];
    I := 1;
    while I < 4 do
    begin
      if FixedPoint.Sub(StateValue^.Qsubfr[I], Tmp) < 0 then
        Tmp := StateValue^.Qsubfr[I];
      Inc(I);
    end;
    if FixedPoint.Sub(Tmp, 8) > 0 then
      Tmp := 8;
    QNew := 0;
    LTmp := LGainCode;
    while (FixedPoint.LSub(LTmp, $8000000) < 0) and (FixedPoint.Sub(QNew, Tmp) < 0) do
    begin
      LTmp := FixedPoint.LShl(LTmp, 1);
      QNew := FixedPoint.Add(QNew, 1);
    end;
    GainCode := FixedPoint.Round(LTmp);
    AmrScaleSig(((Exc + ISubfr) - (231 + (16 + 1))), ((231 + (16 + 1)) + 64), FixedPoint.Sub(QNew, StateValue^.QOld));
    StateValue^.QOld := QNew;
    if Bfi = 0 then
    begin
      I := 4;
      while I > 0 do
      begin
        StateValue^.LagHist[I] := StateValue^.LagHist[I - 1];
        Dec(I);
      end;
      StateValue^.LagHist[0] := T0;
      StateValue^.OldT0 := T0;
      StateValue^.OldT0Frac := 0;
    end;
    CopySamples(PAMRSmallInt(@Exc[ISubfr]), PAMRSmallInt(@Exc2[0]), 64);
    AmrScaleSig(PAMRSmallInt(@Exc2[0]), 64, (-3));
    if FixedPoint.Sub(NbBits, 177) <= 0 then
    begin
      PitSharp := FixedPoint.ShiftLeft(GainPit, 1);
      if FixedPoint.Sub(PitSharp, 16384) > 0 then
      begin
        I := 0;
        while I < 64 do
        begin
          Tmp := FixedPoint.Mult(Exc2[I], PitSharp);
          LTmp := FixedPoint.LMult(Tmp, GainPit);
          LTmp := FixedPoint.LShr(LTmp, 1);
          Excp[I] := FixedPoint.Round(LTmp);
          Inc(I);
        end;
      end;
    end
    else
      PitSharp := 0;
    VoiceFac := AmrVoiceFactor(PAMRSmallInt(@Exc2[0]), (-3), GainPit, PAMRSmallInt(@Code[0]), GainCode, 64);
    StateValue^.TiltCode := FixedPoint.Add(FixedPoint.ShiftRight(VoiceFac, 2), 8192);
    CopySamples(PAMRSmallInt(@Exc[ISubfr]), PAMRSmallInt(@Exc2[0]), 64);
    I := 0;
    while I < 64 do
    begin
      LTmp := FixedPoint.LMult(Code[I], GainCode);
      LTmp := FixedPoint.LShl(LTmp, 5);
      LTmp := FixedPoint.LMac(LTmp, Exc[I + ISubfr], GainPit);
      LTmp := FixedPoint.LShl(LTmp, 1);
      Exc[I + ISubfr] := FixedPoint.Round(LTmp);
      Inc(I);
    end;
    Max := 1;
    I := 0;
    while I < 64 do
    begin
      Tmp := AmrAbsS(Exc[I + ISubfr]);
      if FixedPoint.Sub(Tmp, Max) > 0 then
        Max := Tmp;
      Inc(I);
    end;
    Tmp := FixedPoint.Sub(FixedPoint.Add(AmrNormS(Max), QNew), 1);
    StateValue^.Qsubfr[3] := StateValue^.Qsubfr[2];
    StateValue^.Qsubfr[2] := StateValue^.Qsubfr[1];
    StateValue^.Qsubfr[1] := StateValue^.Qsubfr[0];
    StateValue^.Qsubfr[0] := Tmp;
    FixedPoint.LExtract(LGainCode, PAMRSmallInt(@GainCode), PAMRSmallInt(@GainCodeLo));
    if FixedPoint.Sub(NbBits, 132) <= 0 then
      J := 0
    else
    begin
      if FixedPoint.Sub(NbBits, 177) <= 0 then
        J := 1
      else
        J := 2;
    end;
    AmrPhaseDispersion(GainCode, GainPit, PAMRSmallInt(@Code[0]), J, PAMRSmallInt(@StateValue^.DispMem[0]));
    Tmp := FixedPoint.Sub(16384, FixedPoint.ShiftRight(VoiceFac, 1));
    Fac := FixedPoint.Mult(StabFac, Tmp);
    LTmp := LGainCode;
    if FixedPoint.LSub(LTmp, StateValue^.LGcThres) < 0 then
    begin
      LTmp := FixedPoint.LAdd(LTmp, FixedPoint.Mpy3216(GainCode, GainCodeLo, 6226));
      if FixedPoint.LSub(LTmp, StateValue^.LGcThres) > 0 then
        LTmp := StateValue^.LGcThres;
    end
    else
    begin
      LTmp := FixedPoint.Mpy3216(GainCode, GainCodeLo, 27536);
      if FixedPoint.LSub(LTmp, StateValue^.LGcThres) < 0 then
        LTmp := StateValue^.LGcThres;
    end;
    StateValue^.LGcThres := LTmp;
    LGainCode := FixedPoint.Mpy3216(GainCode, GainCodeLo, FixedPoint.Sub(32767, Fac));
    FixedPoint.LExtract(LTmp, PAMRSmallInt(@GainCode), PAMRSmallInt(@GainCodeLo));
    LGainCode := FixedPoint.LAdd(LGainCode, FixedPoint.Mpy3216(GainCode, GainCodeLo, Fac));
    Tmp := FixedPoint.Add(FixedPoint.ShiftRight(VoiceFac, 3), 4096);
    LTmp := AmrLDepositH(Code[0]);
    LTmp := FixedPoint.LMsu(LTmp, Code[1], Tmp);
    Code2[0] := FixedPoint.Round(LTmp);
    I := 1;
    while I < (64 - 1) do
    begin
      LTmp := AmrLDepositH(Code[I]);
      LTmp := FixedPoint.LMsu(LTmp, Code[I + 1], Tmp);
      LTmp := FixedPoint.LMsu(LTmp, Code[I - 1], Tmp);
      Code2[I] := FixedPoint.Round(LTmp);
      Inc(I);
    end;
    LTmp := AmrLDepositH(Code[64 - 1]);
    LTmp := FixedPoint.LMsu(LTmp, Code[64 - 2], Tmp);
    Code2[64 - 1] := FixedPoint.Round(LTmp);
    GainCode := FixedPoint.Round(FixedPoint.LShl(LGainCode, QNew));
    I := 0;
    while I < 64 do
    begin
      LTmp := FixedPoint.LMult(Code2[I], GainCode);
      LTmp := FixedPoint.LShl(LTmp, 5);
      LTmp := FixedPoint.LMac(LTmp, Exc2[I], GainPit);
      LTmp := FixedPoint.LShl(LTmp, 1);
      Exc2[I] := FixedPoint.Round(LTmp);
      Inc(I);
    end;
    if FixedPoint.Sub(NbBits, 177) <= 0 then
    begin
      if FixedPoint.Sub(PitSharp, 16384) > 0 then
      begin
        I := 0;
        while I < 64 do
        begin
          Excp[I] := FixedPoint.Add(Excp[I], Exc2[I]);
          Inc(I);
        end;
        AmrAgc2(PAMRSmallInt(@Exc2[0]), PAMRSmallInt(@Excp[0]), 64);
        CopySamples(PAMRSmallInt(@Excp[0]), PAMRSmallInt(@Exc2[0]), 64);
      end;
    end;
    if FixedPoint.Sub(NbBits, 132) <= 0 then
    begin
      J := FixedPoint.ShiftRight(ISubfr, 6);
      I := 0;
      while I < 16 do
      begin
        LTmp := FixedPoint.LMult(IsfTmp[I], FixedPoint.Sub(32767, DecMainInterpolFrac[J]));
        LTmp := FixedPoint.LMac(LTmp, Isf[I], DecMainInterpolFrac[J]);
        HfIsf[I] := FixedPoint.Round(LTmp);
        Inc(I);
      end;
    end
    else
    begin
      ZeroSamples(PAMRSmallInt(@StateValue^.MemSynHf[0]), (20 - 16));
    end;
    if FixedPoint.Sub(NbBits, 477) >= 0 then
    begin
      CorrGain := ReadSerialParameter(4, Parameters);
      SynthesizeSubframe(PAq, PAMRSmallInt(@Exc2[0]), QNew, PAMRSmallInt(@Synth16k[(ISubfr * 5) div 4]),
        CorrGain, PAMRSmallInt(@HfIsf[0]), NbBits, NewDTXState, StateValue, Bfi);
    end
    else
    begin
      SynthesizeSubframe(PAq, PAMRSmallInt(@Exc2[0]), QNew, PAMRSmallInt(@Synth16k[(ISubfr * 5) div 4]), 0,
        PAMRSmallInt(@HfIsf[0]), NbBits, NewDTXState, StateValue, Bfi);
    end;
    PAq := PAq + (16 + 1);
    ISubfr := ISubfr + 64;
  end;
  CopySamples(PAMRSmallInt(@OldExc[256]), PAMRSmallInt(@StateValue^.OldExc[0]), (231 + (16 + 1)));
  AmrScaleSig(Exc, 256, FixedPoint.Sub(0, QNew));
  AmrDtxDecActivityUpdate(StateValue^.DtxDecSt, PAMRSmallInt(@Isf[0]), Exc);
  StateValue^.DtxDecSt^.DtxGlobalState := NewDTXState;
  StateValue^.PrevBfi := Bfi;
end;

function TestHomingParameters(InputFrame: PAMRSmallInt; Mode, Nparms: SmallInt): SmallInt;
var
  I: SmallInt;
  J: SmallInt;
  Tmp: SmallInt;
  Shift: SmallInt;
  Param: array[0..31] of SmallInt;
  Parameters: PAMRSmallInt;
begin
  Parameters := InputFrame;
  J := 0;
  I := 0;
  if FixedPoint.Sub(Mode, 9) <> 0 then
  begin
    if FixedPoint.Sub(Mode, 8) <> 0 then
    begin
      Tmp := FixedPoint.Sub(Nparms, 15);
      while FixedPoint.Sub(Tmp, J) > 0 do
      begin
        Param[I] := ReadSerialParameter(15, Parameters);
        J := FixedPoint.Add(J, 15);
        I := FixedPoint.Add(I, 1);
      end;
      Tmp := FixedPoint.Sub(Nparms, J);
      Param[I] := ReadSerialParameter(Tmp, Parameters);
      Shift := FixedPoint.Sub(15, Tmp);
      Param[I] := FixedPoint.ShiftLeft(Param[I], Shift);
    end
    else
    begin
      I := 0;
      while I < 10 do
      begin
        Param[I] := ReadSerialParameter(15, Parameters);
        Inc(I);
      end;
      Param[10] := ReadSerialParameter(15, Parameters) and $61FF;
      I := 11;
      while I < 17 do
      begin
        Param[I] := ReadSerialParameter(15, Parameters);
        Inc(I);
      end;
      Param[17] := ReadSerialParameter(15, Parameters) and $E0FF;
      I := 18;
      while I < 24 do
      begin
        Param[I] := ReadSerialParameter(15, Parameters);
        Inc(I);
      end;
      Param[24] := ReadSerialParameter(15, Parameters) and $7F0F;
      I := 25;
      while I < 31 do
      begin
        Param[I] := ReadSerialParameter(15, Parameters);
        Inc(I);
      end;
      Tmp := ReadSerialParameter(8, Parameters);
      Param[31] := FixedPoint.ShiftLeft(Tmp, 7);
      Shift := 0;
    end;
    Tmp := I;
    J := 0;
    I := 0;
    while I < Tmp do
    begin
      J := SmallInt((Param[I] xor HomingDhf[Mode][I]));
      if J <> 0 then
        Break;
      Inc(I);
    end;
    Tmp := $7FFF;
    Tmp := FixedPoint.ShiftRight(Tmp, Shift);
    Tmp := FixedPoint.ShiftLeft(Tmp, Shift);
    Tmp := SmallInt((HomingDhf[Mode][I] and Tmp));
    Tmp := SmallInt((Param[I] xor Tmp));
    J := SmallInt((J or Tmp));
  end
  else
    J := 1;
  Result := SmallInt(Ord((not (J <> 0))));
end;

function TestHomingFrame(InputFrame: PAMRSmallInt; Mode: SmallInt): SmallInt;
begin
  Result := TestHomingParameters(InputFrame, Mode, HomingNbOfBits[Mode]);
end;

function TestInitialHomingFrame(InputFrame: PAMRSmallInt; Mode: SmallInt): SmallInt;
begin
  Result := TestHomingParameters(InputFrame, Mode, AMRPrmnofsf[Mode]);
end;

{$IFDEF AMRWB_RESTORE_Q}{$Q+}{$UNDEF AMRWB_RESTORE_Q}{$ENDIF}
{$IFDEF AMRWB_RESTORE_R}{$R+}{$UNDEF AMRWB_RESTORE_R}{$ENDIF}

constructor TAMRWBDecoder.Create;
begin
  inherited;
  InitDecoder(@FState);
  if FState = nil then
    raise EOutOfMemory.Create('AMR-WB decoder state');
  FHomed := True;
end;

destructor TAMRWBDecoder.Destroy;
begin
  if FState <> nil then
    FreeDecoder(FState);
  inherited;
end;

procedure TAMRWBDecoder.Reset;
begin
  ResetDecoder(FState, 1);
  FHomed := True;
  FPreviousMode := 0;
end;

procedure TAMRWBDecoder.Decode(Mode: SmallInt; Kind: TAMRWBFrameKind; var Bits: array of SmallInt; out PCM: TAMRWBPCM);
var
  ResetRequired, HasBits: Boolean;
  FrameLength: SmallInt;
begin
  HasBits := not (Kind in [TAMRWBFrameKind.SpeechLost, TAMRWBFrameKind.NoData]);
  if HasBits then
    FPreviousMode := Mode
  else
    Mode := FPreviousMode;

  ResetRequired := False;
  if HasBits and FHomed then
    ResetRequired := TestInitialHomingFrame(@Bits[0], Mode) <> 0;
  if ResetRequired then
    for var I := Low(PCM) to High(PCM) do
      PCM[I] := 8
  else
    DecodeFrame(Mode, @Bits[0], @PCM[0], @FrameLength, FState, Ord(Kind));

  // Reference synthesis drops the two low bits before output.
  for var I := Low(PCM) to High(PCM) do
    PCM[I] := PCM[I] and SmallInt(-4);

  if HasBits and not FHomed then
    ResetRequired := TestHomingFrame(@Bits[0], Mode) <> 0;
  if ResetRequired then
    ResetDecoder(FState, 1);
  FHomed := ResetRequired;
end;

procedure TAMRWBDecoder.DecodeSerial(Mode: TAMRWBMode; Kind: TAMRWBFrameKind; const Bits: array of SmallInt; out PCM: TAMRWBPCM);
var
  Serial: array[0..AMRWBMaxSerialBits - 1] of SmallInt;
  Count: Integer;
begin
  if (Ord(Mode) > Ord(High(TAMRWBMode))) or (Ord(Kind) > Ord(High(TAMRWBFrameKind))) then
    raise EArgumentOutOfRangeException.Create('AMR-WB mode or frame type');

  case Kind of
    TAMRWBFrameKind.SIDFirst, TAMRWBFrameKind.SIDUpdate, TAMRWBFrameKind.SIDBad:
      Count := SIDBits;
    TAMRWBFrameKind.SpeechLost, TAMRWBFrameKind.NoData:
      Count := 0;
  else
    Count := SpeechBits[Mode];
  end;
  if Length(Bits) <> Count then
    raise EArgumentException.CreateFmt('AMR-WB serial frame requires %d bits', [Count]);

  for var I := 0 to High(Serial) do
    Serial[I] := SerialZero;
  for var I := 0 to Count - 1 do
    case Bits[I] of
      0:
        Serial[I] := SerialZero;
      1:
        Serial[I] := SerialOne;
    else
      raise EArgumentException.Create('AMR-WB serial bits must be 0 or 1');
    end;
  Decode(Ord(Mode), Kind, Serial, PCM);
end;

class function TAMRWBDecoder.StorageFrameSize(Header: Byte): Integer;
const
  Sizes: array[0..15] of Byte = (18, 24, 33, 37, 41, 47, 51, 59, 61, 6, 0, 0, 0, 0, 1, 1);
begin
  Result := Sizes[(Header shr 3) and 15];
end;

procedure TAMRWBDecoder.DecodeStorageFrame(const Frame: TBytes; out PCM: TAMRWBPCM);
var
  Serial: array[0..AMRWBMaxSerialBits - 1] of SmallInt;
  FrameType, Count: Integer;
  Mode: SmallInt;
  Kind: TAMRWBFrameKind;
  Good: Boolean;
begin
  if (Length(Frame) = 0) or (Length(Frame) <> StorageFrameSize(Frame[0])) then
    raise EArgumentException.Create('Invalid AMR-WB storage frame');

  FrameType := (Frame[0] shr 3) and 15;
  Good := (Frame[0] and 4) <> 0;
  Mode := FPreviousMode;
  Count := 0;
  case FrameType of
    0..8:
      begin
        Mode := FrameType;
        Count := SpeechBits[TAMRWBMode(Mode)];
        if Good then
          Kind := TAMRWBFrameKind.SpeechGood
        else
          Kind := TAMRWBFrameKind.SpeechBad;
      end;
    SIDFrame:
      begin
        Count := SIDBits;
        if not Good then
          Kind := TAMRWBFrameKind.SIDBad
        else if (Frame[5] and $10) <> 0 then
          Kind := TAMRWBFrameKind.SIDUpdate
        else
          Kind := TAMRWBFrameKind.SIDFirst;
      end;
    LostFrame:
      Kind := TAMRWBFrameKind.SpeechLost;
  else
    Kind := TAMRWBFrameKind.NoData;
  end;

  for var I := 0 to High(Serial) do
    Serial[I] := SerialZero;
  for var I := 0 to Count - 1 do
    if (Frame[1 + I div 8] and ($80 shr (I mod 8))) <> 0 then
      Serial[SortTables[FrameType][I]] := SerialOne;
  Decode(Mode, Kind, Serial, PCM);
end;

end.

