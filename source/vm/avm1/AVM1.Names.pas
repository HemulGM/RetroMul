function MapChar(Value: Char; const Table: array of TCaseMapping): Char;
var
  LowIndex, HighIndex, Middle: Integer;
begin
  LowIndex := 0;
  HighIndex := High(Table);
  while LowIndex <= HighIndex do
  begin
    Middle := LowIndex + (HighIndex - LowIndex) div 2;
    if Table[Middle].Source = Ord(Value) then
      Exit(Char(Table[Middle].Target));
    if Table[Middle].Source < Ord(Value) then
      LowIndex := Middle + 1
    else
      HighIndex := Middle - 1;
  end;
  Result := Value;
end;

function AVMLowerChar(Value: Char): Char;
begin
  if Value < #$0080 then
  begin
    if (Value >= 'A') and (Value <= 'Z') then
      Exit(Char(Ord(Value) + 32));
    Exit(Value);
  end;
  Result := MapChar(Value, Lowercase);
end;

function AVMUpperChar(Value: Char): Char;
begin
  if Value < #$0080 then
  begin
    if (Value >= 'a') and (Value <= 'z') then
      Exit(Char(Ord(Value) - 32));
    Exit(Value);
  end;
  Result := MapChar(Value, Uppercase);
end;

function AVMLowerName(const Value: string): string;
var
  I: Integer;
begin
  Result := Value;
  for I := 1 to Length(Result) do
    Result[I] := AVMLowerChar(Result[I]);
end;

function AVMUpperName(const Value: string): string;
var
  I: Integer;
begin
  Result := Value;
  for I := 1 to Length(Result) do
    Result[I] := AVMUpperChar(Result[I]);
end;

function AVMNamesEqual(const Left, Right: string): Boolean;
var
  I: Integer;
begin
  if Length(Left) <> Length(Right) then
    Exit(False);
  for I := 1 to Length(Left) do
    if AVMLowerChar(Left[I]) <> AVMLowerChar(Right[I]) then
      Exit(False);
  Result := True;
end;

{ Stage-object level parsing translated.
  Prefix recognition is case-sensitive in SWF7+, accepts _flash aliases,
  and consumes the initial decimal digits with wrapping Int32 arithmetic. }
function AVMParseLevelName(const Name: string; Version: Byte; out LevelId: Integer): Boolean;
var
  Prefix: string;
  I: Integer;
  Bits: Cardinal;
  Negative: Boolean;
begin
  LevelId := 0;
  Result := False;
  if Length(Name) < 6 then
    Exit;
  Prefix := Copy(Name, 1, 6);
  if Version < 7 then
    Prefix := AVMLowerName(Prefix);
  if (Prefix <> '_level') and (Prefix <> '_flash') then
    Exit;
  Result := True;
  I := 7;
  Negative := (I <= Length(Name)) and (Name[I] = '-');
  if Negative then
    Inc(I);
  Bits := 0;
  while (I <= Length(Name)) and (Name[I] >= '0') and (Name[I] <= '9') do
  begin
    Bits := Cardinal((UInt64(Bits) * 10 + Ord(Name[I]) - Ord('0')) and $FFFFFFFF);
    Inc(I);
  end;
  if Negative then
    Bits := Cardinal((UInt64($100000000) - Bits) and $FFFFFFFF);
  Move(Bits, LevelId, SizeOf(LevelId));
end;

function AVMLevelNumber(Value: Double): Integer;
begin
  if IsNan(Value) then
    Exit(0);
  if Value >= High(Integer) then
    Exit(High(Integer));
  if Value <= Low(Integer) then
    Exit(Low(Integer));
  Result := Trunc(Value);
end;

