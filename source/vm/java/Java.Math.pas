unit Java.Math;

interface

uses
  JVM.Types, JVM.ClassFile, JVM.Runtime;

procedure InstallJavaMath(VM: TJVM);

function InvokeJavaMath(VM: TJVM; Method: TJVMMethod; const Args: TArray<TJVMValue>): TJVMValue;

implementation

uses
  System.Math, Java.Classes;

{$Q-}{$R-}
{$EXCESSPRECISION OFF}

type
  TDoublePair = record
    Hi, Lo: Double;
  end;

