function Pair(X: Double): TDoublePair;
begin
  Result.Hi := X;
  Result.Lo := 0;
end;

function PairAdd(const A, B: TDoublePair): TDoublePair;
var
  S, V, E: Double;
begin
  S := A.Hi + B.Hi;
  V := S - A.Hi;
  E := ((A.Hi - (S - V)) + (B.Hi - V)) + (A.Lo + B.Lo);
  Result.Hi := S + E;
  Result.Lo := (S - Result.Hi) + E;
end;

function PairMultiply(const A, B: TDoublePair): TDoublePair;
var
  P, Split, Temp, AH, AL, BH, BL, E: Double;
begin
  P := A.Hi * B.Hi;
  Split := 134217729.0 * A.Hi;
  Temp := Split - A.Hi;
  AH := Split - Temp;
  AL := A.Hi - AH;
  Split := 134217729.0 * B.Hi;
  Temp := Split - B.Hi;
  BH := Split - Temp;
  BL := B.Hi - BH;
  E := (((AH * BH - P) + AH * BL + AL * BH) + AL * BL) + (A.Hi * B.Lo + A.Lo * B.Hi);
  Result.Hi := P + E;
  Result.Lo := (P - Result.Hi) + E;
end;

function Tangent(Hi, Lo: Double; Odd: Boolean): Double;
var
  X, Z, P, T, Residual: TDoublePair;
  First, Correction: Double;
begin
  X.Hi := Hi;
  X.Lo := Lo;
  Z := PairMultiply(X, X);
  P := TanCoefficients[High(TanCoefficients)];
  for var I := High(TanCoefficients) - 1 downto 0 do
    P := PairAdd(TanCoefficients[I], PairMultiply(Z, P));
  T := PairMultiply(X, P);
  if not Odd then
    Exit(T.Hi);
  First := -1 / T.Hi;
  Residual := PairAdd(Pair(1), PairMultiply(T, Pair(First)));
  Correction := -(Residual.Hi + Residual.Lo) / T.Hi;
  Result := First + Correction;
end;

function FloatingBits(B: UInt64; IsSingle: Boolean = False): TJVMValue;
begin
  Result.Kind := TJVMKind.Double;
  if IsSingle then
    Result.Kind := TJVMKind.Float;
  Result.Bits := Int64(B);
end;

procedure InstallJavaMath(VM: TJVM);
var
  B: TJavaClassBuilder;
begin
  B := TJavaClassBuilder.Create('java/lang/Math', 'java/lang/Object', JVM_ACC_PUBLIC or JVM_ACC_FINAL or $20);
  try
    B.Field('E', 'D', JVM_ACC_PUBLIC or JVM_ACC_STATIC or JVM_ACC_FINAL);
    B.JavaClass.Fields.Last.Value := FloatingBits($4005BF0A8B145769);
    B.Field('PI', 'D', JVM_ACC_PUBLIC or JVM_ACC_STATIC or JVM_ACC_FINAL);
    B.JavaClass.Fields.Last.Value := FloatingBits($400921FB54442D18);
    for var D in ['I', 'J', 'F', 'D'] do
    begin
      B.JavaClass.AddNative('abs', '(' + D + ')' + D, True);
      for var N in ['min', 'max'] do
        B.JavaClass.AddNative(N, '(' + D + D + ')' + D, True);
    end;
    for var N in ['sin', 'cos', 'tan', 'sqrt', 'floor', 'ceil', 'toDegrees', 'toRadians'] do
      B.JavaClass.AddNative(N, '(D)D', True);
    VM.DefineClass(B.Detach);
  finally
    B.Free;
  end;
end;

// Compute x*2/pi with an exact 53-by-1664-bit integer product, retain the nearest
// quadrant and a signed two-double fractional remainder. No division by a
// rounded pi is used, even for Double.MAX_VALUE. All work has a fixed bound.
function ReduceAngle(Bits: UInt64; out Hi, Lo: Double): Integer;
var
  P: array[0..53] of UInt32;
  M: UInt64;
  Shift, Top, Used, Leading: Integer;
  Carry, T: UInt64;
  TopMask: UInt32;
  Negative: Boolean;
  Sig: UInt64;
  A, ALow, Y, Error, Split, AH, AL, BH, BL, Temp, Correction, Sum: Double;

  function BitAt(Index: Integer): UInt64;
  begin
    if (Index < 0) or (Index > Top * 32 + 31) then
      Exit(0);
    Result := (P[Index div 32] shr (Index mod 32)) and 1;
  end;

  function Significand(Start: Integer): UInt64;
  begin
    Result := 0;
    for var I := Start downto Start - 52 do
      Result := (Result shl 1) or BitAt(I);
  end;

begin
  FillChar(P, SizeOf(P), 0);
  M := (Bits and FractionMask) or (UInt64(1) shl 52);
  for var Part := 0 to 1 do
  begin
    Carry := 0;
    var Limb := UInt32(M shr (Part * 32));
    for var I := 0 to High(TwoOverPi) do
    begin
      T := UInt64(TwoOverPi[I]) * Limb + P[I + Part] + Carry;
      P[I + Part] := UInt32(T);
      Carry := T shr 32;
    end;
    P[Length(TwoOverPi) + Part] := UInt32(Carry);
  end;
  Shift := ReductionBits + 52 - (Integer((Bits shr 52) and $7FF) - 1023);
  Top := High(P);
  Result := Integer(BitAt(Shift) or (BitAt(Shift + 1) shl 1));
  Negative := BitAt(Shift - 1) <> 0;
  if Negative then
    Result := (Result + 1) and 3;
  Top := (Shift - 1) div 32;
  Used := Shift - Top * 32;
  TopMask := High(UInt32);
  if Used < 32 then
    TopMask := (UInt32(1) shl Used) - 1;
  P[Top] := P[Top] and TopMask;
  if Negative then
  begin
    Carry := 1;
    for var I := 0 to Top do
    begin
      T := UInt64(not P[I]) + Carry;
      P[I] := UInt32(T);
      Carry := T shr 32;
    end;
    P[Top] := P[Top] and TopMask;
  end;
  Leading := Shift - 1;
  while (Leading > 0) and (BitAt(Leading) = 0) do
    Dec(Leading);
  Sig := Significand(Leading);
  A := Ldexp(Double(Sig), Leading - 52 - Shift);
  Sig := Significand(Leading - 53);
  ALow := Ldexp(Double(Sig), Leading - 105 - Shift);
  if Negative then
  begin
    A := -A;
    ALow := -ALow;
  end;
  // Compensated product: the trailing fraction and pi/2 tail survive reduction
  // near multiples of pi/2 instead of being rounded away before sin/cos/tan.
  Y := A * PiOverTwo;
  Split := 134217729.0 * A;
  Temp := Split - A;
  AH := Split - Temp;
  AL := A - AH;
  Split := 134217729.0 * PiOverTwo;
  Temp := Split - PiOverTwo;
  BH := Split - Temp;
  BL := PiOverTwo - BH;
  Error := ((AH * BH - Y) + AH * BL + AL * BH) + AL * BL;
  Correction := (Error + A * PiOverTwoTail) + ALow * PiOverTwo;
  Sum := Y + Correction;
  Lo := Correction - (Sum - Y);
  Hi := Sum;
end;

function Trig(Bits: UInt64; const Name: string): TJVMValue;
var
  Hi, Lo, S, C, SV, CV, R: Double;
  Quadrant: Integer;
  Negative: Boolean;
begin
  Negative := (Bits and SignBit) <> 0;
  Bits := Bits and MagnitudeMask;
  if Bits >= InfinityBits then
    Exit(FloatingBits(NaNBits));
  if Bits = 0 then
  begin
    if Name = 'cos' then
      Exit(TJVMValue.Double(1));
    if Negative then
      Exit(FloatingBits(SignBit))
    else
      Exit(FloatingBits(0));
  end;
  if Bits < $3E40000000000000 then
  begin
    if Name = 'cos' then
      Exit(TJVMValue.Double(1));
    if Negative then
      Bits := Bits or SignBit;
    Exit(FloatingBits(Bits));
  end;
  if Bits <= $3FE921FB54442D18 then
  begin
    Hi := FloatingBits(Bits).AsDouble;
    Lo := 0;
    Quadrant := 0;
  end
  else
    Quadrant := ReduceAngle(Bits, Hi, Lo);
  if Name = 'tan' then
  begin
    R := Tangent(Hi, Lo, (Quadrant and 1) <> 0);
  end
  else
  begin
    S := System.Sin(Hi);
    C := System.Cos(Hi);
    SV := S + Lo * C;
    CV := C - Lo * S;
    if Name = 'sin' then
      case Quadrant of
        0:
          R := SV;
        1:
          R := CV;
        2:
          R := -SV;
      else
        R := -CV;
      end
    else
      case Quadrant of
        0:
          R := CV;
        1:
          R := -SV;
        2:
          R := -CV;
      else
        R := SV;
      end;
  end;
  if Negative and (Name <> 'cos') then
    R := -R;
  Result := TJVMValue.Double(R);
end;

function Integral(const A: TJVMValue; Up: Boolean): TJVMValue;
var
  Bits, AbsBits, Mask: UInt64;
  Exponent: Integer;
  Negative: Boolean;
begin
  Bits := UInt64(A.Bits);
  AbsBits := Bits and MagnitudeMask;
  Negative := (Bits and SignBit) <> 0;
  Exponent := Integer((AbsBits shr 52) and $7FF) - 1023;
  if (Exponent >= 52) or (AbsBits = 0) then
    Exit(A);
  if Exponent < 0 then
  begin
    if Up then
    begin
      if Negative then
        Exit(FloatingBits(SignBit))
      else
        Exit(TJVMValue.Double(1));
    end;
    if Negative then
      Exit(TJVMValue.Double(-1))
    else
      Exit(FloatingBits(0));
  end;
  Mask := (UInt64(1) shl (52 - Exponent)) - 1;
  if (Bits and Mask) = 0 then
    Exit(A);
  if Up <> Negative then
    Bits := Bits + Mask;
  Result := FloatingBits(Bits and not Mask);
end;

function TinyProduct(A, B: UInt64): UInt64;
var
  MA, MB, P0, P1, P2, P3, Middle, Hi, Lo, N, Discarded, Half: UInt64;
  EA, EB, Shift: Integer;
begin
  EA := Integer((A shr 52) and $7FF);
  EB := Integer((B shr 52) and $7FF);
  MA := A and FractionMask;
  if EA <> 0 then
    MA := MA or (UInt64(1) shl 52)
  else
    EA := 1;
  MB := (B and FractionMask) or (UInt64(1) shl 52);
  // Exact four-limb product, as in RetroMul's native soft-float arithmetic.
  P0 := (MA and $FFFFFFFF) * (MB and $FFFFFFFF);
  P1 := (MA and $FFFFFFFF) * (MB shr 32);
  P2 := (MA shr 32) * (MB and $FFFFFFFF);
  P3 := (MA shr 32) * (MB shr 32);
  Middle := (P0 shr 32) + (P1 and $FFFFFFFF) + (P2 and $FFFFFFFF);
  Lo := (Middle shl 32) or (P0 and $FFFFFFFF);
  Hi := P3 + (P1 shr 32) + (P2 shr 32) + (Middle shr 32);
  // This path is entered only at/below the binary64 normal/subnormal boundary;
  // these two angular constants give shifts47..58, entirely inside the low limb.
  Shift := 1076 - EA - EB;
  N := (Hi shl (64 - Shift)) or (Lo shr Shift);
  Discarded := Lo and ((UInt64(1) shl Shift) - 1);
  Half := UInt64(1) shl (Shift - 1);
  if (Discarded > Half) or ((Discarded = Half) and ((N and 1) <> 0)) then
    Inc(N);
  Result := (A and SignBit) or N;
end;

function InvokeJavaMath(VM: TJVM; Method: TJVMMethod; const Args: TArray<TJVMValue>): TJVMValue;
var
  N, D: string;
  A, B, Sign, Mask, Inf: UInt64;
  Less, SingleValue: Boolean;
  X, R: Double;
begin
  N := Method.Name;
  D := Method.Descriptor;
  if (D = '(I)I') or (D = '(II)I') then
  begin
    var I := Args[0].AsInt;
    if N = 'abs' then
    begin
      if I < 0 then
        I := -I;
      Exit(TJVMValue.Int(I));
    end;
    var J := Args[1].AsInt;
    if ((N = 'min') and (J < I)) or ((N = 'max') and (J > I)) then
      I := J;
    Exit(TJVMValue.Int(I));
  end;
  if (D = '(J)J') or (D = '(JJ)J') then
  begin
    var I := Args[0].AsLong;
    if N = 'abs' then
    begin
      if I < 0 then
        I := -I;
      Exit(TJVMValue.Long(I));
    end;
    var J := Args[1].AsLong;
    if ((N = 'min') and (J < I)) or ((N = 'max') and (J > I)) then
      I := J;
    Exit(TJVMValue.Long(I));
  end;
  A := UInt64(Args[0].Bits);
  SingleValue := Args[0].Kind = TJVMKind.Float;
  Sign := SignBit;
  Mask := MagnitudeMask;
  Inf := InfinityBits;
  if SingleValue then
  begin
    Sign := $80000000;
    Mask := $7FFFFFFF;
    Inf := $7F800000;
  end;
  if N = 'abs' then
  begin
    if (A and Mask) > Inf then
    begin
      if SingleValue then
        Exit(FloatingBits($7FC00000, True))
      else
        Exit(FloatingBits(NaNBits));
    end;
    Exit(FloatingBits(A and Mask, SingleValue));
  end;
  if (N = 'min') or (N = 'max') then
  begin
    B := UInt64(Args[1].Bits);
    if ((A and Mask) > Inf) or ((B and Mask) > Inf) then
    begin
      if SingleValue then
        Exit(FloatingBits($7FC00000, True))
      else
        Exit(FloatingBits(NaNBits));
    end;
    if ((A or B) and Mask) = 0 then
    begin
      if N = 'min' then
        Exit(FloatingBits((A or B) and Sign, SingleValue))
      else
        Exit(FloatingBits((A and B) and Sign, SingleValue));
    end;
    if ((A xor B) and Sign) <> 0 then
      Less := (A and Sign) <> 0
    else if (A and Sign) <> 0 then
      Less := A > B
    else
      Less := A < B;
    if Less = (N = 'min') then
      Exit(Args[0])
    else
      Exit(Args[1]);
  end;
  if (N = 'sin') or (N = 'cos') or (N = 'tan') then
    Exit(Trig(A, N));
  if N = 'floor' then
    Exit(Integral(Args[0], False));
  if N = 'ceil' then
    Exit(Integral(Args[0], True));
  if (A and Mask) > Inf then
    Exit(FloatingBits(NaNBits));
  if N = 'sqrt' then
  begin
    if (A and Mask) = 0 then
      Exit(Args[0]);
    if (A and Sign) <> 0 then
      Exit(FloatingBits(NaNBits));
    Exit(TJVMValue.Double(System.Sqrt(Args[0].AsDouble)));
  end;
  X := Args[0].AsDouble;
  if N = 'toDegrees' then
  begin
    R := X * DegreesFactor;
    B := UInt64(TJVMValue.Double(DegreesFactor).Bits);
  end
  else if N = 'toRadians' then
  begin
    R := X * RadiansFactor;
    B := UInt64(TJVMValue.Double(RadiansFactor).Bits);
  end
  else
    raise EJVMUnsupported.Create('java/lang/Math.' + N + D);
  Result := TJVMValue.Double(R);
  if (UInt64(Result.Bits) and MagnitudeMask) <= $0010000000000000 then
    Result := FloatingBits(TinyProduct(A, B));
end;

end.

