function JavaCharInfo(C: Char): TJavaCharInfo;
var
  Lo, Hi, Mid: Integer;
begin
  Result.Flags := 0;
  Result.Upper := C;
  Result.Lower := C;
  Result.Digit := -1;
  Lo := Low(Ranges);
  Hi := High(Ranges);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if Ord(C) < Ranges[Mid].First then
      Hi := Mid - 1
    else if Ord(C) > Ranges[Mid].Last then
      Lo := Mid + 1
    else
    begin
      Result.Flags := Ranges[Mid].Flags;
      Result.Upper := Char(Ord(C) + Ranges[Mid].UpperDelta);
      Result.Lower := Char(Ord(C) + Ranges[Mid].LowerDelta);
      if (Result.Flags and 4) <> 0 then
        Result.Digit := Ord(C) + Ranges[Mid].DigitDelta;
      Exit;
    end;
  end;
end;

function JavaCharUpper(C: Char): Char;
begin
  Result := JavaCharInfo(C).Upper;
end;

function JavaCharLower(C: Char): Char;
begin
  Result := JavaCharInfo(C).Lower;
end;

function JavaCharDigit(C: Char; Radix: Integer): Integer;
begin
  if (Radix < 2) or (Radix > 36) then
    Exit(-1);
  case C of
    'A'..'Z':
      Result := Ord(C) - Ord('A') + 10;
    'a'..'z':
      Result := Ord(C) - Ord('a') + 10;
    #$FF21..#$FF3A:
      Result := Ord(C) - $FF21 + 10;
    #$FF41..#$FF5A:
      Result := Ord(C) - $FF41 + 10;
  else
    Result := JavaCharInfo(C).Digit;
  end;
  if Result >= Radix then
    Result := -1;
end;

end.

